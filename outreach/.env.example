# Astro-Menu outreach pipeline. Copy to outreach/.env and fill in.
# Nothing in this file is read by the marketing site build.

# --- Prospect database -------------------------------------------------------
# Postgres. The Supabase connection string works as-is; use the pooler URI for
# anything that runs on a schedule.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Sourcing ----------------------------------------------------------------
# Google Places API (New). Enable "Places API (New)" on the GCP project and
# restrict the key to it. https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# --- Menu parsing ------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Override only if you have measured a cheaper model holding accuracy on real
# menus. A wrong price sent to a restaurant costs more than the tokens saved.
ANTHROPIC_MODEL=claude-opus-5

# --- Firestore ---------------------------------------------------------------
# Service account JSON for the Astro-Menu Firebase project, either as a path or
# as the raw JSON. Needs write access to /businessProfiles.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=
# Storage bucket for prospect logos and cover photos, e.g. my-project.appspot.com
FIREBASE_STORAGE_BUCKET=

# --- Where built menus are served -------------------------------------------
MENU_BASE_URL=https://menu.astro-menu.com
SITE_BASE_URL=https://astro-menu.com

# Every prospect menu is created under this branch and table id so a prospect
# record is always distinguishable from a paying customer's. Read from the
# reference venue in src/config/site.ts.
PROSPECT_BRANCH_ID=2EKctRFUaA06pGIvAT2D
PROSPECT_TABLE_ID=upxdTRj5NaTRl68f6ly0
