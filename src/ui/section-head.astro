---
const {
  title,
  description,
  classList,
  fullWidth,
  bottomSpace = "mb-16",
} = Astro.props;
---

<div
  class:list={[
    classList,
    bottomSpace,
    fullWidth ? "max-w-full" : "sm:max-w-8/12",
  ]}
>
  <h2 class="text-6xl font-black lg:tracking-tight capitalize">
    {title}
  </h2>
  <p class="mt-4 text-lg">
    {description}
  </p>
</div>
