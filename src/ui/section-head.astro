---
const {
  title,
  description,
  classList,
  fullWidth,
  bottomSpace = "mb-6 sm:mb-16",
  tag = "h1",
} = Astro.props;

const Tag = tag;
---

<div
  class:list={[
    classList,
    bottomSpace,
    fullWidth ? "max-w-full" : "sm:max-w-8/12",
  ]}
>
  <Tag class="text-6xl font-black lg:tracking-tight capitalize">
    {title}
  </Tag>
  <p class="mt-4 text-lg">
    {description}
  </p>
</div>
