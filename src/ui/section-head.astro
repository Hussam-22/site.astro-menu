---
const { title, description, classList, fullWidth } = Astro.props;
---

<div
  class:list={[classList, "mb-16", fullWidth ? "max-w-full" : "sm:max-w-8/12"]}
>
  <h2 class="text-6xl font-black lg:tracking-tight capitalize">
    {title}
  </h2>
  <p class="mt-4 text-lg">
    {description}
  </p>
</div>
