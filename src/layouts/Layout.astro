---
import { SEO } from "astro-seo";
import { AstroFont } from "astro-font";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import "../assets/app.css";
import { ClientRouter } from "astro:transitions";

const SITE_NAME = "Astro-Menu";
const SITE_URL = Astro.site?.toString() || "https://astro-menu.com";
const DEFAULT_TITLE = `${SITE_NAME} - Revolutionize Your Food Business with Astro-Menu`;
const DEFAULT_DESC =
  "Empower your food business, restaurant, coffee shop, and social media food business with our cutting-edge QR menu and cloud POS solution. Seamlessly integrate ordering and kitchen management, all in one sleek, digital platform.";
const DEFAULT_IMAGE = new URL("/opengraph.png", Astro.site).toString();

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const { title, description, image, robots, ogType } = Astro.props;

const makeTitle = title ? `${title} | ${SITE_NAME}` : DEFAULT_TITLE;
const metaDescription = description || DEFAULT_DESC;
const ogImage = image ? new URL(image, SITE_URL).toString() : DEFAULT_IMAGE;
// Ensure single-slash when building SearchAction target
const searchActionTarget =
  new URL("/search", SITE_URL).toString() + "?q={search_term_string}";
---

<!doctype html>
<html lang="en" data-theme="cmyk">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4FMMNZ0D1P"
    ></script>
    <script is:inline>
      // Google Analytics initialization (plain JS)
      (function () {
        var w = window;
        w.dataLayer = w.dataLayer || [];
        function gtag() {
          w.dataLayer.push(arguments);
        }
        gtag("js", new Date());
        gtag("config", "G-4FMMNZ0D1P");
      })();
    </script>
    <!-- Yandex.Metrika counter -->
    <script type="text/javascript">
      (function (m, e, t, r, i, k, a) {
        m[i] =
          m[i] ||
          function () {
            (m[i].a = m[i].a || []).push(arguments);
          };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) {
          if (document.scripts[j].src === r) {
            return;
          }
        }
        ((k = e.createElement(t)),
          (a = e.getElementsByTagName(t)[0]),
          (k.async = 1),
          (k.src = r),
          a.parentNode.insertBefore(k, a));
      })(
        window,
        document,
        "script",
        "https://mc.yandex.ru/metrika/tag.js",
        "ym"
      );

      ym(99191635, "init", {
        clickmap: true,
        trackLinks: true,
        accurateTrackBounce: true,
      });
    </script>
    <noscript
      ><div>
        <img
          src="https://mc.yandex.ru/watch/99191635"
          style="position:absolute; left:-9999px;"
          alt=""
        />
      </div></noscript
    >
    <!-- /Yandex.Metrika counter -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="msvalidate.01" content="A5F12D489A25EE6C5EDE8613601EABE2" />
    <meta name="yandex-verification" content="6986b8519cb7c539" />
    <!-- <meta
      name="google-site-verification"
      content="YOUR_GOOGLE_SITE_VERIFICATION_TOKEN"
    /> -->
    {robots && <meta name="robots" content={robots} />}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={makeTitle}
      description={metaDescription}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: ogType || "website",
          title: makeTitle,
          image: ogImage,
        },
        image: {
          alt: `${SITE_NAME} Open Graph Image`,
        },
        optional: {
          locale: "en_US",
          siteName: SITE_NAME,
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: "@AstroMenu",
        creator: "@AstroMenu",
        title: makeTitle,
        description: metaDescription,
        image: ogImage,
      }}
    />
    <slot name="head" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: SITE_NAME,
        url: SITE_URL,
        logo: new URL("/android-chrome-512x512.png", SITE_URL).toString(),
        sameAs: [
          "https://x.com/astromenu",
          "https://www.facebook.com/astromenu",
        ],
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: SITE_NAME,
        url: SITE_URL,
        potentialAction: {
          "@type": "SearchAction",
          target: searchActionTarget,
          "query-input": "required name=search_term_string",
        },
      })}
    />
    <AstroFont
      config={[
        {
          name: "Afacad",
          src: [
            {
              path: "/fonts/Afacad-Regular.ttf",
              weight: "400",
              style: "normal",
            },
            {
              path: "/fonts/Afacad-Bold.ttf",
              weight: "700",
              style: "normal",
            },
            {
              path: "/fonts/Afacad-ExtraBold.ttf",
              weight: "800",
              style: "normal",
            },
          ],
          preload: true,
          display: "swap",
          selector: "body",
          fallback: "sans-serif",
        },
      ]}
    />
    <ClientRouter />
  </head>
  <body class="relative">
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
    </style>
  </body>
</html>
