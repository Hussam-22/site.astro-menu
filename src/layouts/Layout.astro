---
import '@fontsource-variable/afacad'
// Anton ships a single weight (400) and is only ever set in caps — it carries
// the display headings while Afacad carries every other piece of text.
import '@fontsource/anton'
// Neither Afacad nor Anton has Arabic glyphs, so Arabic pages use Noto Sans
// Arabic for everything instead — see the html[lang="ar"] override in global.css.
import '@fontsource-variable/noto-sans-arabic'
import '../styles/global.css'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import { SITE } from '../config/site'
import { getLangFromUrl } from '../i18n/ui'

interface Props {
	/** Page title WITHOUT the brand suffix — this component appends it. */
	title: string
	description: string
	/** Path only, e.g. "/pricing". Combined with SITE.domain for the canonical. */
	path?: string
	image?: string
	/** Emitted as-is inside a JSON-LD script tag. Pass objects, not strings. */
	schema?: object | object[]
	noindex?: boolean
	type?: 'website' | 'article'
}

const {
	title,
	description,
	path = Astro.url.pathname,
	image = '/opengraph.jpg',
	schema,
	noindex = false,
	type = 'website'
} = Astro.props

// trailingSlash is 'never', but the site root still has to canonicalise to "/".
const clean = path === '/' ? '/' : path.replace(/\/$/, '')
const canonical = new URL(clean, SITE.domain).href
const ogImage = new URL(image, SITE.domain).href
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`

const lang = getLangFromUrl(Astro.url)
const dir = lang === 'ar' ? 'rtl' : 'ltr'
// Used for inLanguage and og:locale, which describe what this page IS.
// Deliberately NOT used for hreflang, which decides who Google shows it to
// — see the hreflang links below.
const localeTag = lang === 'ar' ? 'ar-AE' : 'en-AE'
const enPath = clean.replace(/^\/ar(\/|$)/, '/')
const arPath = enPath === '/' ? '/ar' : `/ar${enPath}`

/** Present on every page, so search and AI assistants always have the entity. */
const orgSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': `${SITE.domain}/#organization`,
	name: SITE.name,
	url: SITE.domain,
	email: SITE.email,
	logo: new URL('/favicon.svg', SITE.domain).href,
	description: SITE.description,
	areaServed: 'AE',
	slogan: SITE.tagline
}

const siteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${SITE.domain}/#website`,
	name: SITE.name,
	url: SITE.domain,
	publisher: { '@id': `${SITE.domain}/#organization` },
	inLanguage: localeTag
}

const graph = [orgSchema, siteSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])]
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{/* Language-only, not en-AE/ar-AE. There is one English version and one
		    Arabic one, with no regional variants to disambiguate, so a regional
		    tag would only narrow them to the UAE — and Search Console shows real
		    impressions from over a hundred countries against USD pricing. */}
		<link rel="alternate" hreflang="en" href={new URL(enPath, SITE.domain).href} />
		<link rel="alternate" hreflang="ar" href={new URL(arPath, SITE.domain).href} />
		<link rel="alternate" hreflang="x-default" href={new URL(enPath, SITE.domain).href} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{
			!noindex && (
				<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
			)
		}

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="theme-color" content="#fdf6ec" />

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content={lang === 'ar' ? 'ar_AE' : SITE.locale} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
		<slot name="head" />
	</head>
	<body class="bg-paper text-ink antialiased">
		<a
			href="#main"
			class="focus:bg-ink focus:text-white sr-only focus:not-sr-only focus:fixed focus:top-4 focus:start-4 focus:z-[100] focus:rounded-full focus:px-5 focus:py-3 focus:font-bold"
		>
			{lang === 'ar' ? 'تخطَّ إلى المحتوى' : 'Skip to content'}
		</a>
		<Navbar />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
