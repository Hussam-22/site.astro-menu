---
import { SEO } from 'astro-seo'
import Footer from '@components/footer.astro'
import Navbar from '@components/navbar/navbar.astro'
// Supports weights 200-800
import '@fontsource-variable/plus-jakarta-sans'
import { ViewTransitions } from 'astro:transitions'
export interface Props {
	title: string
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString()

const resolvedImageWithDomain = new URL('/opengraph.png', Astro.site).toString()

const { title } = Astro.props

const makeTitle = title
	? title + ' | ' + 'Astro-Menu'
	: 'Astro-Menu - Revolutionize Your Food Business with Astro-Menu'
---

<!doctype html>
<html lang="en" data-theme="business">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-4FMMNZ0D1P"></script>
		<script>
			window.dataLayer = window.dataLayer || []
			function gtag() {
				dataLayer.push(arguments)
			}
			gtag('js', new Date())

			gtag('config', 'G-4FMMNZ0D1P')
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<!-- <script defer src="https://unpkg.com/tailwindcss-intersect@1.x.x/dist/observer.min.js"></script> -->
		<script src="https://unpkg.com/@material-tailwind/html@latest/scripts/collapse.js"></script>
		<!-- <link rel="preload" as="image" href={src} alt="Hero" /> -->
		<SEO
			title={makeTitle}
			description="Empower your food business, restaurant, coffee shop, and social media food business with our cutting-edge QR menu and cloud POS solution. Seamlessly integrate ordering and kitchen management, all in one sleek, digital platform."
			canonical={canonicalURL}
			openGraph={{
				basic: {
					url: canonicalURL,
					type: 'website',
					title: `Revolutionize Your Food Business with Astro-Menu`,
					image: resolvedImageWithDomain
				},
				image: {
					alt: 'Astro-Menu Homepage Screenshot'
				}
			}}
		/>
		<ViewTransitions />
	</head>
	<body>
		<Navbar />
		<slot />
		<Footer />
		<style is:global>
			/* Improve Page speed */
			/* https://css-tricks.com/almanac/properties/c/content-visibility/ */
			img {
				content-visibility: auto;
			}
		</style>
	</body>
</html>
