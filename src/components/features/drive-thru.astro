---
import driveThruImage from "@assets/images/features/drive-thru-img.png";
import driveThruOldImage from "@assets/images/features/drive-thru-old-img.png";
import Container from "@components/container.astro";
import PhoneMockup from "@ui/phone-mockup.astro";
import SectionHead from "@ui/section-head.astro";
import driveThruMobileView from "assets/images/mockups/drive-thru-mobile-view.jpeg";
import { Image } from "astro:assets";
---

<Container>
  <div
    class="w-full flex flex-col sm:flex-row gap-8 rounded-4xl bg-gradient-to-br from-orange-100 to-base-200 overflow-hidden relative px-0 sm:py-12 py-6 sm:p-0"
  >
    <div class="w-full sm:w-2/3 flex flex-col sm:px-12 sm:pt-12 sm:pb-96 px-6">
      <SectionHead
        title="Drive-Thru"
        description="Jump to today's Drive-Thru experience, ditching the wait, Astro-Menu includes drive-thru capabilities that let customers order seamlessly from their vehicles - so you can serve curbside and dine-in guests effortlessly."
        bottomSpace="sm:mb-6"
        fullWidth
      />
      <PhoneMockup
        className="absolute -bottom-36 left-18 scale-125 hidden sm:block"
        imgSrc={driveThruMobileView}
        text="Drive-Thru"
        isEager={true}
      />
    </div>
    <div class="p-3 w-full sm:m-3">
      <figure class="diff aspect-16/9 rounded-4xl" tabindex="0">
        <div class="diff-item-1" role="img" tabindex="0">
          <Image src={driveThruImage} alt="Drive-Thru" class="" />
        </div>
        <div class="diff-item-2" role="img">
          <Image src={driveThruOldImage} alt="Drive-Thru" class="" />
        </div>
        <div class="diff-resizer"></div>
      </figure>
    </div>
  </div>
</Container>
