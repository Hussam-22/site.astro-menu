---
import PhoneMockup from "@ui/phone-mockup.astro";
import FoodImage1 from "assets/food-posts/1.png";
import FoodImage2 from "assets/food-posts/2.png";
import FoodImage3 from "assets/food-posts/3.png";
import FoodImage4 from "assets/food-posts/4.png";
import FoodImage5 from "assets/food-posts/5.png";
import FoodImage6 from "assets/food-posts/6.png";
import FoodImage7 from "assets/food-posts/7.png";
---

<section class="overflow-hidden sm:overflow-visible">
  <h2
    class="text-center text-4xl font-bold text-white lg:text-5xl lg:tracking-tight"
  >
    Why Social Food Business need Astro-Menu?
  </h2>
  <p class="mt-4 text-center text-lg text-white">
    Your customers dont have to dig through your social media posts to find your
    menu items, no more DMs asking for the item availability and price, no more
    confusion, everything is just a click away.
  </p>
  <div class="mt-16 grid grid-cols-3 sm:grid-cols-7">
    <PhoneMockup imgSrc={FoodImage1} className="-rotate-12" />
    <PhoneMockup imgSrc={FoodImage2} className="-rotate-12" />
    <PhoneMockup imgSrc={FoodImage3} className="-rotate-12" />
    <PhoneMockup imgSrc={FoodImage4} className="-rotate-12" />
    <PhoneMockup imgSrc={FoodImage5} className="-rotate-12" />
    <PhoneMockup imgSrc={FoodImage6} className="-rotate-12" />
    <PhoneMockup imgSrc={FoodImage7} className="hidden -rotate-12 sm:inline" />
  </div>
</section>
