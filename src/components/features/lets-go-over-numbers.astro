---
import Container from "@components/container.astro";
import FeatureCard from "@ui/feature-card.astro";
import SectionHead from "@ui/section-head.astro";
import HardwareDecrease from "assets/icons/hardware-decrease.svg";
import PrintDecrease from "assets/icons/print-decrease.svg";
import SalesIncrease from "assets/icons/sale-increase.svg";
---

<Container class="flex flex-col items-center text-center">
  <SectionHead
    title="Let's go over the figures!"
    description="lets see how astro-menu helps in saving money and increasing sales."
    classList="text-center"
  />

  <div class="mt-16 hidden gap-4 sm:grid sm:grid-cols-3">
    <FeatureCard
      title="22% Increase tables turnover & sales"
      icon={SalesIncrease}
      className="border-4 border-black"
    />
    <FeatureCard
      title="95% decrease printing cost"
      icon={PrintDecrease}
      className="border-4 border-black"
    />
    <FeatureCard
      title="99% decrease maintenance"
      icon={HardwareDecrease}
      className="border-4 border-black"
    />
  </div>

  <div
    class="carousel carousel-center mt-2 w-full max-w-md space-x-4 sm:hidden"
  >
    <FeatureCard
      title="32% Increase in tables turnover and sales"
      description="With Astro-Menu, customers can browse the menu faster and more efficiently."
      icon={SalesIncrease}
      className="carousel-item w-[65vw] flex-col border-4 border-black"
    />
    <FeatureCard
      title="95% decrease in printing cost"
      description="No need to print menus, print receipt or waste paper on taking orders, everything is digital, plus it's eco-friendly."
      icon={PrintDecrease}
      className="carousel-item w-[65vw] flex-col border-4 border-black"
    />
    <FeatureCard
      title="99% decrease in maintenance cost"
      description="No need to buy expensive hardware or maintain it, everything is cloud-based."
      icon={HardwareDecrease}
      className="carousel-item w-[65vw] flex-col border-4 border-black"
    />
  </div>
</Container>
