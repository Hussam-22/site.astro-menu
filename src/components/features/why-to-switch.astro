---
import Container from "@components/container.astro";
import SectionHead from "@ui/section-head.astro";
import ArrowRight from "assets/icons/arrow-right.svg";
import { Image } from "astro:assets";

const REASONS = [
  // why you should switch from print menu to QR menu ?
  {
    title: "Easy updates",
    description:
      "No more re-printing of menu, you can now update your menu with a click of a button.",
    icon: "easy-update",
  },
  {
    title: "Filter meals",
    description:
      "Customers can filter meals based on their dietary restrictions or preferences, e.g. vegan, gluten-free, etc, get them to place orders faster.",
    icon: "filter-meals",
  },

  {
    title: "Increase table turnover",
    description:
      "Customers can place orders from their phones, which means faster table turnover.",
    icon: "table-turnover",
  },
  {
    title: "No more waiting for the waiter",
    description:
      "Customers dont have to wait for the menu or the waiter to take their order.",
    icon: "no-waiting",
  },
  {
    title: "Single Menu, multiple languages",
    description: "Customers can view the menu in their preferred language.",
    icon: "multi-language",
  },
  {
    title: "The eye eats first",
    description: "show images of your menu items to entice customers.",
    icon: "eye-eats-first",
  },
  {
    title: "Get useful insights",
    description:
      "Get useful insights on your orders status, Most ordered meal, your total earning, and more.",
    icon: "useful-insights",
  },
  {
    title: "No more paper waste",
    description: "Save the environment by using digital menu.",
    icon: "no-paper-waste",
  },
  {
    title: "Share QR code/Link on social media",
    description:
      "Share your QR code on social media to attract more customers, with always up-to-date menu.",
    icon: "share-on-social-media",
  },
  {
    title: "Hygiene and Safety",
    description:
      "QR menus eliminate the need for shared physical menus, reducing the risk of spreading germs and viruses",
    icon: "hygiene-and-safety",
  },
];
---

<Container class="flex flex-col items-center text-center">
  <SectionHead title="Why digital QR menu anyway?" classList="text-center" />

  <div class="hidden gap-4 sm:grid sm:grid-cols-5">
    {
      REASONS.map((item, index) => (
        <div class="flex flex-col justify-center bg-base-200 rounded-4xl p-4 items-center gap-2">
          <img
            src={`/assets/icons/why-to-switch/${item.icon}.svg`}
            alt={`${item.title} icon`}
            class="h-12 w-12"
          />
          <h3 class="text-xl font-bold capitalize">{item.title}</h3>
        </div>
      ))
    }
  </div>

  <div
    class="flex flex-row items-center justify-end gap-2 text-white sm:hidden"
  >
    <p>Swipe Right</p>
    <Image src={ArrowRight} alt="arrow-right" class="h-8 w-8" />
  </div>
  <div
    class="carousel carousel-center mt-2 w-full max-w-md space-x-4 sm:hidden"
  >
    {
      REASONS.map((item, index) => (
        <div class="carousel-item w-[50%] flex flex-col items-center justify-center bg-base-200 rounded-4xl p-4 gap-2">
          <img
            src={`/assets/icons/why-to-switch/${item.icon}.svg`}
            alt={`${item.title} icon`}
            class="h-18 w-18"
            loading="lazy"
          />
          <h3 class="text-xl font-bold">{item.title}</h3>
        </div>
      ))
    }
  </div>
</Container>
