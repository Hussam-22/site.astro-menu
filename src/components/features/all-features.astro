---
import Container from "@components/container.astro";

const FEATURES = [
  "dynamic QR menu",
  "multiple languages",
  "auto translation",
  "meal filters",
  "meal labels",
  "modern design",
  "responsive design",
  "minimum clicks design",
  "wifi password",
  "social links",
  "google review",
  "home page",
  "multi currency",
  "no app download",
  "cloud solution",
  "no physical lock-down",
  "affordable",
  "easy to use",
  "no maintenance",
];
---

<style>
  .scroll-container {
    overflow: hidden;
    white-space: nowrap;
    width: 100%; /* Adjust to your container size */
  }

  .scroll-content {
    display: inline-block;
    animation: scroll-left 60s linear infinite;
  }
  .scroll-content-right {
    display: inline-block;
    animation: scroll-right 60s linear infinite;
  }

  .item {
    display: inline-block;
    padding: 0 10px;
  }

  @keyframes scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%); /* Adjust based on content width */
    }
  }
  @keyframes scroll-right {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0%); /* Adjust based on content width */
    }
  }
</style>

<Container>
  <div class="scroll-container">
    <div class="scroll-content">
      {
        FEATURES.slice(0, 14).map((feature, index) => (
          <div class="item">
            <div class="rounded-4xl flex flex-row items-center gap-3 bg-black text-white font-semibold p-3 text-lg ">
              <p class="capitalize">{feature}</p>
            </div>
          </div>
        ))
      }
    </div>
    <div class="scroll-content">
      {
        FEATURES.slice(0, 14).map((feature, index) => (
          <div class="item">
            <div class="rounded-4xl flex flex-row items-center gap-3 bg-black text-white font-semibold p-3 text-lg ">
              <p class="capitalize">{feature}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="scroll-container mt-6">
    <div class="scroll-content-right">
      {
        FEATURES.slice(14).map((feature, index) => (
          <div class="item">
            <div class="rounded-4xl flex flex-row items-center gap-3 bg-black text-white font-semibold p-3 text-lg ">
              <p class="capitalize">{feature}</p>
            </div>
          </div>
        ))
      }
    </div>
    <div class="scroll-content-right">
      {
        FEATURES.slice(14).map((feature, index) => (
          <div class="item">
            <div class="rounded-4xl flex flex-row items-center gap-3 bg-black text-white font-semibold p-3 text-lg ">
              <p class="capitalize">{feature}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- <div class="mt-8 text-center">
		<Button style="primary" class="bg-white">Features List</Button>
	</div> -->
</Container>
