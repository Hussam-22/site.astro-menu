---
import { Image } from 'astro:assets'

import Section from '@components/ui/section.astro'

interface Props {
	only?: string[]
	align?: 'left' | 'center'
	eyebrow?: string
	title?: string
	lede?: string
}

const { only, eyebrow, title, lede, align = 'left' } = Astro.props

// Renders whatever screenshots exist in src/assets/screens, so the page works
// before the files are added and improves as they land. See the README in that folder.
const modules = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/screens/*.{png,jpg,jpeg,webp,avif}',
	{ eager: true }
)

const CAPTIONS: Record<string, { title: string; body: string }> = {
	landing: {
		title: 'Your own branded page',
		body: 'Cover photo, logo, your description and every contact link — the menu opens from here.'
	},
	'menu-sections': {
		title: 'Sections people can jump between',
		body: 'A photo, a price and a description on every item, with sections pinned to the top.'
	},
	'item-detail': {
		title: 'The full item, one tap away',
		body: 'A large photo, the full description, portion sizes and add-ons priced individually.'
	},
	'filter-meal-type': {
		title: 'Guests filter it themselves',
		body: 'Hot, cold, decaf, light, healthy, sweet — they narrow the menu instead of scrolling past it.'
	},
	'language-switch': {
		title: 'Arabic and English, automatically',
		body: 'Written once. Each guest reads it in their own language without a second printed menu.'
	},
	macros: {
		title: 'Calories and macros, if you want them',
		body: 'Protein, carbs and fat per item — worth turning on for healthy eating and meal-prep menus.'
	}
}

const prettify = (name: string) =>
	name.replace(/[-_]/g, ' ').replace(/^\w/, (c) => c.toUpperCase())

const shots = Object.entries(modules)
	.map(([path, mod]) => {
		const key = path.split('/').pop()!.replace(/\.\w+$/, '')
		return { key, img: mod.default, ...(CAPTIONS[key] ?? { title: prettify(key), body: '' }) }
	})
	.filter((s) => !only || only.includes(s.key))
	.sort((a, b) => {
		const order = Object.keys(CAPTIONS)
		const ai = order.indexOf(a.key)
		const bi = order.indexOf(b.key)
		return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi)
	})
---

{
	shots.length > 0 && (
		<Section eyebrow={eyebrow} title={title} lede={lede} align={align}>
			<div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{shots.map((shot, i) => (
					<figure
						class="rounded-4xl flex flex-col items-center border border-line bg-card p-8 text-center transition-transform duration-300 hover:-translate-y-1"
					>
						<div class="w-full max-w-[240px] overflow-hidden rounded-3xl shadow-2xl">
							<Image
								src={shot.img}
								alt={shot.title}
								widths={[240, 480]}
								sizes="(max-width: 640px) 70vw, 240px"
								loading={i < 3 ? 'eager' : 'lazy'}
								class="h-auto w-full"
							/>
						</div>
						<figcaption class="mt-6">
							<h3 class="text-xl font-extrabold text-ink">{shot.title}</h3>
							{shot.body && <p class="mt-2 text-sm text-muted">{shot.body}</p>}
						</figcaption>
					</figure>
				))}
			</div>
		</Section>
	)
}
