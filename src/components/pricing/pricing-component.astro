---
import Container from "@components/container.astro";
import Link from "@ui/link.astro";
import SectionHead from "@ui/section-head.astro";
import PricingCard from "./pricing-card.astro";

const pricing = [
  {
    name: "Social Bites",
    price: "29 AED",
    popular: false,
    features: [
      `1 QR Code`,
      "20 Meals",
      "Unlimited Menus",
      "100,000 Scans /per month",
      "1 Translation Languages",
      "Social Media Links",
    ],
    button: {
      text: "Get Started",
      link: "/",
    },
    icon: "social-hero",
    description:
      "Perfect for food businesses on social media, this plan helps you showcase your offerings and engage with customers online effortlessly.",
    param: "prod_QSORufNWBDLHz6",
  },
  {
    name: "Coffee Cup",
    price: "149 AED",
    popular: true,
    features: [
      `x25 QR Codes`,
      `xSelf-Order`,
      "xCloud POS",
      "Unlimited Meals",
      "Unlimited Menus",
      "Unlimited Scans (Fair Usage Policy)",
      "Unlimited Orders",
      "2 Translation Languages",
      "Analytics & Reports",
      "Social Media Links",
      "1 Branch",
    ],
    button: {
      text: "Get Started",
      link: "/",
    },
    icon: "coffeecup",
    description:
      "Designed for small-scale food businesses like cozy cafes, bakeries, or specialty dessert shops. This plan is ideal for establishments with focused menus looking to enhance their customer experience and streamline operations.",
    param: "prod_QSJoKo5g5BbTLW",
  },
  {
    name: "Menu Master",
    price: "229 AED",
    popular: false,
    features: [
      `x50 QR Codes`,
      `xDrive-Thru QR Code`,
      `xSelf-Order`,
      "xCloud POS",
      "Unlimited Meals",
      "Unlimited Menus",
      "Unlimited Scans (Fair Usage Policy)",
      "Unlimited Orders",
      "3 Translation Languages",
      "Analytics & Reports",
      "Social Media Links",
      "1 Branch",
    ],
    button: {
      text: "Get Started",
      link: "/",
    },
    icon: "menumaster",
    description:
      "Ideal for full-service restaurants and larger establishments with diverse and dynamic menus. This plan supports seamless menu management and operational efficiency for businesses catering to broader customer bases.",
    param: "prod_QSJp5bB2jPwc69",
  },
];
---

<Container class="flex flex-col items-center gap-1">
  <SectionHead
    title="Pricing Plans"
    description="Choose the right plan for your business"
    classList="text-center self-center"
  />

  <div class="mx-auto grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {pricing.map((item, index) => <PricingCard plan={item} index={index} />)}
  </div>

  <p class="mt-4 text-sm font-light text-neutral-400">
    *Unlimited scans are subject to fair usage policy. For more information,
    please refer to our terms of service.
  </p>

  <div
    class="bg-black p-8 text-center text-white mt-8 rounded-4xl flex flex-col sm:flex-row items-center gap-4"
  >
    <p class="text-xl font-bold">
      Need a tailored plan for your hotel, hospital, or franchise?
    </p>
    <Link href="/contact" class="font-semibold underline" size="md"
      >Contact us</Link
    >
  </div>
</Container>
