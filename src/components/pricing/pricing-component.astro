---
import Container from "@components/container.astro";
import SectionHead from "@ui/section-head.astro";
import PlanSwitcher from "./plan-switcher.jsx";
import PricingCard from "./pricing-card.astro";

const pricing = [
  {
    name: "Menu",
    price: "59 AED",
    yearlyPlan: "468 AED",
    popular: false,
    features: [
      `1 QR Code (menu viewing only)`,
      "1 Translation Language",
      "Unlimited Meals",
      "Unlimited Menus",
      "Unlimited Scans (Fair Usage Policy)",
      "Social Media Links",
      "1 Branch",
    ],
    icon: "coffeecup",
    description:
      "Perfect for businesses that want to show their menu digitally.",
  },
];
---

<Container class="flex flex-col items-center gap-1">
  <div class="flex flex-col items-center w-full">
    <SectionHead
      title="Pricing Plans"
      tag="h2"
      description="Choose the right plan for your business"
      classList="text-center"
    />
    <PlanSwitcher client:load />
  </div>
  <div class="mx-auto grid max-w-md gap-5">
    {pricing.map((item, index) => <PricingCard plan={item} index={index} />)}
  </div>

  <p class="mt-4 text-sm font-light text-neutral-400">
    *Unlimited scans are subject to fair usage policy. For more information,
    please refer to our terms of service.
  </p>
</Container>
