---
// Abstract use-case section component for reuse
import { Image } from "astro:assets";

const { bgColor } = Astro.props;
---

<div class:list={["flex w-full gap-2  p-2 rounded-2xl", bgColor]}>
  <div class="w-full max-w-8/12 rounded-2xl grid grid-cols-12 gap-2">
    <div class="w-full col-span-12 bg-white rounded-2xl p-6 h-full">
      <p class="text-6xl font-extrabold mb-2">
        {Astro.props.title}
      </p>
      <p>{Astro.props.description}</p>
    </div>
    <div class="w-full flex flex-row gap-2 col-span-12">
      <div class="bg-white h-full rounded-2xl p-3 w-full max-w-9/12">
        <slot name="features" />
      </div>
      <div class="col-span-4 w-full max-w-3/12 h-full rounded-2xl">
        <Image
          src={Astro.props.leftImage}
          alt={Astro.props.leftImageAlt ?? Astro.props.title}
          class="w-full h-full rounded-2xl object-cover"
        />
      </div>
    </div>
  </div>
  <div class="w-full max-w-4/12 rounded-2xl relative">
    <Image
      src={Astro.props.rightImage}
      alt={Astro.props.rightImageAlt ?? Astro.props.title}
      class="w-full h-full rounded-2xl object-cover"
    />
    <div
      class="absolute inset-0 rounded-2xl bg-gradient-to-b from-transparent via-transparent to-black/50"
    >
    </div>
    <p class="bottom-4 left-4 absolute text-white text-4xl font-extrabold z-10">
      {Astro.props.rightTitle ?? Astro.props.title}
    </p>
  </div>
</div>
