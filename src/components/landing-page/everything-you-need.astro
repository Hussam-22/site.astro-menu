---
import Container from "@components/container.astro";
import FeatureCard from "@components/ui/feature-card.astro";
import Commissions from "../../assets/icons/commission.svg";
import POS from "../../assets/icons/pos.svg";
import QRCode from "../../assets/icons/qr-code.svg";
import translateIcon from "../../assets/icons/translate.svg";

const features = [
  {
    title: "Instant QR Menus",
    description: "No app downloads, just scan & order",
    bgColor: "bg-sky-400",
    icon: QRCode,
  },
  {
    title: "No Commissions",
    description: `Flat monthly fee, keep your profits.`,
    bgColor: "bg-purple-400",
    icon: Commissions,
  },
  {
    title: "POS Included",
    description: `Cloud POS built in, no annual contract, no maintenance fees, no extra cost`,
    bgColor: "bg-orange-400",
    icon: POS,
  },
  {
    title: "Multi-Languages",
    description: `No more language barrier, don't miss out on any customer`,
    bgColor: "bg-emerald-400",
    icon: translateIcon,
  },
];
---

<section>
  <Container>
    <div>
      <h2 class="text-4xl font-black lg:text-5xl lg:tracking-tight">
        Why Restaurants Choose Astro-Menu
      </h2>
      <p class="mt-4 text-lg">
        Make your dining experience seamless. From QR menus to built-in POS,
        Astro-Menu helps you serve customers faster, cut costs, and grow your
        business — without paying commissions.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-4 sm:gap-4 mt-16">
      {
        features.map((feature) => (
          <FeatureCard
            className={feature.bgColor}
            title={feature.title}
            description={feature.description}
            icon={feature.icon}
          />
        ))
      }
    </div>
    <a
      href="/features"
      class="mt-8 bg-black text-white px-4 py-2 rounded-4xl font-bold"
    >
      All Features
    </a>
  </Container>
</section>
