---
import FeatureCard from '@components/ui/feature-card.astro'
import SalesIncrease from 'assets/icons/sale-increase.svg'
import HardwareDecrease from 'assets/icons/hardware-decrease.svg'
import PrintDecrease from 'assets/icons/print-decrease.svg'
import { Image } from 'astro:assets'
import ArrowRight from 'assets/icons/arrow-right.svg'
---

<section>
	<h2 class="text-center text-4xl font-bold text-white lg:text-5xl lg:tracking-tight">
		Let’s go over the figures!
	</h2>
	<p class="mb-12 mt-4 text-center text-lg text-white">
		lets see how astro-menu helps in saving money and increasing sales.
	</p>

	<div class="mt-16 hidden gap-4 sm:grid sm:grid-cols-3">
		<FeatureCard
			title="32% Increase in tables turnover and sales"
			description="With Astro-Menu, customers can order faster and more efficiently."
			icon={SalesIncrease}
			className="bg-green-400"
		/>
		<FeatureCard
			title="95% decrease in printing cost"
			description="No need to print menus, print receipt or waste paper on taking orders, everything is digital, plus it's eco-friendly."
			icon={PrintDecrease}
			className="bg-cyan-400"
		/>
		<FeatureCard
			title="99% decrease in maintenance cost"
			description="No need to buy expensive hardware or maintain it, everything is cloud-based."
			icon={HardwareDecrease}
			className="bg-purple-400"
		/>
	</div>

	<div class="flex flex-row items-center justify-end gap-2 text-white sm:hidden">
		<p>Swipe Right</p>
		<Image src={ArrowRight} alt="arrow-right" class="h-8 w-8" />
	</div>

	<div class="carousel carousel-center mt-2 w-full max-w-md space-x-4 sm:hidden">
		<FeatureCard
			title="32% Increase in tables turnover and sales"
			description="With Astro-Menu, customers can order faster and more efficiently."
			icon={SalesIncrease}
			className="carousel-item w-[70%] flex-col bg-green-400"
		/>
		<FeatureCard
			title="95% decrease in printing cost"
			description="No need to print menus, print receipt or waste paper on taking orders, everything is digital, plus it's eco-friendly."
			icon={PrintDecrease}
			className="carousel-item w-[70%] flex-col bg-cyan-400"
		/>
		<FeatureCard
			title="99% decrease in maintenance cost"
			description="No need to buy expensive hardware or maintain it, everything is cloud-based."
			icon={HardwareDecrease}
			className="carousel-item w-[70%] flex-col bg-purple-400"
		/>
	</div>
</section>
