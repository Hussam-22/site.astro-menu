---
import Link from "@ui/link.astro";

const { plan, index } = Astro.props;

const DOMAIN = "https://app.astro-menu.com/register";
// const DOMAIN = 'http://localhost:3035/register'
---

<!-- <div
	class={`intersect:animate-fade intersect-once w-full order-first lg:order-0 ${plan.popular && 'bg-linear-to-b from-purple-400 to-cyan-400'} p-2 bg-white rounded-xxl`}
	style={`animation-delay: ${index * 0.25}s`}
></div> -->
<div
  class={`w-full order-first lg:order-0 ${plan.popular && "bg-linear-to-br from-orange-400 to-red-400"} p-2 bg-base-300 rounded-4xl`}
>
  <div class="rounded-4xl flex h-full flex-col justify-between bg-white p-6">
    <div
      style="display:flex; justify-content:space-between; align-items:center;"
      class="mb-2"
    >
      <div
        style="display:flex; flex-direction: row; align-items:center; gap:8px"
      >
        <img
          src={`/assets/plans/${plan.icon}.svg`}
          alt="coffee"
          class="mx-auto h-10 w-10"
          loading="lazy"
        />
        <p class="whitespace-nowrap text-lg font-bold xl:text-2xl">
          {plan.name}
        </p>
      </div>
      {
        plan.popular && (
          <div class="rounded-lg bg-linear-to-br from-orange-400 to-red-400 px-2 py-1 text-xs font-bold uppercase text-white">
            <p>most popular</p>
          </div>
        )
      }
    </div>
    <p class="h-32 text-sm">{plan.description}</p>
    <p class="py-1 text-center text-5xl font-bold">
      {plan.price}
      <span class="text-sm">/month</span>
    </p>

    <div class="flex grow flex-col">
      <ul class="mt-8 grid grow gap-y-0 text-left list-disc ml-4">
        {
          plan.features.map((item) => (
            <li class={item.startsWith("x") ? "font-bold" : ""}>
              <span>{item.startsWith("x") ? item.slice(1) : item}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-4 flex">
        <Link
          href={`${DOMAIN}?planID=${plan.param}`}
          block
          style="primary"
          class="bg-green-400 text-black"
          target="_blank"
        >
          Get Started for Free
        </Link>
      </div>
    </div>
  </div>
</div>
