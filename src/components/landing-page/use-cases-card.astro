---
import Image from "astro/components/Image.astro";

const { label, description, imgComponent, classList } = Astro.props;
---

<div class:list={["flex flex-col gap-2 rounded-4xl pb-3", classList]}>
  <div class="p-3 rounded-4xl">
    <Image
      src={imgComponent}
      alt="Use Cases Hero Image"
      class="w-full h-full rounded-4xl"
    />
  </div>
  <h2 class="text-2xl font-extrabold px-6 capitalize">{label}</h2>
  <p class="text-base px-6 min-h-18">{description}</p>
</div>
