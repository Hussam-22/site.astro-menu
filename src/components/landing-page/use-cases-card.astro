---
import Image from "astro/components/Image.astro";

const { label, description, iconPath, imagePath, benefit, features } =
  Astro.props;
---

<div class="flex flex-col gap-2 bg-base-200 rounded-4xl pt-4">
  <h2 class="text-2xl font-bold px-4 capitalize">{label}</h2>
  <p class="text-base px-4 min-h-18">{description}</p>
  <Image
    src={imagePath}
    alt="Use Cases Hero Image"
    class="w-full h-auto rounded-b-4xl"
    width={100}
    height={100}
  />
</div>
