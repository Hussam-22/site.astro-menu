---
import AstroMenuQrCode from "@components/astro-menu-qr-code.astro";
import Container from "@components/container.astro";
import CheckMark from "@components/ui/icons/check.astro";
import CrossMark from "@components/ui/icons/cross.astro";
import PhoneMockup from "@components/ui/phone-mockup.astro";
import oldMenu from "assets/old-menu.png";
import menuPreview from "assets/views/menu-preview.webp";

const GOOD = [
  "Dynamic Interactive Menu",
  "Mobile Friendly Design",
  "Multi Language",
  "Meals Filtering",
  "Menu Navigation",
  "Order Cart and Summary",
  "Restaurant Landing Page",
  "Show Wifi Password",
  "Fast Loading Menu",
  "Social Links",
];

const BAD = [
  "Static and Unresponsive Menu",
  "Zooming In and Out Required",
  "Non-Mobile Friendly Design",
  "Unattractive Appearance",
  "Single Language Support",
  "No Order Cart or Summary",
  "Slow Loading Times",
];
---

<section>
  <Container>
    <div class="bg-base-200 sm:p-16 rounded-4xl">
      <h2 class="text-4xl font-black lg:text-5xl lg:tracking-tight">
        Astro-Menu vs Regular Menus
      </h2>
      <p class="mt-4 text-lg">
        Why Astro-Menu is the best choice for your food business
      </p>
      <div
        class="flex flex-col items-center justify-between gap-10 lg:flex-row mt-12"
      >
        <div
          class="flex w-full flex-col items-center justify-around gap-10 sm:flex-row sm:gap-2"
        >
          <div class="text-xl leading-7">
            {
              GOOD.map((item) => (
                <div class="flex items-center gap-2">
                  <CheckMark class="h-4 w-4" />
                  <p class="text-md whitespace-nowrap leading-8">{item}</p>
                </div>
              ))
            }
          </div>
          <PhoneMockup imgSrc={menuPreview} text="Astro-Menu" />
        </div>

        <div class="flex flex-row items-center justify-center lg:flex-col">
          <span class="h-1 w-32 bg-gray-200 lg:h-32 lg:w-1"></span>
          <span class="px-2 text-lg font-medium lg:py-2">vs</span>
          <span class="h-1 w-32 bg-gray-200 lg:h-32 lg:w-1"></span>
        </div>

        <div
          class="flex w-full flex-col items-center justify-around gap-10 sm:flex-row sm:gap-2"
        >
          <PhoneMockup imgSrc={oldMenu} text="Other Menus" />
          <div class="text-left text-xl">
            {
              BAD.map((item) => (
                <div class="flex items-center gap-2">
                  <CrossMark class="h-4 w-4" />
                  <p class="text-md whitespace-nowrap leading-8">{item}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <AstroMenuQrCode />
  </Container>
</section>
