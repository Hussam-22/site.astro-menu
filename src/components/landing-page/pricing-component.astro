---
import Container from "@components/container.astro";
import PricingCard from "@components/landing-page/pricing-card.astro";
import SectionHead from "@components/ui/section-head.astro";

const pricing = [
  {
    name: "Social Bites",
    price: "9$",
    popular: false,
    features: [
      "1 Social Account",
      `1 "Menu View" QR Code`,
      "1 Translation Languages",
      "25 Meals",
      "Unlimited Menus",
      "Cloud Admin Dashboard",
      "1,000,000 Scans /per month",
      "Business Home/landing page",
      "Social Media Links",
    ],
    button: {
      text: "Get Started",
      link: "/",
    },
    icon: "social-hero",
    description:
      "Perfect for food businesses on social media, this plan helps you showcase your offerings and engage with customers online effortlessly.",
    param: "prod_QSORufNWBDLHz6",
  },
  {
    name: "Coffee Cup",
    price: "39$",
    popular: true,
    features: [
      "1 Branch",
      `1 "Menu View" QR Code`,
      `25 "Table" QR Codes`,
      "3 Translation Languages",
      "50 Meals",
      "Unlimited Menus",
      "Unlimited Scans (Fair Usage Policy)",
      "Unlimited Orders",
      "Cloud POS/Waitstaff Dashboard",
      "Cloud Kitchen Dashboard",
      "Cloud Admin Dashboard",
      "Analytics & Reports",
      "Business Home/landing page",
      "Social Media Links",
    ],
    button: {
      text: "Get Started",
      link: "/",
    },
    icon: "coffeecup",
    description:
      "Designed for small-scale food businesses like cozy cafes, bakeries, or specialty dessert shops. This plan is ideal for establishments with focused menus looking to enhance their customer experience and streamline operations.",
    param: "prod_QSJoKo5g5BbTLW",
  },
  {
    name: "Menu Master",
    price: "59$",
    popular: false,
    features: [
      "1 Branch",
      `1 "Menu View" QR Code`,
      `50 "Table" QR Codes`,
      "4 Translation Languages",
      "Unlimited Meals",
      "Unlimited Menus",
      "Unlimited Scans (Fair Usage Policy)",
      "Unlimited Orders",
      "Cloud POS/Waitstaff Dashboard",
      "Cloud Kitchen Dashboard",
      "Cloud Admin Dashboard",
      "Analytics & Reports",
      "Business Home/landing page",
      "Social Media Links",
    ],
    button: {
      text: "Get Started",
      link: "/",
    },
    icon: "menumaster",
    description:
      "Ideal for full-service restaurants and larger establishments with diverse and dynamic menus. This plan supports seamless menu management and operational efficiency for businesses catering to broader customer bases.",
    param: "prod_QSJp5bB2jPwc69",
  },
];
---

<Container class="flex flex-col items-center">
  <SectionHead
    title="Pricing Plans"
    description="Choose the right plan for your business"
    classList="text-center self-center"
  />

  <div class="mx-auto grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {pricing.map((item, index) => <PricingCard plan={item} index={index} />)}
  </div>

  <p class="mt-4 text-sm font-light text-neutral-400">
    *Unlimited scans are subject to fair usage policy. For more information,
    please refer to our terms of service.
  </p>
</Container>
