---
import { Image } from 'astro:assets'
import ArrowRight from 'assets/icons/arrow-right.svg'

const REASONS = [
	// why you should switch from print menu to QR menu ?
	{
		title: 'Easy updates',
		description:
			'No more re-printing of menu, you can now update your menu with a click of a button.',
		icon: 'easy-update'
	},
	{
		title: 'Filter meals',
		description:
			'Customers can filter meals based on their dietary restrictions or preferences, e.g. vegan, gluten-free, etc, get them to place orders faster.',
		icon: 'filter-meals'
	},

	{
		title: 'Increase table turnover',
		description: 'Customers can place orders from their phones, which means faster table turnover.',
		icon: 'table-turnover'
	},
	{
		title: 'No more waiting for the waiter',
		description: 'Customers dont have to wait for the menu or the waiter to take their order.',
		icon: 'no-waiting'
	},
	{
		title: 'No need for multiple menus with different languages',
		description: 'Customers can view the menu in their preferred language.',
		icon: 'multi-language'
	},
	{
		title: 'The eye eats first',
		description: 'show images of your menu items to entice customers.',
		icon: 'eye-eats-first'
	},
	{
		title: 'Get useful insights',
		description:
			'Get useful insights on your orders status, Most ordered meal, your total earning, and more.',
		icon: 'useful-insights'
	},
	{
		title: 'No more paper waste',
		description: 'Save the environment by using digital menu.',
		icon: 'no-paper-waste'
	},
	{
		title: 'Share QR code/Link on social media',
		description:
			'Share your QR code on social media to attract more customers, with always up-to-date menu.',
		icon: 'share-on-social-media'
	},
	{
		title: 'Hygiene and Safety',
		description:
			'QR menus eliminate the need for shared physical menus, reducing the risk of spreading germs and viruses',
		icon: 'hygiene-and-safety'
	}
]
---

<section>
	<div class="mb-16 text-center text-white">
		<h2 class="text-4xl font-bold lg:text-5xl lg:tracking-tight">
			Why you should switch to digital QR menu anyway?
		</h2>
		<p class="mb-12 mt-4 text-lg">
			Switching to a digital QR menu streamlines operations, reduces costs, and improves customer
			experience by offering contactless access and easy updates. It also enhances hygiene, cuts
			printing expenses, and allows instant menu changes to keep offerings fresh and accurate.
		</p>
	</div>

	<div class="hidden gap-4 sm:grid sm:grid-cols-5">
		{
			REASONS.map((item, index) => (
				<div
					class="rounded-xxl flex flex-col bg-white p-8"
					style={`animation-delay: ${index * 25}ms`}
				>
					<img src={`/assets/icons/why-to-switch/${item.icon}.svg`} alt="icon" class="h-12 w-12" />
					<div>
						<h3 class="text-xl font-semibold">{item.title}</h3>
						<p class="mt-1 leading-relaxed ">{item.description}</p>
					</div>
				</div>
			))
		}
	</div>

	<div class="flex flex-row items-center justify-end gap-2 text-white sm:hidden">
		<p>Swipe Right</p>
		<Image src={ArrowRight} alt="arrow-right" class="h-8 w-8" />
	</div>
	<div class="carousel carousel-center mt-2 w-full max-w-md space-x-4 sm:hidden">
		{
			REASONS.map((item, index) => (
				<div class="carousel-item w-[90%]">
					<div
						class="rounded-xxl flex flex-col bg-white p-8"
						style={`animation-delay: ${index * 25}ms`}
					>
						<img
							src={`/assets/icons/why-to-switch/${item.icon}.svg`}
							alt="icon"
							class="h-12 w-12"
						/>
						<div>
							<h3 class="text-xl font-semibold">{item.title}</h3>
							<p class="mt-1 leading-relaxed ">{item.description}</p>
						</div>
					</div>
				</div>
			))
		}
	</div>
</section>
