---
import Container from "@components/container.astro";
import Carousel from "@components/ui/carousel.astro";
import SectionHead from "@components/ui/section-head.astro";
import UseCasesCard from "./use-cases-card.astro";

const TABS = [
  {
    name: "restaurant",
    label: "Restaurants & Cafes",
    content: "src/components/landing-page/use-case-tab-content.astro",
    iconPath: "/icons/use-cases/bar.svg",
    imagePath: "/assets/images/use-cases/restaurant.webp",
    benefit: "30% increase in table turnover",
    description:
      "Discover how our digital menu enhances the dining experience in restaurants.",
    classList: "bg-gradient-to-br from-rose-300 to-rose-400",
    enabled: true,
  },

  {
    name: "food-truck",
    label: "Food Truck",
    content: "src/components/landing-page/use-case-tab-content.astro",
    iconPath: "/icons/use-cases/food-truck.svg",
    imagePath: "/assets/images/use-cases/food-truck.webp",
    title: "Reduce the queue time, speed up the service",
    description:
      "Discover how astro-menu can help food trucks serve customers faster.",
    benefit: "20% increase in queue speed",
    classList: "bg-gradient-to-br from-sky-300 to-sky-400",
    enabled: true,
  },
  {
    name: "hospital",
    label: "hospital",
    content: "src/components/landing-page/use-case-tab-content.astro",
    iconPath: "/icons/use-cases/hospital.svg",
    imagePath: "/assets/images/use-cases/hospital.webp",
    description:
      "Discover how our digital menu enhances the hospitality experience.",
    classList: "bg-gradient-to-br from-emerald-300 to-emerald-400",
    enabled: true,
  },
  {
    name: "hotel",
    label: "Hotel",
    content: "src/components/landing-page/use-case-tab-content.astro",
    iconPath: "/icons/use-cases/hotel.svg",
    imagePath: "/assets/images/use-cases/hotel.webp",
    description: "Discover how our digital menu enhances the hotel experience.",
    classList: "bg-gradient-to-br from-violet-300 to-violet-400",
    enabled: true,
  },
];
---

<!-- name of each tab group should be unique -->
<Container class="flex flex-col justify-center">
  <SectionHead
    title="Use Cases"
    description="Explore how our digital menu can benefit various types of establishments."
    classList="text-center self-center"
  />
  <div class="grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 hidden sm:grid">
    {TABS.filter((tab) => tab.enabled).map((tab) => <UseCasesCard {...tab} />)}
  </div>

  <Carousel length={TABS.length} name="testimonials">
    {
      TABS.filter((tab) => tab.enabled).map((tab) => (
        <UseCasesCard
          {...tab}
          classList={[tab.classList, "carousel-item w-[80%]"]}
        />
      ))
    }
  </Carousel>
</Container>
