---
import Container from "@components/container.astro";
import SectionHead from "@components/ui/section-head.astro";
import SideTabs from "@components/ui/side-tabs";

const TABS = [
  {
    name: "restaurant",
    label: "Restaurants & Cafes",
    content: "src/components/landing-page/use-case-tab-content.astro",
    iconPath: "/icons/use-cases/bar.svg",
    imagePath: "/assets/images/use-cases/restaurant.webp",
    description:
      "Discover how our digital menu enhances the dining experience in restaurants.",
    features: [
      "No wait for menus",
      "Faster ordering",
      "Fewer mistakes",
      "Fewer back-and-forths",
      "Fewer staff needed",
      "Multi-Language",
      "Reduce Printing Costs",
      "Wifi Password",
      "Easy to update",
      "Contactless",
    ],
  },
  {
    name: "food-truck",
    label: "Food Truck",
    content: "src/components/landing-page/use-case-tab-content.astro",
    iconPath: "/icons/use-cases/food-truck.svg",
    imagePath: "/assets/images/use-cases/food-truck.webp",
    description: "Reduce the queue time, speed up the service",
  },
  {
    name: "hospital",
    label: "hospital",
    content: "src/components/landing-page/use-case-tab-content.astro",
    iconPath: "/icons/use-cases/hospital.svg",
    imagePath: "/assets/images/use-cases/hospital.webp",
    description:
      "Discover how our digital menu enhances the hospitality experience.",
  },
  {
    name: "hotel",
    label: "Hotel",
    content: "src/components/landing-page/use-case-tab-content.astro",
    iconPath: "/icons/use-cases/hotel.svg",
    imagePath: "/assets/images/use-cases/hotel.webp",
    description: "Discover how our digital menu enhances the hotel experience.",
  },
  {
    name: "social-media",
    label: "Social Media",
    content: "src/components/landing-page/use-case-tab-content.astro",
    iconPath: "/icons/use-cases/social-media.svg",
    imagePath: "/assets/images/use-cases/social-media.webp",
    description:
      "Stop the scrolling, stop the redundant DM conversations, and start selling.",
  },
];
---

<!-- name of each tab group should be unique -->
<Container class="flex flex-col justify-center">
  <SectionHead
    title="Use Cases"
    description="Explore how our digital menu can benefit various types of establishments."
    classList="text-center self-center"
  />

  <SideTabs client:load tabs={TABS} />
</Container>
