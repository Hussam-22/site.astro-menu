---
import Button from '@components/ui/button.astro'
import PhoneMockup from '@components/ui/phone-mockup.astro'
import astroMenuPhone from 'assets/astro-menu-phone.png'
import waitStaffDashboard from 'assets/views/waitstaff-dashboard.png'
import TabletMockup from '@components/ui/tablet-mockup.astro'
import SectionCard from '@components/ui/section-card.astro'
import Link from '@components/ui/link.astro'
---

<script>
	const text = document.querySelector('.highlight') as HTMLElement

	const textLoad = () => {
		setTimeout(() => {
			text.textContent = 'Restaurant'
		}, 0)
		setTimeout(() => {
			text.textContent = 'Coffee Shop'
		}, 4100)
		setTimeout(() => {
			text.textContent = 'Social Media'
		}, 8100)
		setTimeout(() => {
			text.textContent = 'Food Business'
		}, 12100)
	}
	textLoad()
	setInterval(textLoad, 16000)
</script>

<style>
	.highlight::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		height: 100%;
		width: 100%;
		background-color: #ffffff;
		border-left: 2px solid #000000;
		animation: animate 4s steps(16) infinite;
	}
	@keyframes animate {
		40%,
		60% {
			left: calc(100% - 2px);
		}
		100% {
			left: 0%;
		}
	}
</style>

<main>
	<SectionCard bgColor="bg-white px-5 sm:pb-16 pb-10">
		<div class="mx-auto sm:max-w-[75%]">
			<div class="flex flex-col pt-10">
				<h1
					class="mb-2 text-[2.5rem] font-extrabold capitalize leading-none tracking-tighter text-zinc-300 sm:text-8xl"
				>
					Revolutionize Your
				</h1>
				<div class="relative w-fit overflow-hidden">
					<p
						class="highlight whitespace-nowrap pb-2 pr-1 text-[2.5rem] font-extrabold leading-none tracking-tighter sm:text-8xl"
					>
						Food Business
					</p>
				</div>
				<h1 class="text-[2.5rem] font-extrabold leading-none tracking-tighter sm:text-8xl">
					<span class="text-zinc-300">with</span> Astro Menu
				</h1>
			</div>

			<h2 class="mb-2 mt-4 text-lg font-semibold sm:mt-8 sm:text-3xl">
				Modern, Effortless, Deliciously Digital
			</h2>
			<p class="mb-10">
				Empower your restaurant with our cutting-edge QR menu and cloud POS solution. Seamlessly
				integrate ordering and kitchen management, all in one sleek, digital platform.
			</p>
			<Link href="/signup" size="lg" class="whitespace-nowrap bg-green-400 text-black">
				Get Started</Link
			>

			<div class="mt-14 flex flex-col items-center sm:relative sm:mt-20">
				<PhoneMockup
					className="z-10 sm:absolute sm:-bottom-10 sm:left-10"
					imgSrc={astroMenuPhone}
					text="Menu View"
				/>
				<TabletMockup
					className="invisible hidden flex-col sm:visible sm:flex"
					imgSrc={waitStaffDashboard}
					text="Waitstaff Dashboard"
				/>
			</div>
		</div>
	</SectionCard>
</main>
