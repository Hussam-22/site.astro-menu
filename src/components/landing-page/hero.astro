---
import Container from "@components/container.astro";
import Link from "@ui/link.astro";
import PhoneMockup from "@ui/phone-mockup.astro";
import TabletMockup from "@ui/tablet-mockup.astro";
import astroMenuPhone from "assets/views/menu-preview.webp";
import waitStaffDashboard from "assets/views/waitstaff-dashboard.png";
import Image from "astro/components/Image.astro";
import backgroundColorImage from "../../assets/backgrounds/bg-blur-multi.svg";
---

<Container>
  <div class="grid sm:grid-cols-2 gap-4 relative px-2 pt-16 sm:pt-44 pb-16">
    <Image
      src={backgroundColorImage}
      alt="Background Blur"
      class="w-full h-full object-cover bg-center opacity-75 blur-3xl absolute rounded-4xl z-0"
      loading="eager"
    />
    <div
      class="flex flex-col justify-center gap-2 z-10 mb-8 sm:mb-0 text-center sm:text-left"
    >
      <h1 class="text-6xl font-extrabold">
        Digital Menus for <span
          class="bg-linear-to-r from-purple-500 via-red-500 to-orange-500 bg-clip-text text-transparent"
          >Rooms, Trucks, Tables,</span
        > and More.
      </h1>

      <h2 class="mb-4 text-xl">
        From restaurants to hotel rooms, Astro Menu is built for every food
        business.
      </h2>
      <div class="flex flex-col sm:flex-row items-center gap-4">
        <Link href="/pricing" size="lg">Start for Free</Link>
        <p class="text-sm">14 Days Free Trial. No credit card required.</p>
      </div>
    </div>

    <div class="flex flex-col items-center relative">
      <PhoneMockup
        className="z-20 sm:absolute sm:-bottom-14 sm:right-8"
        imgSrc={astroMenuPhone}
        text="Menu View"
        isEager={true}
      />
      <TabletMockup
        className="absolute bottom-1 left-8 z-10 hidden sm:block"
        imgSrc={waitStaffDashboard}
        text="Waitstaff Dashboard"
      />
    </div>
  </div>
</Container>
