---
import Container from "@components/container.astro";
import Link from "@components/ui/link.astro";
import PhoneMockup from "@components/ui/phone-mockup.astro";
import TabletMockup from "@components/ui/tablet-mockup.astro";
import astroMenuPhone from "assets/views/menu-preview.webp";
import waitStaffDashboard from "assets/views/waitstaff-dashboard.png";
import Image from "astro/components/Image.astro";
import backgroundColorImage from "../../assets/backgrounds/bg-blur-multi.svg";
---

<Container>
  <div class="grid grid-cols-2 gap-4 relative px-8 py-24">
    <Image
      src={backgroundColorImage}
      alt="Background Blur"
      class="w-full h-full object-cover bg-center opacity-75 blur-3xl absolute rounded-4xl z-0"
      loading="eager"
    />
    <div class="flex flex-col justify-center gap-2 z-10">
      <h1 class="text-6xl font-black">
        Your Restaurant, Simplified<br />QR Menus & POS in Minutes
      </h1>

      <h2 class="mb-10 text-xl font-semibold">
        No commissions. Multi-language. Works on any device.
      </h2>
      <div class="flex flex-row items-center gap-4">
        <Link href="/pricing" size="lg"> Start Free Trial</Link>
        <p class="text-sm font-light">
          14 Days Free Trial. No credit card required.
        </p>
      </div>
    </div>

    <div class="flex flex-col items-center relative">
      <PhoneMockup
        className="z-10 sm:absolute sm:-bottom-20 sm:right-8"
        imgSrc={astroMenuPhone}
        text="Menu View"
        isEager={true}
      />
      <TabletMockup
        className="invisible hidden flex-col sm:visible sm:flex"
        imgSrc={waitStaffDashboard}
        text="Waitstaff Dashboard"
      />
    </div>
  </div>
</Container>
