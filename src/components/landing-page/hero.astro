<style>
	.input-wrapper {
		display: block;
		position: relative;
	}

	.input-wrapper > input {
		display: block;
		-webkit-appearance: none;
		-moz-appearance: none;
		appearance: none;
		width: 100%;
		background-color: transparent;
		border: none;
		outline: none;
	}

	.input-wrapper > .placeholder {
		position: absolute;
		top: 0;
		left: 0;
		pointer-events: none;
		white-space: nowrap;
		overflow: hidden;
		animation: typing 3s steps(22, end) infinite;
	}

	@keyframes typing {
		0% {
			width: 0;
		}
		25% {
			width: 100%; /* Width for 'Restaurant' */
		}
		50% {
			width: 100%; /* Width for 'Coffee Shop' */
		}
		75% {
			width: 100%; /* Width for 'Social Media' */
		}
		100% {
			width: 100%; /* Width for 'Food Business' */
		}
	}

	/* Text content for multiple strings */
	.input-wrapper > .placeholder::after {
		content: 'Restaurant';
		animation: text-cycle 12s steps(1) infinite;
	}

	@keyframes text-cycle {
		0% {
			content: 'Restaurant';
		}
		25% {
			content: 'Coffee Shop';
		}
		50% {
			content: 'Social Media';
		}
		75% {
			content: 'Food Business';
		}
		100% {
			content: 'Restaurant';
		}
	}
</style>

<main>
	<SectionCard bgColor="bg-white px-5 sm:pb-16 pb-10">
		<div class="mx-auto sm:max-w-[75%]">
			<div class="flex flex-col pt-10">
				<h1
					class="mb-2 text-[2.5rem] font-extrabold capitalize leading-none tracking-tighter text-zinc-300 sm:text-8xl"
				>
					Revolutionize Your
				</h1>
				<div
					class="input-wrapper text-[2.5rem] font-extrabold capitalize leading-none tracking-tighter sm:text-8xl"
				>
					<input type="text" />
					<div class="placeholder"></div>
				</div>
				<h1 class="text-[2.5rem] font-extrabold leading-none tracking-tighter sm:text-8xl">
					<span class="text-zinc-300">with</span> Astro Menu
				</h1>
			</div>

			<h2 class="mb-2 mt-4 text-lg font-semibold sm:mt-8 sm:text-3xl">
				Modern, Effortless, Deliciously Digital
			</h2>
			<p class="mb-10">
				Empower your restaurant with our cutting-edge QR menu and cloud POS solution. Seamlessly
				integrate ordering and kitchen management, all in one sleek, digital platform.
			</p>
			<Link href="/signup" size="lg" class="whitespace-nowrap bg-green-400 text-black">
				Get Started</Link
			>

			<div class="mt-14 flex flex-col items-center sm:relative sm:mt-20">
				<PhoneMockup
					className="z-10 sm:absolute sm:-bottom-10 sm:left-10"
					imgSrc={astroMenuPhone}
					text="Menu View"
				/>
				<TabletMockup
					className="invisible hidden flex-col sm:visible sm:flex"
					imgSrc={waitStaffDashboard}
					text="Waitstaff Dashboard"
				/>
			</div>
		</div>
	</SectionCard>
</main>
