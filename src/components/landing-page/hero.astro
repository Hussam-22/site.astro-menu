---
import Button from '@components/ui/button.astro'
import PhoneMockup from '@components/ui/phone-mockup.astro'
import astroMenuPhone from 'assets/astro-menu-phone.png'
import astroMenuDashboard from 'assets/dashboard.png'
import TabletMockup from '@components/ui/tablet-mockup.astro'
import SectionCard from '@components/ui/section-card.astro'
import Link from '@components/ui/link.astro'
---

<script>
	const text = document.querySelector('.highlight') as HTMLElement

	const textLoad = () => {
		setTimeout(() => {
			text.textContent = 'Restaurant'
		}, 0)
		setTimeout(() => {
			text.textContent = 'Coffee Shop'
		}, 4000)
		setTimeout(() => {
			text.textContent = 'Food Business'
		}, 8000)
	}
	textLoad()
	setInterval(textLoad, 12000)
</script>

<style>
	.highlight::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		height: 100%;
		width: 100%;
		background-color: #ffffff;
		border-left: 2px solid #000000;
		animation: animate 4s steps(16) infinite;
	}
	@keyframes animate {
		40%,
		60% {
			left: calc(100% - 2px);
		}
		100% {
			left: 0%;
		}
	}
</style>

<main>
	<SectionCard bgColor="bg-white">
		<div class="flex flex-col px-6 py-10 sm:px-14 sm:pb-16">
			<div class="pb-7 sm:w-[75%]">
				<h1 class="mb-2 text-5xl font-extrabold capitalize leading-none sm:text-8xl">
					Revolutionize Your
				</h1>
				<div class="relative w-fit overflow-hidden">
					<p
						class="highlight whitespace-nowrap pb-2 text-5xl font-extrabold leading-none sm:text-8xl"
					>
						Food Business
					</p>
				</div>

				<h2 class="my-4 text-2xl sm:text-3xl">Modern, Effortless, Deliciously Digital</h2>
				<p class="mb-4">
					Empower your restaurant with our cutting-edge QR menu and cloud POS solution. Seamlessly
					integrate ordering and kitchen management, all in one sleek, digital platform.
				</p>
				<div class="flex flex-row gap-2">
					<Link href="/signup" class="whitespace-nowrap bg-green-400 text-black"> Get Started</Link>
					<Link
						href="/features/welcome/introduction"
						class="whitespace-nowrap bg-cyan-400 text-black"
					>
						Features List</Link
					>
				</div>
			</div>

			<div class="mt-5 flex flex-col items-center sm:relative sm:mt-10">
				<PhoneMockup
					className="z-10 sm:absolute sm:-bottom-10 sm:left-10"
					imgSrc={astroMenuPhone}
					text="Menu View"
				/>
				<TabletMockup
					className="invisible hidden flex-col sm:visible sm:flex"
					imgSrc={astroMenuDashboard}
					text="Waitstaff Dashboard"
				/>
			</div>
		</div>
	</SectionCard>
</main>
