---
import Button from '@components/ui/button.astro'
import PhoneMockup from '@components/ui/phone-mockup.astro'
import astroMenuPhone from 'assets/astro-menu-phone.png'
import astroMenuDashboard from 'assets/dashboard.png'
import TabletMockup from '@components/ui/tablet-mockup.astro'
import SectionCard from '@components/ui/section-card.astro'
---

<main>
	<SectionCard bgColor="bg-white" sx="py-10 px-6 sm:px-0">
		<div class="flex flex-col items-center justify-center pb-6 pt-6 text-center sm:pb-16">
			<div class="sm:w-[75%]">
				<div class="pb-7">
					<h1
						class="mb-4 text-4xl font-extrabold capitalize leading-tight text-black sm:text-6xl sm:leading-normal"
					>
						Revolutionize Your Food Business with
						<span
							class="rounded-xxl whitespace-nowrap bg-zinc-950 px-4 py-1 text-4xl font-bold leading-loose text-white sm:text-6xl"
							>Astro-Menu
						</span>
					</h1>
					<h2 class="my-4 text-2xl sm:text-3xl">Modern, Effortless, Deliciously Digital</h2>
					<p class="mb-4">
						Empower your restaurant with our cutting-edge QR menu and POS solution. Seamlessly
						integrate ordering and kitchen management, all in one sleek, digital platform.
					</p>
					<div class="flex flex-row items-center justify-center gap-2 text-center">
						<Button href="/signup" class="" class="whitespace-nowrap bg-green-400 text-black">
							Get Started</Button
						>
						<Button href="/signup" class="" class="whitespace-nowrap bg-cyan-400 text-black">
							Features List</Button
						>
					</div>
				</div>
			</div>

			<div class="mt-5 flex flex-col items-center sm:relative sm:mt-10">
				<PhoneMockup
					className="z-10 sm:absolute sm:-bottom-10 sm:left-10"
					imgSrc={astroMenuPhone}
					text="Menu View"
				/>
				<TabletMockup
					className="invisible hidden flex-col sm:visible sm:flex"
					imgSrc={astroMenuDashboard}
					text="Waitstaff Dashboard"
				/>
			</div>
		</div>
	</SectionCard>
</main>
