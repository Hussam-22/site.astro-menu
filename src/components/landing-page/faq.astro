---
import { FAQs } from "@data/faqs";
---

<section class="sm:mx-auto sm:w-2/3">
  <div class="mb-16 text-center">
    <h2 class="text-4xl font-bold text-white lg:text-5xl lg:tracking-tight">
      Frequently asked questions
    </h2>
  </div>

  {
    FAQs.map((faq) => (
      <div class="collapse mb-2">
        <input type="radio" name="my-accordion-3" />
        <div class="rounded-4xl collapse-title bg-white px-8 text-xl font-semibold">
          {faq.question}
        </div>
        <div class="collapse-content -mt-6 mb-1 rounded-[0_0_50px_50px] bg-black">
          <p class="px-6 pb-2 pt-8 text-lg text-white">{faq.answer}</p>
        </div>
      </div>
    ))
  }
</section>
