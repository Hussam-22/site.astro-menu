---
import astroMenuDashboard from 'assets/views/waitstaff-dashboard.png'
import TabletMockup from '@components/ui/tablet-mockup.astro'
import SectionCard from '@components/ui/section-card.astro'
import ListItem from '@components/ui/list-item.astro'
import Link from '@components/ui/link.astro'
---

<SectionCard
	bgColor="bg-zinc-800 text-white"
	sx="py-10 overflow-hidden bg-[url('/assets/backgrounds/bg-blur-multi.svg')] bg-no-repeat bg-center bg-cover sm:bg-contain"
>
	<div class="flex flex-col items-center justify-center px-6 pb-8 text-center sm:px-16 sm:pb-16">
		<div>
			<div class="pb-7">
				<h1
					class="mb-6 rounded-lg text-4xl font-extrabold capitalize sm:text-6xl sm:leading-normal"
				>
					Powerful <span
						class="bg-gradient-to-r from-purple-400 via-cyan-500 to-green-500 bg-clip-text p-2 text-transparent"
						>PoS/Dashboard</span
					> to run your business smoothly
				</h1>
				<p class="mb-4 text-xl">
					Astro-Menu comes with its own cloud-based dashboard to manage your food business. It's
					easy to use and has all the features you need to run your business smoothly.
				</p>
			</div>
		</div>
		<div class="flex flex-col gap-8 sm:flex-row sm:items-center sm:justify-between">
			<div class="flex flex-col gap-2 sm:w-1/2">
				<ListItem
					title="Easy to use"
					description="Astro-Menu dashboard is easy to use and has a clean interface."
				/>
				<ListItem
					title="Real-time Sync"
					description="Get orders synced between customers and your dashboard in real-time."
				/>
				<ListItem
					title="Real-time Enable/Disable Meal"
					description="Enable or disable meals in real-time from the dashboard that will reflect to all customers in real-time."
				/>
				<ListItem
					title="Call Waiter"
					description="Customers can call the waiter from the menu and see which table is calling your waiter directly from the dashboard tables in real-time."
				/>
				<ListItem
					title="Print and Email Receipts"
					description="Print and email receipts directly from the dashboard to your customers."
				/>
				<ListItem
					title="Search Past Orders"
					description="Search completed orders in case you need to re-print or re-email receipts."
				/>
				<ListItem
					title="No Physical Lock-in"
					description="Astro-Menu dashboard is cloud-based and can be accessed from anywhere."
				/>

				<Link
					href="/docs/dashboards/waitstaff"
					class="mt-6 hidden bg-white sm:grid"
					style="primary"
				>
					Dashboard Features
				</Link>
			</div>
			<TabletMockup className="-mr-96" imgSrc={astroMenuDashboard} />
		</div>

		<Link href="/docs/dashboards/waitstaff" class="mt-8 bg-white sm:hidden" style="primary">
			Dashboard Features
		</Link>
	</div>
</SectionCard>
