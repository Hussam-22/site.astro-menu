---
import Container from "@components/container.astro";
import FeatureCard from "@ui/feature-card.astro";
import SectionHead from "@ui/section-head.astro";
import Commissions from "../../assets/icons/commission.svg";
import POS from "../../assets/icons/pos.svg";
import QRCode from "../../assets/icons/qr-code.svg";

const features = [
  {
    title: "No Commissions",
    description: `Flat monthly fee, keep your profits`,
    bgColor: "bg-purple-400",
    icon: Commissions,
  },
  {
    title: "Cloud POS Included",
    description: `No annual contract, no maintenance fees`,
    bgColor: "bg-orange-400",
    icon: POS,
  },
  {
    title: "Instant QR Menus",
    description: "No app downloads, just scan & order",
    bgColor: "bg-sky-400",
    icon: QRCode,
  },
];
---

<Container class="flex flex-col items-center text-center">
  <SectionHead
    title="why Astro-Menu"
    description="Make your dining experience seamless. From QR menus to built-in POS, Astro-Menu helps you serve customers faster, cut costs, and grow your business - without paying commissions."
    classList="text-center"
  />

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-4">
    {
      features.map((feature) => (
        <FeatureCard
          title={feature.title}
          description={feature.description}
          icon={feature.icon}
        />
      ))
    }
  </div>
  <a
    href="/features"
    class="mt-8 bg-black text-white px-4 py-2 rounded-4xl font-bold text-xl"
  >
    All Features
  </a>
</Container>
