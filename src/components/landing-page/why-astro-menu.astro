---
import Container from "@components/container.astro";
import FeatureCard from "@ui/feature-card.astro";
import Link from "@ui/link.astro";
import SectionHead from "@ui/section-head.astro";
import Commissions from "../../assets/icons/commission.svg";
import Translate from "../../assets/icons/translate.svg";
import QRCode from "../../assets/icons/qr-code.svg";

const features = [
  {
    title: "No Commissions",
    description: `Flat monthly fee, keep your profits`,
    bgColor: "bg-purple-400",
    icon: Commissions,
  },
  {
    title: "Multi-Language",
    description: `Auto-translate your menu for every guest`,
    bgColor: "bg-orange-400",
    icon: Translate,
  },
  {
    title: "Instant QR Menus",
    description: "No app downloads, just scan & browse",
    bgColor: "bg-sky-400",
    icon: QRCode,
  },
];
---

<Container class="flex flex-col items-center text-center">
  <SectionHead
    title="Why Astro-Menu"
    tag="h2"
    description="Make your menu effortless to browse. Astro-Menu is a simple QR digital menu that helps you serve customers faster, cut costs, and grow your business — without paying commissions."
    classList="text-center"
  />

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-4">
    {
      features.map((feature) => (
        <FeatureCard
          title={feature.title}
          description={feature.description}
          icon={feature.icon}
        />
      ))
    }
  </div>
  <Link href="/features" class="w-fit mt-8 self-center" size="lg" style="dark">
    Explore All Features
  </Link>
</Container>
