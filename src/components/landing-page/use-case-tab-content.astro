---
import PhoneMockup from "@components/ui/phone-mockup.astro";
import menu from "assets/images/mockups/qr-menu-menu-page.png";
import restaurantImage from "assets/images/use-cases/restaurant.webp";
import Image from "astro/components/Image.astro";
---

<div class="bg-base-100 grid grid-cols-2 gap-4 m-4 rounded-4xl">
  <div class="p-6">
    <p class="text-xl font-bold">Increase Ordering Speed</p>
    <p class="text-md">
      With our digital menu, you can increase your tables turnover by up to 30%
      and reduce the time spent on ordering.
      <ul class="list-disc pl-6 font-semibold mt-4">
        <li>No wait for menus</li>
        <li>Faster ordering</li>
        <li>Fewer mistakes</li>
        <li>Fewer back-and-forths</li>
        <li>Fewer staff needed</li>
        <li>Multi-Language</li>
        <li>Reduce Printing Costs</li>
        <li>Wifi Password</li>
        <li>Easy to update</li>
        <li>Contactless</li>
      </ul>
    </p>
  </div>
  <div class="relative overflow-hidden p-6">
    <PhoneMockup
      className="left-1/2 -translate-x-1/2 absolute -bottom-10"
      imgSrc={menu}
      isEager={true}
    />
    <Image src={restaurantImage} alt="" class="rounded-4xl h-" />
  </div>
</div>
