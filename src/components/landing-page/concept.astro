---
import ConceptCard from '@components/ui/concept-card.astro'
import affordableImage from 'assets/concept/affordability.webp'
import noCommissionImage from 'assets/concept/no-commission.webp'
import simplicityImage from 'assets/concept/simplicity.webp'
import { Image } from 'astro:assets'
import ArrowRight from 'assets/icons/arrow-right.svg'
const CONCEPTS = [
	{
		title: 'Simplicity',
		description:
			'simplicity is the key to success, we believe that the simpler the design the easier it is to use, thats why we have designed our product to be as simple as possible to use, no left and right scrolling, no jumping between menu sections, everything is just a click away in one single vertical menu',
		color: 'text-[#dfc4ab]',
		btnText: 'See all features',
		btnLink: '/features',
		imgSrc: simplicityImage
	},
	{
		title: 'Affordability',
		description:
			'We believe that having a good product should not cost you an arm and a leg, thats why we have designed our product to be as affordable as possible, with a simple pricing model that is easy to understand and easy to use',
		color: 'text-green-500',
		btnText: 'See all features',
		btnLink: '/features',
		imgSrc: affordableImage
	},
	{
		title: 'No Commission',
		description:
			'We dont make money out of your success, we believe that our success is tied to your success, thats why we dont take commission on your orders, just a monthly subscription, thats why we dont offer a payment solution, we take care of the menu, you take care of the money',
		color: 'text-blue-500',
		btnText: 'See all features',
		btnLink: '/features',
		imgSrc: noCommissionImage
	}
]
---

<section>
	<div class="intersect-once text-center text-white intersect:animate-fade-right">
		<h2 class="text-4xl font-bold lg:text-5xl lg:tracking-tight">Astro-Menu Concept</h2>
		<p class="mb-16 mt-4 text-lg">
			Astro-Menu team believes in 3 main concepts that identify the core of our product.
		</p>
	</div>
	<div class="flex flex-row items-center justify-end gap-2 text-white sm:hidden">
		<p>Swipe Right</p>
		<Image src={ArrowRight} alt="arrow-right" class="h-8 w-8" />
	</div>
	<div class="hidden gap-8 sm:grid sm:grid-cols-3">
		{
			CONCEPTS.map((concept, index) => (
				<ConceptCard
					class=""
					title={concept.title}
					description={concept.description}
					color="text-black"
					imgSrc={concept.imgSrc}
					direction="flex-col"
				/>
			))
		}
	</div>

	<div class="carousel carousel-center max-w-md space-x-4 rounded-box bg-neutral p-4 sm:hidden">
		{
			CONCEPTS.map((concept, index) => (
				<ConceptCard
					className="carousel-item w-96 -ml-4"
					title={concept.title}
					description={concept.description}
					color="text-black"
					imgSrc={concept.imgSrc}
					direction="flex-col"
				/>
			))
		}
	</div>
</section>
