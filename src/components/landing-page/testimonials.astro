---
import Container from "@components/container.astro";
import Carousel from "@ui/carousel.astro";
import SectionHead from "@ui/section-head.astro";
import logo1 from "assets/images/logos/logo-1.webp";
import logo2 from "assets/images/logos/logo-2.webp";
import logo3 from "assets/images/logos/logo-3.webp";
import Image from "astro/components/Image.astro";

const TESTIMONIALS = [
  {
    owner: "Ahmed S.",
    business_name: "The ACAI House Cafe",
    testimonial:
      "The implementation of a QR menu system has been a game-changer for The Acai House Cafe's drive-thru. Before this, our staff often felt overwhelmed, especially during peak hours, trying to take orders accurately and quickly. The line of cars would grow, and we could feel the stress from both our employees and our customers. We knew we had to find a better way to operate.",
    logo: logo1,
    link: "",
  },
  {
    owner: "Mayed",
    business_name: "FOAM COFFEE",
    testimonial:
      "Astro-Menu has been a great addition to how we operate at FOAM COFFEE. Managing our menu is incredibly easy, and updates appear instantly. One of the biggest advantages is how smoothly customers can view our menu online through Google, Maps, or even our social media pages before visiting. It helps them decide faster and improves their overall experience. As a mobile coffee truck, having a reliable and flexible system like Astro-Menu makes our day-to-day work much simpler.",
    logo: logo2,
    link: "https://menu.astro-menu.com/qr-menu/menu?businessProfileID=mbiRz8YmVGjOTvtknUOq&branchID=2EKctRFUaA06pGIvAT2D&tableID=upxdTRj5NaTRl68f6ly0",
  },
  {
    owner: "Saeed",
    business_name: "Number Eight Speciality Coffee",
    testimonial:
      "Astro-Menu transformed the way our customers interact with our menu at Number Eight Specialty Coffee. With more than 120 items, it used to take time for people to find what they wanted, but the filtering and clean layout changed everything. Customers can now browse, sort, and locate their preferred drinks or pastries in seconds, whether they’re checking the menu online or at the shop. This has noticeably reduced ordering time and kept the flow moving smoothly, especially during peak hours. The result is happier customers and a faster, more efficient service experience.",
    logo: logo3,
    link: "https://menu.astro-menu.com/qr-menu/menu?businessProfileID=MSoxzRsPzpahDlGdoFMY&branchID=2EKctRFUaA06pGIvAT2D&tableID=upxdTRj5NaTRl68f6ly0",
  },
  // {
  //   owner: "Dr. Hassan A.",
  //   business_name: "Clarity One-Day Surgery Clinic",
  //   testimonial:
  //     "In a one-day surgery setting, every detail matters for a smooth recovery. Before our digital meal selection system, nurses were often interrupted by patient meal requests, relying on error-prone paper menus. Now, frequent orders like coffee, water, or guest meals are served quickly, freeing staff to focus on what matters most: medical care",
  //   logo: logo3,
  // },
];
---

<Container class="sm:flex sm:flex-col sm:items-center">
  <SectionHead
    title="what our customers say"
    tag="h2"
    classList="text-center self-center"
  />
  <div class="mt-8 grid-cols-3 gap-4 hidden sm:grid">
    {
      TESTIMONIALS.map((testimonial) => (
        <div
          id={testimonial.owner}
          class="rounded-4xl bg-base-200 px-4 py-5 flex flex-col gap-2"
        >
          <Image
            src={testimonial.logo}
            alt={testimonial.owner}
            class="w-20 h-20 rounded-4xl"
          />
          <div>
            <h3 class="text-xl font-bold">{testimonial.business_name}</h3>
            <p class="mt-0 font-light">{testimonial.owner}</p>
          </div>
          <p class="">{testimonial.testimonial}</p>
          {testimonial.link && (
            <a
              href={testimonial.link}
              target="_blank"
              class="mt-2 text-sm text-blue-500 underline"
            >
              View Menu
            </a>
          )}
        </div>
      ))
    }
  </div>

  <Carousel length={TESTIMONIALS.length} name="testimonials">
    {
      TESTIMONIALS.map((testimonial, index) => (
        <div
          class="flex flex-col gap-2 p-4 bg-base-200 border-2 border-black rounded-4xl w-[90%] flex-shrink-0 snap-center carousel-item-card"
          id={`testimonial-item-${index}`}
        >
          <Image
            src={testimonial.logo}
            alt={testimonial.owner}
            class="w-36 h-36 rounded-4xl"
          />
          <p class="text-xl font-bold">{testimonial.business_name}</p>
          <p class="font-light">{testimonial.owner}</p>
          <p class="">{testimonial.testimonial}</p>
        </div>
      ))
    }
  </Carousel>
</Container>
