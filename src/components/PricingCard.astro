---
import { PRICE, PRICES, SITE } from '../config/site'
import { INCLUDED, INCLUDED_AR } from '../data/plan'
import Button from './ui/Button.astro'
import Check from './ui/Check.astro'
import Price from './ui/Price.astro'
import Regional from './ui/Regional.astro'
import { getLangFromUrl, localizePath } from '../i18n/ui'

interface Props {
	/** Home page shows a trimmed list; /pricing shows all of it. */
	compact?: boolean
	id?: string
	/**
	 * Heading level for the card title. On /pricing the card follows the h1
	 * directly so it must be an h2; on the home page it sits inside a section
	 * that already has an h2, where h3 is correct. Passing it in keeps the
	 * document outline valid on both.
	 */
	as?: 'h2' | 'h3'
}
const { compact = false, id, as: Heading = 'h3' } = Astro.props
const SubHeading = Heading === 'h2' ? 'h3' : 'h4'
const lang = getLangFromUrl(Astro.url)
const isAr = lang === 'ar'
const fullList = isAr ? INCLUDED_AR : INCLUDED
const list = compact ? fullList.slice(0, 8) : fullList
---

<!--
	Billing toggle. A checkbox plus CSS :has(), so the price swaps with zero
	JavaScript — nothing on this page hydrates.
-->
<div id={id} class="plan mx-auto w-full max-w-2xl">
	<div class="flex justify-center">
		<label
			class="border-ink bg-card relative inline-flex cursor-pointer items-center rounded-full border-[2.5px] p-1.5 shadow-[4px_4px_0_var(--color-ink)]"
		>
			<input type="checkbox" class="sr-only" id="billing-toggle" />
			<span class="sr-only">{isAr ? 'إظهار السعر السنوي' : 'Show yearly pricing'}</span>
			<span
				data-thumb
				class="bg-ink absolute top-1.5 bottom-1.5 start-1.5 w-[calc(50%-0.375rem)] rounded-full transition-transform duration-300 ease-out"
				aria-hidden="true"></span>
			<span
				data-period-label="monthly"
				class="label relative z-10 w-32 justify-center px-4 py-2.5 text-base transition-colors sm:w-36"
			>
				{isAr ? 'شهري' : 'Monthly'}
			</span>
			<span
				data-period-label="annual"
				class="label relative z-10 w-32 justify-center px-4 py-2.5 text-base transition-colors sm:w-36"
			>
				{isAr ? 'سنوي' : 'Yearly'}
			</span>
		</label>
	</div>

	<div class="bg-card border-ink mt-8 overflow-hidden rounded-[2rem] border-[3px] shadow-[8px_8px_0_var(--color-ink)]">
		<div class="border-ink border-b-[2.5px] p-8 text-center sm:p-10">
			<Heading class="text-3xl">
				{isAr ? 'باقة واحدة. كل شيء فيها.' : 'One plan. Everything in it.'}
			</Heading>

			<!--
				Two billing periods x two regions. The billing period swaps on
				[data-bill] via the checkbox below; the region swaps on
				[data-region-for] via html[data-region]. The two are independent, so
				every combination is in the markup and exactly one is ever painted.
			-->
			<div class="mt-6 min-h-[9.5rem]">
				<div data-bill="monthly" class="tabular">
					<p class="flex items-baseline justify-center gap-1">
						<span class="font-display text-7xl sm:text-8xl"><Price field="monthly" /></span>
						<span class="text-ink-soft text-xl font-semibold">{isAr ? '/شهريًا' : '/month'}</span>
					</p>
					<Regional region="global" as="p" class="text-ink-faint mt-2 text-lg">
						{
							isAr
								? `${PRICES.global.monthlyAed} شهريًا · فوترة شهرية`
								: `${PRICES.global.monthlyAed} a month · billed monthly`
						}
					</Regional>
					<Regional region="sy" as="p" class="text-ink-faint mt-2 text-lg">
						{isAr ? 'فوترة شهرية · بالدولار الأمريكي' : 'Billed monthly · in US dollars'}
					</Regional>
				</div>
				<div data-bill="annual" class="tabular">
					<p class="flex items-baseline justify-center gap-1">
						<span class="font-display text-7xl sm:text-8xl"><Price field="annualPerMonth" /></span>
						<span class="text-ink-soft text-xl font-semibold">{isAr ? '/شهريًا' : '/month'}</span>
					</p>
					<Regional region="global" as="p" class="text-ink-faint mt-2 text-lg">
						{
							isAr
								? `${PRICES.global.annualTotal} تُفوتَر سنويًا · ${PRICES.global.annualTotalAed}`
								: `${PRICES.global.annualTotal} billed yearly · ${PRICES.global.annualTotalAed}`
						}
					</Regional>
					<Regional region="sy" as="p" class="text-ink-faint mt-2 text-lg">
						{
							isAr
								? `${PRICES.sy.annualTotal} تُفوتَر سنويًا · بالدولار الأمريكي`
								: `${PRICES.sy.annualTotal} billed yearly · in US dollars`
						}
					</Regional>
					<p class="text-brand-text mt-1 text-lg font-bold">
						{isAr ? 'وفّر ' : 'Save '}<Price field="annualSaving" />{
							isAr ? ' سنويًا · خصم ' : ' a year · '
						}<Regional region="global">{PRICES.global.annualSavingPercent}</Regional><Regional
							region="sy">{PRICES.sy.annualSavingPercent}</Regional>{isAr ? '%' : '% off'}
					</p>
				</div>
			</div>

			<div class="mt-8">
				<Button href={SITE.signupUrl} size="lg" block>
					{isAr ? `ابدأ ${PRICE.trialDays} يومًا مجانًا` : `Start ${PRICE.trialDays} days free`}
				</Button>
				<p class="text-ink-faint mt-4 text-base">
					{isAr
						? 'بلا بطاقة مطلوبة · ألغِ في أي وقت · بلا رسوم إعداد'
						: 'No card required · Cancel any time · No setup fee'}
				</p>
			</div>
		</div>

		<div class="p-8 sm:p-10">
			<SubHeading class="label text-brand-text text-sm">
				{isAr ? 'كل شيء مشمول' : 'Everything included'}
			</SubHeading>
			<ul class="mt-5 grid gap-3 sm:grid-cols-2">
				{
					list.map((item) => (
						<li class="flex items-start gap-3 text-lg">
							<Check class="text-go mt-1.5" />
							<span class="text-pretty">{item}</span>
						</li>
					))
				}
			</ul>
			{
				compact && (
					<p class="mt-7">
						<a
							href={localizePath('/pricing', lang)}
							class="text-brand-text text-lg font-bold hover:underline"
						>
							{isAr
								? 'شاهد القائمة الكاملة، وشو يلي مش موجود عن قصد ←'
								: 'See the full list, and what is deliberately left out →'}
						</a>
					</p>
				)
			}
		</div>
	</div>
</div>

<style>
	/*
		:has() throughout, including for the toggle thumb and label colours below
		— NOT peer-checked:, which turned out to be unreliable here: Tailwind v4
		implements peer-* with a relative selector nested in :is(), and this
		project's target browsers do not consistently re-run style recalculation
		for that pattern when the peer's :checked state changes (Element.matches()
		confirms the selector, the computed style does not). :has() on an ancestor
		is the well-supported, invalidation-safe way to express the same thing.

		:has() on the plan container rather than on the label, because the price
		panels are not siblings of the checkbox — they sit in a different branch
		of the tree. Monthly is the default so the page is correct even in the
		instant before CSS applies.
	*/
	.plan [data-bill='annual'] {
		display: none;
	}
	.plan:has(#billing-toggle:checked) [data-bill='monthly'] {
		display: none;
	}
	.plan:has(#billing-toggle:checked) [data-bill='annual'] {
		display: block;
	}

	/* Base (monthly) position/colour. The checked state is applied as inline
	   styles by the script below rather than through a CSS selector — see the
	   comment there for why. */
	.plan [data-thumb] {
		transform: translateX(0);
	}
	.plan [data-period-label='monthly'] {
		color: var(--color-white);
	}
	.plan [data-period-label='annual'] {
		color: var(--color-ink);
	}
</style>

<script>
	// The thumb slide and label colour swap are set as inline styles rather
	// than through a CSS class/selector (:has(), peer-checked:, or a plain
	// toggled class all had the same failure mode in testing: the selector
	// matched and the cascade value resolved correctly, but the transitioned
	// property never actually repainted). Inline styles set directly on the
	// element sidestep selector matching and cascade entirely, which is the
	// only approach that was reliable. The untransitioned [data-bill] display
	// swap above is unaffected and stays CSS-only via :has().
	document.querySelectorAll<HTMLElement>('.plan').forEach((plan) => {
		const checkbox = plan.querySelector<HTMLInputElement>('#billing-toggle')
		const thumb = plan.querySelector<HTMLElement>('[data-thumb]')
		const monthlyLabel = plan.querySelector<HTMLElement>('[data-period-label="monthly"]')
		const annualLabel = plan.querySelector<HTMLElement>('[data-period-label="annual"]')
		if (!checkbox || !thumb) return

		const sync = () => {
			const annual = checkbox.checked
			const rtl = document.documentElement.dir === 'rtl'
			thumb.style.transform = annual ? `translateX(${rtl ? '-' : ''}100%)` : 'translateX(0)'
			monthlyLabel?.style.setProperty('color', annual ? 'var(--color-ink)' : 'var(--color-white)')
			annualLabel?.style.setProperty('color', annual ? 'var(--color-white)' : 'var(--color-ink)')
		}
		checkbox.addEventListener('change', sync)
		sync()
	})
</script>
