---
import Container from '@components/container.astro'
import { SITE, PLAN } from '@config/site'
import { LOCATIONS } from '@data/locations'
import { INDUSTRIES } from '@data/industries'
import { COMPARISONS } from '@data/comparisons'

const columns = [
	{
		heading: 'Product',
		links: [
			{ title: 'How it works', path: '/how-it-works' },
			{ title: 'Features', path: '/features' },
			{ title: 'Pricing', path: '/pricing' },
			{ title: 'FAQ', path: '/faq' },
			{ title: 'What is a QR menu?', path: '/qr-menu' },
			{ title: 'Digital menus', path: '/digital-menu' }
		]
	},
	{
		heading: 'By business',
		links: INDUSTRIES.map((i) => ({ title: i.name, path: `/digital-menu/${i.slug}` }))
	},
	{
		heading: 'By emirate',
		links: LOCATIONS.map((l) => ({ title: l.emirate, path: `/qr-menu/${l.slug}` }))
	},
	{
		heading: 'Compare',
		links: [
			...COMPARISONS.map((c) => ({ title: `vs ${c.against}`, path: `/compare/${c.slug}` })),
			{ title: 'All comparisons', path: '/compare' }
		]
	}
]
---

<footer class="mt-10 border-t border-line bg-page text-muted">
	<Container>
		<div class="grid gap-10 py-14 md:grid-cols-5">
			<div class="md:col-span-1">
				<a href="/" class="text-lg text-ink">
					<span class="font-extrabold">Astro</span><span class="text-brand">-Menu</span>
				</a>
				<p class="mt-3 text-sm">
					QR menus for restaurants, cafés and food trucks. One plan, {PLAN.monthly.aed} AED a month.
				</p>
				<a href={`mailto:${SITE.email}`} class="mt-3 inline-block text-sm text-ink hover:underline">
					{SITE.email}
				</a>
			</div>

			{
				columns.map((col) => (
					<nav aria-label={col.heading}>
						<h2 class="text-sm font-bold uppercase tracking-widest text-ink">{col.heading}</h2>
						<ul class="mt-4 space-y-2 text-sm">
							{col.links.map((link) => (
								<li>
									<a href={link.path} class="transition hover:text-ink hover:underline">
										{link.title}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>

		<div
			class="flex flex-col items-center justify-between gap-3 border-t border-line py-6 text-sm sm:flex-row"
		>
			<p>© {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
			<nav class="flex gap-5">
				<a href="/blog" class="hover:text-ink hover:underline">Blog</a>
				<a href="/contact" class="hover:text-ink hover:underline">Contact</a>
				<a href="/terms" class="hover:text-ink hover:underline">Terms</a>
				<a href="/privacy" class="hover:text-ink hover:underline">Privacy</a>
			</nav>
		</div>
	</Container>
</footer>
