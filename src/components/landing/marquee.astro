---
const ITEMS = [
	'Photo on every dish',
	'Automatic translation',
	'Calories & macros',
	'Dietary filters',
	'One dynamic QR code',
	'Unlimited menu views',
	'Sizes & portions',
	'Free or paid add-ons',
	'Wi-Fi password on the menu',
	'Menu analytics',
	'No app to download',
	'No commission, ever'
]
---

<section class="marquee overflow-hidden border-y border-line py-6" aria-hidden="true">
	<div class="marquee-track gap-3">
		{
			[...ITEMS, ...ITEMS].map((item, i) => (
				<span class="flex items-center gap-3 whitespace-nowrap px-3 text-lg font-extrabold text-muted">
					<span class="h-1.5 w-1.5 flex-none rounded-full bg-brand" />
					{item}
				</span>
			))
		}
	</div>
</section>
