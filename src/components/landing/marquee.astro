---
const ITEMS = [
	'Photo on every dish',
	'Automatic translation',
	'Calories & macros',
	'Dietary filters',
	'One dynamic QR code',
	'Unlimited menu views',
	'Sizes & portions',
	'Free or paid add-ons',
	'Wi-Fi password on the menu',
	'Menu analytics',
	'No app to download',
	'No commission, ever'
]

const TONES = ['bg-mint', 'bg-lilac', 'bg-butter', 'bg-blush', 'bg-sky']
---

<section class="marquee overflow-hidden border-y border-line py-6" aria-hidden="true">
	<div class="marquee-track gap-3">
		{
			[...ITEMS, ...ITEMS].map((item, i) => (
				<span
					class:list={[
						'pastel whitespace-nowrap rounded-full px-6 py-3 text-lg font-extrabold',
						TONES[i % TONES.length]
					]}
				>
					{item}
				</span>
			))
		}
	</div>
</section>
