---
import { Image } from 'astro:assets'
import Button from '@components/ui/button.astro'
import { SITE, PLAN } from '@config/site'
import menuSections from 'assets/screens/menu-sections.png'
import itemDetail from 'assets/screens/item-detail.png'
import filterSheet from 'assets/screens/filter-meal-type.png'

const pills = ['Photo on every dish', 'Arabic + English', 'Calories & macros', 'No commission']
---

<section class="pt-10 md:pt-16">
	<div class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
		<!-- Copy -->
		<div class="intersect-once intersect:animate-fade-right">
			<p
				class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-card px-4 py-2 text-sm font-bold"
			>
				<span class="relative flex h-2 w-2">
					<span
						class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand opacity-75"
					></span>
					<span class="relative inline-flex h-2 w-2 rounded-full bg-brand"></span>
				</span>
				One plan · {PLAN.monthly.aed} AED a month
			</p>

			<h1 class="text-display-sm font-extrabold text-ink md:text-display lg:text-display-lg">
				A QR menu<br />for your restaurant<span class="text-brandInk">.</span>
			</h1>

			<p class="mt-7 max-w-lg text-lg leading-relaxed text-muted md:text-xl">
				Customers scan a code and read your menu on their phone — with a photo on every dish, in
				their own language. You change a price in seconds and never reprint anything.
			</p>

			<div class="mt-9 flex flex-col gap-3 sm:flex-row">
				<Button href={SITE.signupUrl} variant="brand" size="lg">Start free for 30 days</Button>
				<Button href={SITE.demoMenuUrl} variant="surface" size="lg" target="_blank" rel="noopener">
					See a live menu →
				</Button>
			</div>

			<div class="mt-8 flex flex-wrap items-center gap-2">
				{
					pills.map((pill) => (
						<span class="rounded-full border border-line px-4 py-2 text-sm font-bold text-muted">
							{pill}
						</span>
					))
				}
			</div>
		</div>

		<!-- Bento -->
		<div class="intersect-once grid grid-cols-2 gap-4 intersect:animate-fade-left sm:gap-5">
			<div
				class="rounded-4xl col-span-1 row-span-2 overflow-hidden border border-line bg-card p-4 transition-transform duration-300 hover:-translate-y-1"
			>
				<Image
					src={menuSections}
					alt="A live Astro-Menu menu with sections, photos and prices"
					widths={[320, 640]}
					sizes="(max-width: 1024px) 45vw, 320px"
					loading="eager"
					class="h-full w-full rounded-3xl object-cover object-top shadow-xl"
				/>
			</div>

			<div class="rounded-4xl flex flex-col justify-between bg-invert p-6 text-invert-ink">
				<p class="text-sm font-bold uppercase tracking-wide opacity-60">A year of menus</p>
				<p class="mt-3 text-5xl font-extrabold leading-none">{PLAN.annual.aed}</p>
				<p class="mt-1 text-lg font-bold">AED</p>
				<p class="mt-3 text-sm opacity-70">Unlimited changes. No commission.</p>
			</div>

			<div
				class="rounded-4xl overflow-hidden border border-line bg-card p-4 transition-transform duration-300 hover:-translate-y-1"
			>
				<Image
					src={itemDetail}
					alt="An item on an Astro-Menu menu showing a photo, calories and macros"
					widths={[280, 560]}
					sizes="(max-width: 1024px) 45vw, 280px"
					loading="eager"
					class="h-48 w-full rounded-3xl object-cover object-top shadow-xl"
				/>
			</div>

			<div class="rounded-4xl col-span-2 flex items-center gap-5 bg-brand p-6 text-white">
				<Image
					src={filterSheet}
					alt="Diners filtering an Astro-Menu menu by meal type"
					widths={[120, 240]}
					sizes="120px"
					loading="lazy"
					class="h-28 w-24 flex-none rounded-2xl object-cover object-bottom shadow-lg"
				/>
				<div>
					<p class="text-xl font-extrabold leading-tight">Guests filter it themselves</p>
					<p class="mt-1 text-sm text-white/85">
						Vegan, gluten-free, hot, cold, light — they narrow the menu instead of scrolling past it.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- NB: prices are rendered statically on purpose. An animated count-up shows a
     wrong number while it runs, and 0 when JavaScript does not execute. -->
