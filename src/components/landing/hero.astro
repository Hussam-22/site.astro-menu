---
import { Image } from 'astro:assets'
import Button from '@components/ui/button.astro'
import { SITE, PLAN } from '@config/site'
import menuSections from 'assets/screens/menu-sections.png'
import itemDetail from 'assets/screens/item-detail.png'
import filterSheet from 'assets/screens/filter-meal-type.png'

const pills = [
	{ label: 'Photo on every dish', tone: 'bg-mint' },
	{ label: 'Arabic + English', tone: 'bg-lilac' },
	{ label: 'Calories & macros', tone: 'bg-butter' },
	{ label: 'No commission', tone: 'bg-blush' }
]
---

<section class="pt-10 md:pt-16">
	<div class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
		<!-- Copy -->
		<div class="intersect-once intersect:animate-fade-right">
			<p
				class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-card px-4 py-2 text-sm font-bold"
			>
				<span class="relative flex h-2 w-2">
					<span
						class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand opacity-75"
					></span>
					<span class="relative inline-flex h-2 w-2 rounded-full bg-brand"></span>
				</span>
				One plan · {PLAN.monthly.aed} AED a month
			</p>

			<h1 class="text-display-sm font-extrabold text-ink md:text-display lg:text-display-lg">
				Your menu.<br />On every phone<span class="text-brand">.</span>
			</h1>

			<p class="mt-7 max-w-lg text-lg leading-relaxed text-muted md:text-xl">
				Turn your food menu into a fast, beautiful mobile page with its own QR code. Change a price
				and it is live in seconds — no reprinting, no app, no commission.
			</p>

			<div class="mt-9 flex flex-col gap-3 sm:flex-row">
				<Button href={SITE.signupUrl} variant="brand" size="lg">Start free for 30 days</Button>
				<Button href={SITE.demoMenuUrl} variant="surface" size="lg" target="_blank" rel="noopener">
					See a live menu →
				</Button>
			</div>

			<div class="mt-8 flex flex-wrap items-center gap-2">
				{
					pills.map((pill) => (
						<span
							class:list={[
								'pastel rounded-full px-4 py-2 text-sm font-bold',
								pill.tone
							]}
						>
							{pill.label}
						</span>
					))
				}
			</div>
		</div>

		<!-- Bento -->
		<div class="intersect-once grid grid-cols-2 gap-4 intersect:animate-fade-left sm:gap-5">
			<div
				class="rounded-4xl group col-span-1 row-span-2 overflow-hidden bg-mint p-4 transition-transform duration-300 hover:-translate-y-1"
			>
				<Image
					src={menuSections}
					alt="A live Astro-Menu menu with sections, photos and prices"
					widths={[320, 640]}
					sizes="(max-width: 1024px) 45vw, 320px"
					loading="eager"
					class="h-full w-full rounded-3xl object-cover object-top shadow-xl"
				/>
			</div>

			<div class="rounded-4xl bg-lilac pastel flex flex-col justify-between p-6">
				<p class="text-sm font-bold uppercase tracking-wide opacity-70">A year of menus</p>
				<p class="mt-3 text-5xl font-extrabold leading-none" data-countup data-to={PLAN.annual.aed}>
					0
				</p>
				<p class="mt-1 text-lg font-bold">AED</p>
				<p class="mt-3 text-sm opacity-80">Unlimited changes. No commission.</p>
			</div>

			<div
				class="rounded-4xl group overflow-hidden bg-butter p-4 transition-transform duration-300 hover:-translate-y-1"
			>
				<Image
					src={itemDetail}
					alt="An item on an Astro-Menu menu showing a photo, calories and macros"
					widths={[280, 560]}
					sizes="(max-width: 1024px) 45vw, 280px"
					loading="eager"
					class="h-48 w-full rounded-3xl object-cover object-top shadow-xl"
				/>
			</div>

			<div class="rounded-4xl bg-blush pastel col-span-2 flex items-center gap-5 p-6">
				<Image
					src={filterSheet}
					alt="Diners filtering an Astro-Menu menu by meal type"
					widths={[120, 240]}
					sizes="120px"
					loading="lazy"
					class="h-28 w-24 flex-none rounded-2xl object-cover object-bottom shadow-lg"
				/>
				<div>
					<p class="text-xl font-extrabold leading-tight">Guests filter it themselves</p>
					<p class="mt-1 text-sm opacity-80">
						Vegan, gluten-free, hot, cold, light — they narrow the menu instead of scrolling past it.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	// Count-up for the bento stat, once it scrolls into view.
	const els = document.querySelectorAll<HTMLElement>('[data-countup]')
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

	els.forEach((el) => {
		const to = Number(el.dataset.to || 0)
		if (reduce) {
			el.textContent = String(to)
			return
		}
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return
					io.disconnect()
					const start = performance.now()
					const tick = (now: number) => {
						const p = Math.min((now - start) / 1100, 1)
						const eased = 1 - Math.pow(1 - p, 3)
						el.textContent = String(Math.round(to * eased))
						if (p < 1) requestAnimationFrame(tick)
					}
					requestAnimationFrame(tick)
				})
			},
			{ threshold: 0.4 }
		)
		io.observe(el)
	})
</script>
