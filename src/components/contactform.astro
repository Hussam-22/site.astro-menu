---
import Button from './ui/button.astro'
import { SITE } from '@config/site'

const field =
	'w-full rounded-2xl border-2 border-line px-4 py-3 outline-none ring-accent/20 placeholder:text-muted focus:border-zinc-900 focus:ring-4'
---

<form action="https://api.web3forms.com/submit" method="POST" id="form" novalidate>
	<input type="hidden" name="access_key" value={SITE.web3formsKey} />
	<input type="checkbox" class="hidden" style="display:none" name="botcheck" tabindex="-1" />

	<div class="mb-4">
		<label for="name" class="sr-only">Your name</label>
		<input id="name" type="text" name="name" placeholder="Your name" required class={field} />
		<div class="empty-feedback invalid-feedback mt-1 text-sm text-red-500">
			Please tell us your name.
		</div>
	</div>

	<div class="mb-4">
		<label for="venue" class="sr-only">Restaurant or café name</label>
		<input
			id="venue"
			type="text"
			name="venue"
			placeholder="Restaurant or café name"
			class={field}
		/>
	</div>

	<div class="mb-4">
		<label for="email" class="sr-only">Email address</label>
		<input
			id="email"
			type="email"
			name="email"
			placeholder="Email address"
			required
			class={field}
		/>
		<div class="empty-feedback mt-1 text-sm text-red-500">Please give us an email address.</div>
		<div class="invalid-feedback mt-1 text-sm text-red-500">
			That does not look like a valid email address.
		</div>
	</div>

	<div class="mb-4">
		<label for="phone" class="sr-only">Phone or WhatsApp number</label>
		<input
			id="phone"
			type="tel"
			name="phone"
			placeholder="Phone or WhatsApp (optional)"
			class={field}
		/>
	</div>

	<div class="mb-4">
		<label for="message" class="sr-only">Your message</label>
		<textarea
			id="message"
			name="message"
			required
			placeholder="What would you like to know?"
			class={`h-36 ${field}`}></textarea>
		<div class="empty-feedback invalid-feedback mt-1 text-sm text-red-500">
			Please write us a message.
		</div>
	</div>

	<Button type="submit" size="lg" block>Send message</Button>
	<div id="result" class="mt-3 text-center text-sm" role="status" aria-live="polite"></div>
</form>

<style>
	.invalid-feedback,
	.empty-feedback {
		display: none;
	}
	.was-validated :placeholder-shown:invalid ~ .empty-feedback {
		display: block;
	}
	.was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
		display: block;
	}
	.was-validated :invalid {
		border-color: #ef4444;
	}
</style>

<script>
	const form = document.getElementById('form') as HTMLFormElement | null
	const result = document.getElementById('result')

	form?.addEventListener('submit', async (e) => {
		e.preventDefault()
		form.classList.add('was-validated')
		if (!form.checkValidity()) {
			form.querySelector<HTMLElement>(':invalid')?.focus()
			return
		}

		if (!result) return
		result.className = 'mt-3 text-center text-sm text-muted'
		result.textContent = 'Sending…'

		try {
			const response = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
				body: JSON.stringify(Object.fromEntries(new FormData(form)))
			})
			const json = await response.json()
			result.className = `mt-3 text-center text-sm ${response.ok ? 'text-green-600' : 'text-red-500'}`
			result.textContent = json.message
			if (response.ok) {
				form.reset()
				form.classList.remove('was-validated')
			}
		} catch {
			result.className = 'mt-3 text-center text-sm text-red-500'
			result.textContent = 'Something went wrong. Please email us instead.'
		}
	})
</script>
