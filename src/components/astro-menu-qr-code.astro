---
import astroQr from "assets/astro-menu-qr.svg";
import { Image } from "astro:assets";
import Container from "./container.astro";
---

<Container>
  <div
    class="flex flex-row items-center justify-center gap-8 bg-base-200 rounded-4xl p-6"
  >
    <h2 class="text-7xl font-black max-w-6/12">Live Demo Menu</h2>
    <div class="flex flex-col items-center justify-center gap-2">
      <Image
        src={astroQr}
        alt="QR code for Astro-Menu"
        class="rounded-lg"
        loading="lazy"
        width={200}
        height={100}
      />
      <a
        href="https://menu.astro-menu.com/qr-menu/?businessProfileID=V1iYvft42Rd19Gx2swCo&branchID=2EKctRFUaA06pGIvAT2D&tableID=upxdTRj5NaTRl68f6ly0"
        class="font-semibold underline"
        target="_blank">Visit the Link</a
      >
    </div>
  </div>
</Container>
