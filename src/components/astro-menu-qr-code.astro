---
import { Image } from 'astro:assets'
import astroQr from 'assets/astro-menu-qr.svg'
---

<div
	class="rounded-xxl mt-8 flex flex-col items-center justify-center gap-8 bg-[url('/assets/backgrounds/bg-blur-multi.svg')] bg-cover bg-center bg-no-repeat pt-4 text-center sm:flex-row"
>
	<div class="text-white">
		<p class="text-xl">Need a sneak-peak ?</p>
		<h2 class="px-4 text-4xl font-bold sm:text-5xl sm:tracking-tight">
			Scan QR Code for live Demo Menu
		</h2>
	</div>
	<div class="py-4">
		<Image
			src={astroQr}
			alt="QR code for astro menu"
			class="rounded-lg border-4 border-black"
			loading="lazy"
			width={200}
			height={100}
		/>
		<a
			href="https://admin-qr-menu.netlify.app/qr-menu/sZ8cqIq1ceNOPDAwDB18/MshogdkMdPPvzXCheljs/q5hmh0r4Zdyu8lu8gA1k"
			class="text-white underline sm:invisible"
			target="_blank">Or click here</a
		>
	</div>
</div>
