---
import astroQr from 'assets/astro-menu-qr.svg'
import { Image } from 'astro:assets'

const { footer = false } = Astro.props
---

<div
	class:list={[
		"rounded-xxl flex items-center justify-center bg-[url('/assets/backgrounds/bg-blur-multi.svg')] bg-cover bg-center bg-no-repeat  text-center ",
		footer ? 'flex-col' : 'mt-8 flex-col gap-8 pt-4 sm:flex-row'
	]}
>
	<div class="text-white">
		{!footer && <p class="text-xl">Need a sneak-peak ?</p>}
		<h2
			class:list={[
				'px-4  font-bold ',
				footer ? 'text-2xl sm:text-xl' : 'text-4xl sm:text-5xl sm:tracking-tight'
			]}
		>
			Scan QR Code for live Demo Menu
		</h2>
	</div>
	<div class="py-4">
		<Image
			src={astroQr}
			alt="QR code for Astro-Menu"
			class="mb-4 rounded-lg"
			loading="lazy"
			width={200}
			height={100}
		/>
		<a
			href="https://menu.astro-menu.com/qr-menu/?businessProfileID=V1iYvft42Rd19Gx2swCo&branchID=2EKctRFUaA06pGIvAT2D&tableID=upxdTRj5NaTRl68f6ly0"
			class="text-white underline"
			target="_blank">View Astro Menu Demo</a
		>
	</div>
</div>
