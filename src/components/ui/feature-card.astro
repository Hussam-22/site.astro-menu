---
import { Image } from 'astro:assets'
import Button from './button.astro'
import Link from './link.astro'

const {
	className,
	title,
	description,
	bgSVG,
	btnText,
	btnLink,
	imgSrc = '',
	height = 500,
	icon
} = Astro.props
---

<div
	class:list={[`rounded-xxl relative min-h-[${height}px] w-full p-12`, className]}
	style={`background-image: url('${imgSrc}'); background-size: 80% 80%; background-repeat: no-repeat; background-position: 200% 200%`}
>
	{icon && <Image src={icon} class="-ml-4 mb-1 h-32 w-32" alt={title} />}
	<h2 class="text-2xl font-extrabold capitalize text-black lg:text-5xl lg:tracking-tight">
		{title}
	</h2>
	<p class="mt-4 text-xl text-black">
		{description}
	</p>
	{
		btnText && btnLink && (
			<Link styles="primary" href={btnLink} class="mt-4 self-start bg-cyan-400">
				{btnText}
			</Link>
		)
	}
	{bgSVG}
</div>
