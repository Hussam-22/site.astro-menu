---
import { Image } from 'astro:assets'
import Button from './button.astro'
import Link from './link.astro'

const { className, title, description, bgSVG, btnText, btnLink, imgSrc = '', icon } = Astro.props
---

<div
	class:list={[`rounded-xxl relative w-full p-8 sm:p-12`, className]}
	style={`background-image: url('${imgSrc}'); background-size: 80% 80%; background-repeat: no-repeat; background-position: 200% 200%`}
>
	{icon && <Image src={icon} class="-ml-4 mb-1 h-32 w-32" alt={title} />}
	<h2 class="text-3xl font-extrabold capitalize text-black lg:text-5xl lg:tracking-tight">
		{title}
	</h2>
	<p class:list={['mt-2 text-xl text-black', btnText && btnLink ? 'mb-6' : 'mb-0']}>
		{description}
	</p>
	{
		btnText && btnLink && (
			<Link styles="primary" href={btnLink} class="self-start bg-cyan-400">
				{btnText}
			</Link>
		)
	}
	{bgSVG}
</div>
