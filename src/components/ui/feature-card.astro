---
import { Image } from "astro:assets";

const { title, description, btnText, btnLink, imgSrc = "", icon } = Astro.props;
console.log(imgSrc);
---

<div
  class:list={[
    `rounded-4xl min-h-[250px] p-4 sm:p-6 bg-base-200 flex flex-col gap-2`,
  ]}
>
  {icon && <Image src={icon} class="h-16 w-16" alt={title} />}
  <h2
    class="text-3xl font-extrabold capitalize text-black lg:text-5xl lg:tracking-tight"
  >
    {title}
  </h2>
  <p
    class:list={[
      "text-xl font-semibold text-black",
      btnText && btnLink ? "mb-6" : "mb-0",
    ]}
  >
    {description}
  </p>
</div>
