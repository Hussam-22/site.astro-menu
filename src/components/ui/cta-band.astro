---
import Button from '@components/ui/button.astro'
import { SITE, PLAN } from '@config/site'

interface Props {
	title?: string
	body?: string
}

const {
	title = 'Put your menu on every phone this week',
	body = `One plan, ${PLAN.monthly.aed} AED a month. ${PLAN.trialDays} days free, no card needed, no commission ever.`
} = Astro.props
---

<section class="py-16 md:py-24">
	<div
		class="rounded-xxl intersect-once bg-brand px-8 py-16 text-white intersect:animate-fade-up md:px-16 md:py-20"
	>
		<div class="grid items-center gap-10 lg:grid-cols-[1.3fr_1fr]">
			<div>
				<h2 class="text-4xl font-extrabold leading-tight md:text-6xl">{title}</h2>
				<p class="mt-5 max-w-xl text-lg text-white/90 md:text-xl">{body}</p>
			</div>
			<div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-stretch">
				<Button href={SITE.signupUrl} variant="onBrand" size="lg">Start free for 30 days</Button>
				<Button href="/contact" variant="onBrandOutline" size="lg">Talk to us</Button>
			</div>
		</div>
	</div>
</section>
