---
import Button from '@components/ui/button.astro'
import { SITE, PLAN } from '@config/site'

interface Props {
	title?: string
	body?: string
}

const {
	title = 'Put your menu on every phone this week',
	body = `One plan, ${PLAN.monthly.aed} AED a month. ${PLAN.trialDays} days free, no card needed, no commission ever.`
} = Astro.props
---

<section class="py-16 md:py-24">
	<div
		class="rounded-xxl intersect-once relative overflow-hidden bg-brand px-8 py-16 text-center text-white intersect:animate-fade-up md:px-16 md:py-20"
	>
		<div
			class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white/10"
			aria-hidden="true"
		>
		</div>
		<div
			class="pointer-events-none absolute -bottom-24 -left-10 h-72 w-72 rounded-full bg-white/10"
			aria-hidden="true"
		>
		</div>

		<div class="relative">
			<h2 class="text-4xl font-extrabold leading-tight md:text-6xl">{title}</h2>
			<p class="mx-auto mt-5 max-w-2xl text-lg text-white/90 md:text-xl">{body}</p>
			<div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<Button href={SITE.signupUrl} variant="onBrand" size="lg">Start free for 30 days</Button>
				<Button href="/contact" variant="onBrandOutline" size="lg">Talk to us</Button>
			</div>
		</div>
	</div>
</section>
