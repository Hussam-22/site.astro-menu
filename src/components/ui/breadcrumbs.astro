---
interface Props {
	items: { name: string; path: string }[]
}

const { items } = Astro.props
---

<nav aria-label="Breadcrumb" class="pt-8">
	<ol class="flex flex-wrap items-center gap-2 text-sm text-muted">
		{
			items.map((item, i) => (
				<li class="flex items-center gap-2">
					{i > 0 && <span aria-hidden="true">/</span>}
					{i === items.length - 1 ? (
						<span class="text-ink">{item.name}</span>
					) : (
						<a
						href={item.path}
						class="inline-flex min-h-11 items-center hover:text-ink hover:underline"
					>
							{item.name}
						</a>
					)}
				</li>
			))
		}
	</ol>
</nav>
