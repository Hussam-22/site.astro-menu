---
interface Props {
	href?: string
	size?: 'sm' | 'md' | 'lg' | 'xl'
	block?: boolean
	variant?: 'brand' | 'primary' | 'surface' | 'outline' | 'onBrand' | 'onBrandOutline'
	class?: string
	[x: string]: any
}

const { href, size = 'md', variant = 'brand', block, class: className, ...rest } = Astro.props

const sizes = {
	sm: 'px-4 py-2 text-sm',
	md: 'px-6 py-3 text-base',
	lg: 'px-8 py-4 text-lg',
	xl: 'px-10 py-5 text-xl'
}

// One brand tone, always with white text on it.
const variants = {
	brand: 'bg-brand text-white hover:brightness-95 shadow-lg shadow-brand/25',
	primary: 'bg-invert text-invert-ink hover:opacity-90',
	surface: 'bg-page text-ink border-2 border-line hover:border-ink',
	outline: 'border-2 border-current bg-transparent hover:bg-ink/5',
	onBrand: 'bg-white text-brand hover:bg-white/90',
	onBrandOutline: 'border-2 border-white/70 bg-transparent text-white hover:bg-white/15'
}

const classes = [
	'inline-flex items-center justify-center gap-2 rounded-full font-bold transition-all duration-200 hover:-translate-y-0.5 ring-offset-2 ring-offset-page focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand',
	block && 'w-full',
	sizes[size],
	variants[variant],
	className
]

const Tag = href ? 'a' : 'button'
---

<Tag href={href} class:list={classes} {...rest}><slot /></Tag>
