---
interface Props {
	href?: string
	size?: 'sm' | 'md' | 'lg' | 'xl'
	block?: boolean
	variant?: 'brand' | 'primary' | 'surface' | 'outline' | 'onBrand' | 'onBrandOutline'
	class?: string
	[x: string]: any
}

const { href, size = 'md', variant = 'brand', block, class: className, ...rest } = Astro.props

// min-h-11 keeps every button at the 44px minimum touch target.
const sizes = {
	sm: 'min-h-11 px-5 py-2 text-sm',
	md: 'min-h-11 px-6 py-3 text-base',
	lg: 'min-h-12 px-8 py-4 text-lg',
	xl: 'min-h-14 px-10 py-5 text-xl'
}

// Anything sitting on the brand fill uses brandOn, never white — see theme.css
// for why the fill cannot carry white text. onBrand is a white chip on that
// fill, so it needs the fixed deep tone rather than the theme-varying ink one.
const variants = {
	brand: 'bg-brand text-brandOn hover:brightness-95 shadow-lg shadow-brand/25',
	primary: 'bg-invert text-invert-ink hover:opacity-90',
	surface: 'bg-page text-ink border-2 border-line hover:border-ink',
	outline: 'border-2 border-current bg-transparent hover:bg-ink/5',
	// Fixed white, not bg-page: this chip sits on the brand fill, which does not
	// flip between themes, so the chip must not flip either.
	onBrand: 'bg-white text-brandDeep hover:bg-white/90',
	onBrandOutline: 'border-2 border-brandOn/60 bg-transparent text-brandOn hover:bg-brandOn/10'
}

const classes = [
	'inline-flex items-center justify-center gap-2 rounded-full font-bold transition-all duration-200 hover:-translate-y-0.5 ring-offset-2 ring-offset-page focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand',
	block && 'w-full',
	sizes[size],
	variants[variant],
	className
]

const Tag = href ? 'a' : 'button'
---

<Tag href={href} class:list={classes} {...rest}><slot /></Tag>
