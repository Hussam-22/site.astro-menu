---
import Button from './Button.astro'
import { SITE, PRICE } from '../../config/site'
import { getLangFromUrl, localizePath } from '../../i18n/ui'

interface Props {
	title?: string
	body?: string
	/** Second, quieter action. Defaults to the live demo menu. */
	secondaryHref?: string
	secondaryLabel?: string
}

const lang = getLangFromUrl(Astro.url)
const isAr = lang === 'ar'

const {
	title = isAr
		? 'حط منيوك على كل موبايل يدخل من الباب'
		: 'Put your menu on every phone that walks in',
	body = isAr
		? `ابعتلنا المنيو اللي عندك هلق ونحن منبني النسخة الأولى بدالك. ${PRICE.trialDays} يومًا مجانًا، بلا بطاقة، وألغِ من لوحة التحكم وقتما بدك.`
		: `Send us the menu you have now and we will build the first version for you. ${PRICE.trialDays} days free, no card, cancel from the dashboard.`,
	secondaryHref = localizePath('/demo', lang),
	secondaryLabel = isAr ? 'شاهد منيو حقيقية' : 'See a real menu'
} = Astro.props
---

<section class="px-5 py-16 lg:px-8 lg:py-20">
	<div class="bg-ink border-ink relative mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] border-[3px] px-6 py-20 shadow-[8px_8px_0_var(--color-brand)] lg:px-16">
		<div
			class="brand-gradient pointer-events-none absolute -top-24 -right-24 h-80 w-80 rounded-full opacity-25 blur-3xl"
			aria-hidden="true"
		>
		</div>
		<div class="relative mx-auto max-w-3xl text-center">
			<h2 class="text-5xl text-balance text-white sm:text-6xl lg:text-7xl">
				{title}
			</h2>
			<p class="mt-5 text-xl text-pretty text-white/70 sm:text-2xl">{body}</p>
			<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
				<Button href={SITE.signupUrl} size="lg">
					{isAr ? 'ابدأ فترتك التجريبية المجانية' : 'Start your free trial'}
				</Button>
				<Button href={secondaryHref} variant="light" size="lg">{secondaryLabel}</Button>
			</div>
			<p class="mt-6 text-base text-white/50">
				{PRICE.monthly} a month after the trial · {PRICE.monthlyAed} · Cancel any time
			</p>
		</div>
	</div>
</section>
