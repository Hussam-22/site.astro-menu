---
interface Props {
	title?: string
	eyebrow?: string
	lede?: string
	level?: 1 | 2
	class?: string
	id?: string
}

const { title, eyebrow, lede, level = 2, class: className, id } = Astro.props
const Heading = level === 1 ? 'h1' : 'h2'
---

<section id={id} class:list={['py-16 md:py-24', className]}>
	{
		(eyebrow || title || lede) && (
			<div class="intersect-once mx-auto max-w-3xl text-center intersect:animate-fade-up">
				{eyebrow && (
					<p class="mb-3 text-sm font-bold uppercase tracking-widest text-brand">{eyebrow}</p>
				)}
				{title && (
					<Heading class="text-3xl font-extrabold text-ink md:text-5xl md:leading-tight">
						{title}
					</Heading>
				)}
				{lede && <p class="mt-5 text-lg text-muted">{lede}</p>}
			</div>
		)
	}
	<slot />
</section>
