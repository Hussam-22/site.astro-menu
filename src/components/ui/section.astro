---
interface Props {
	title?: string
	eyebrow?: string
	lede?: string
	level?: 1 | 2
	align?: 'left' | 'center'
	class?: string
	id?: string
}

const {
	title,
	eyebrow,
	lede,
	level = 2,
	align = 'left',
	class: className,
	id
} = Astro.props
const Heading = level === 1 ? 'h1' : 'h2'
const centered = align === 'center'
---

<section id={id} class:list={['py-16 md:py-24', className]}>
	{
		(eyebrow || title || lede) && (
			<div
				class:list={[
					'intersect-once max-w-3xl intersect:animate-fade-up',
					centered && 'mx-auto text-center'
				]}
			>
				{eyebrow && (
					<p class="mb-4 text-sm font-extrabold uppercase tracking-widest text-brand">{eyebrow}</p>
				)}
				{title && (
					<Heading class="text-4xl font-extrabold leading-[1.05] tracking-tight text-ink md:text-5xl lg:text-6xl">
						{title}
					</Heading>
				)}
				{lede && <p class="mt-6 text-lg leading-relaxed text-muted md:text-xl">{lede}</p>}
			</div>
		)
	}
	<slot />
</section>
