---
interface Props {
	href: string
	/**
	 * primary — the live site's orange→rose gradient pill, on a hard offset
	 *           shadow. One per screenful.
	 * dark    — solid ink pill, for the second action beside a primary.
	 * outline — hairline pill on paper.
	 * light   — for use on the ink band, where an ink outline would vanish.
	 * ghost   — text plus arrow, no chrome.
	 */
	variant?: 'primary' | 'dark' | 'outline' | 'light' | 'ghost'
	size?: 'sm' | 'md' | 'lg'
	external?: boolean
	class?: string
	block?: boolean
}

const {
	href,
	variant = 'primary',
	size = 'md',
	external = false,
	block = false,
	class: extra = ''
} = Astro.props

const base =
	'group inline-flex items-center justify-center gap-2 rounded-full font-bold transition-all duration-200'

const sizes = {
	sm: 'px-5 py-2.5 text-base',
	md: 'px-7 py-3.5 text-lg',
	lg: 'px-9 py-4 text-xl'
}

const variants = {
	primary:
		'brand-gradient text-white border-[2.5px] border-ink shadow-[4px_4px_0_var(--color-ink)] hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[7px_7px_0_var(--color-ink)]',
	dark: 'bg-ink text-white border-[2.5px] border-ink hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[5px_5px_0_var(--color-brand)]',
	outline:
		'bg-card text-ink border-[2.5px] border-ink hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-[5px_5px_0_var(--color-ink)]',
	light: 'bg-transparent text-white border-[2.5px] border-white hover:bg-white/10',
	ghost: 'text-brand-text px-0 hover:gap-3.5'
}

const cls = [base, sizes[size], variants[variant], block ? 'w-full' : '', extra]
	.filter(Boolean)
	.join(' ')

const rel = external ? 'noopener noreferrer' : undefined
const target = external ? '_blank' : undefined
---

<a href={href} class={cls} rel={rel} target={target}>
	<slot />
	{
		variant === 'ghost' && (
			<svg
				class="h-4 w-4"
				viewBox="0 0 16 16"
				fill="none"
				aria-hidden="true"
				stroke="currentColor"
				stroke-width="2.4"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M3 8h10M9 4l4 4-4 4" />
			</svg>
		)
	}
</a>
