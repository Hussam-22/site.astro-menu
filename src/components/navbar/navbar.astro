---
import Container from '@components/container.astro'
import Button from '@components/ui/button.astro'
import ThemeToggle from '@components/ui/theme-toggle.astro'
import { Astronav, MenuItems, MenuIcon } from 'astro-navbar'
import { SITE, NAV } from '@config/site'

const path = Astro.url.pathname
---

<header class="sticky top-0 z-50 border-b border-line bg-page/90 backdrop-blur">
	<Container>
		<Astronav>
			<div class="flex w-full flex-col items-center justify-between py-3 sm:flex-row">
				<div class="flex w-full flex-row items-center justify-between sm:w-auto">
					<a
						href="/"
						class="inline-flex min-h-11 items-center text-lg text-ink"
						aria-label={`${SITE.name} home`}
					>
						<span class="font-extrabold">Astro</span><span class="text-brandInk">-Menu</span>
					</a>
					<div class="flex items-center gap-2 sm:hidden">
						<ThemeToggle />
						<MenuIcon class="h-11 w-11 rounded-full border border-line p-3 text-ink" />
					</div>
				</div>

				<MenuItems class="hidden w-full flex-row items-center justify-end sm:flex sm:w-auto">
					<ul class="mt-3 flex flex-col gap-1 sm:mt-0 sm:flex-row sm:gap-1">
						{
							NAV.map((item) => (
								<li>
									<a
										href={item.path}
										aria-current={path.startsWith(item.path) ? 'page' : undefined}
										class:list={[
											'flex min-h-11 items-center rounded-full px-3 text-sm font-medium transition hover:bg-line',
											path.startsWith(item.path) ? 'text-ink' : 'text-muted hover:text-ink'
										]}
									>
										{item.title}
									</a>
								</li>
							))
						}
					</ul>
					<div class="mt-3 flex w-full flex-col gap-2 sm:mt-0 sm:w-auto sm:flex-row sm:items-center sm:pl-4">
						<a
							href={SITE.loginUrl}
							class="inline-flex min-h-11 items-center justify-center rounded-full px-3 text-center text-sm font-medium text-muted transition hover:text-ink"
						>
							Log in
						</a>
						<Button href={SITE.signupUrl} variant="primary" size="sm">Get started</Button>
						<div class="hidden sm:block">
							<ThemeToggle />
						</div>
					</div>
				</MenuItems>
			</div>
		</Astronav>
	</Container>
</header>
