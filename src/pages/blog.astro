---
import { getCollection } from 'astro:content'
import Layout from '@layouts/Layout.astro'
import Container from '@components/container.astro'
import Section from '@components/ui/section.astro'
import Breadcrumbs from '@components/ui/breadcrumbs.astro'
import CtaBand from '@components/ui/cta-band.astro'
import { getFormattedDate } from '@utils/all'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }]
---

<Layout
	title="Blog — Practical Advice on Menus"
	description="Guides on QR menus, menu pricing, menu photography and menu SEO for restaurants, cafés and food trucks in the UAE."
	breadcrumbs={crumbs}
>
	<Container>
		<Breadcrumbs items={crumbs} />

		<Section
			level={1}
			eyebrow="Blog"
			title="Practical writing about menus"
			lede="No listicles about why your restaurant needs to go digital. Just specific, useful things we have learned about getting menus right."
		>
			<ul class="mx-auto mt-12 max-w-3xl space-y-4">
				{
					posts.map((post) => (
						<li>
							<a
								href={`/blog/${post.slug}`}
								class="rounded-xxl group block bg-card p-8 transition hover:bg-line"
							>
								<span class="text-sm font-bold uppercase tracking-widest text-brand">
									{post.data.category}
								</span>
								<h2 class="mt-2 text-2xl font-bold text-ink group-hover:text-brand">
									{post.data.title}
								</h2>
								<p class="mt-2 text-muted">{post.data.description}</p>
								<time
									class="mt-4 block text-sm text-muted"
									datetime={post.data.publishDate.toISOString()}
								>
									{getFormattedDate(post.data.publishDate)}
								</time>
							</a>
						</li>
					))
				}
			</ul>
		</Section>

		<CtaBand />
	</Container>
</Layout>
