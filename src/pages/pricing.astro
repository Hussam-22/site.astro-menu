---
import Layout from '../layouts/Layout.astro'
import Section from '../components/ui/Section.astro'
import SectionHead from '../components/ui/SectionHead.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import PricingCard from '../components/PricingCard.astro'
import Cross from '../components/ui/Cross.astro'
import Check from '../components/ui/Check.astro'
import FaqList from '../components/ui/FaqList.astro'
import CtaBand from '../components/ui/CtaBand.astro'
import Sticker from '../components/ui/Sticker.astro'
import { SITE, PRICE, PLAN } from '../config/site'
import { NOT_INCLUDED } from '../data/plan'
import { FAQ_GROUPS } from '../data/faqs'
import { crumbSchema, faqSchema } from '../utils/schema'

const pricingFaqs = FAQ_GROUPS.find((g) => g.heading === 'Pricing')!.items

const title = `Pricing — ${PRICE.monthly} a month, one plan`
const description = `${PRICE.monthly} a month, or ${PRICE.annualPerMonth} a month billed yearly (${PRICE.annualTotal}). Unlimited menus, items and views. No setup fee, no commission, no contract.`

const product = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: 'Astro-Menu',
	description: SITE.description,
	brand: { '@type': 'Brand', name: 'Astro-Menu' },
	offers: [
		{
			'@type': 'Offer',
			name: 'Monthly',
			price: String(PRICE.monthlyAmount),
			priceCurrency: 'USD',
			url: `${SITE.domain}/pricing`,
			availability: 'https://schema.org/InStock'
		},
		{
			'@type': 'Offer',
			name: 'Yearly',
			price: String(PRICE.annualTotalAmount),
			priceCurrency: 'USD',
			url: `${SITE.domain}/pricing`,
			availability: 'https://schema.org/InStock'
		}
	]
}

/**
 * The honest cost comparison. Print figures are a stated assumption, not a
 * claim about any particular venue — the point is the shape of the spend, and
 * the arithmetic is shown so a reader can substitute their own numbers.
 */
const PRINT_RUNS_PER_YEAR = 3
const PRINT_COST_PER_RUN = 90
const printYear = PRINT_RUNS_PER_YEAR * PRINT_COST_PER_RUN
---

<Layout
	title={title}
	description={description}
	path="/pricing"
	schema={[crumbSchema([{ name: 'Pricing', path: '/pricing' }]), product, faqSchema(pricingFaqs)]}
>
	<Section tight>
		<Breadcrumbs trail={[{ name: 'Pricing' }]} />
		<div class="mt-8">
			<SectionHead
				as="h1"
				align="center"
				eyebrow="Pricing"
				title="One plan.<br />Everything in it."
				lede="Every competitor in this market makes you request a quote. Here is the number, and here is exactly what it does and does not buy."
			/>
		</div>
		<div class="mt-6 flex flex-wrap justify-center gap-2.5">
			<Sticker tone="orange">No setup fee</Sticker>
			<Sticker tone="rose">No contract</Sticker>
			<Sticker>No hardware</Sticker>
			<Sticker tone="go">No commission</Sticker>
		</div>
		<div class="mt-12">
			<PricingCard id="plan" as="h2" />
		</div>
	</Section>

	<Section tone="card" ruled>
		<SectionHead
			align="center"
			eyebrow="The other half of the truth"
			title="What is deliberately left out"
			lede="This is the part competitors bury in a feature matrix. Saying it plainly is what makes one flat price believable."
		/>
		<div class="mx-auto mt-12 grid max-w-4xl gap-5 sm:grid-cols-2">
			{
				NOT_INCLUDED.map((n) => (
					<div class="bg-paper slab rounded-2xl p-7">
						<p class="flex items-start gap-3 text-xl font-bold">
							<Cross class="mt-1.5 text-[#c33]" />
							<span>{n.label}</span>
						</p>
						<p class="text-ink-soft mt-3 pl-8 text-lg text-pretty">{n.reason}</p>
					</div>
				))
			}
		</div>
		<p class="text-ink-soft mx-auto mt-10 max-w-2xl text-center text-lg text-pretty">
			If you need a till, an ordering flow or payments, Astro-Menu is the wrong product and we would
			rather tell you now than after you have paid.
		</p>
	</Section>

	<Section>
		<div class="grid items-start gap-14 lg:grid-cols-2">
			<div>
				<SectionHead
					eyebrow="Against what you already spend"
					title="Compare it to the<br />print bill, not to software"
					lede="Most venues are not choosing between two apps. They are choosing between a subscription and a printer's invoice."
				/>
				<p class="text-ink-soft mt-6 text-lg text-pretty">
					A venue that reprints its menu {PRINT_RUNS_PER_YEAR} times a year at around ${PRINT_COST_PER_RUN}
					a run spends about ${printYear} on print alone — before anyone counts the evening a manager
					lost to proofreading, or the month a wrong price stayed on the table because reprinting was
					not worth it.
				</p>
				<p class="text-ink-soft mt-4 text-lg text-pretty">
					Those figures are an illustration, not a quote. Put your own numbers in — the shape rarely
					changes.
				</p>
			</div>

			<div class="bg-card slab-lg rounded-[1.5rem] p-8">
				<dl class="tabular divide-line divide-y">
					<div class="flex items-baseline justify-between gap-6 pb-5">
						<dt class="text-lg font-bold">Astro-Menu, billed yearly</dt>
						<dd class="font-display text-3xl">{PRICE.annualTotal}<span class="text-lg">/yr</span></dd>
					</div>
					<div class="flex items-baseline justify-between gap-6 py-5">
						<dt class="text-lg font-bold">Astro-Menu, billed monthly</dt>
						<dd class="font-display text-3xl">
							{PRICE.monthly}<span class="text-lg">/mo</span>
						</dd>
					</div>
					<div class="flex items-baseline justify-between gap-6 py-5">
						<dt class="text-ink-soft text-lg">Illustrative print spend</dt>
						<dd class="font-display text-ink-soft text-3xl">${printYear}<span class="text-lg">/yr</span></dd>
					</div>
					<div class="flex items-baseline justify-between gap-6 pt-5">
						<dt class="text-lg font-bold">Commission we take</dt>
						<dd class="font-display text-go text-3xl">{PRICE.zero}</dd>
					</div>
				</dl>
				<ul class="border-line mt-7 space-y-3 border-t pt-6">
					<li class="flex items-start gap-3 text-lg">
						<Check class="text-go mt-1.5" />
						<span>Reprints after a price change: unlimited, and free</span>
					</li>
					<li class="flex items-start gap-3 text-lg">
						<Check class="text-go mt-1.5" />
						<span>In dirhams: {PRICE.monthlyAed} a month, {PRICE.annualTotalAed} a year</span>
					</li>
				</ul>
			</div>
		</div>
	</Section>

	<Section tone="sunk" ruled>
		<div class="mx-auto max-w-3xl">
			<SectionHead align="center" eyebrow="Pricing questions" title="The money questions" />
			<div class="mt-10">
				<FaqList items={pricingFaqs} openFirst />
			</div>
			<p class="mt-8 text-center text-lg">
				<a href="/faq" class="text-brand-text font-bold hover:underline">
					Every other question →
				</a>
			</p>
		</div>
	</Section>

	<CtaBand
		title={`Try it for ${PLAN.trialDays} days first`}
		body="No card, no setup fee, no contract. If it is not right, walk away and nothing has changed."
		secondaryHref="/demo"
		secondaryLabel="See a real menu"
	/>
</Layout>
