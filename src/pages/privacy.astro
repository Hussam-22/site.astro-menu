---
import Layout from '@layouts/Layout.astro'
import Container from '@components/container.astro'
import Breadcrumbs from '@components/ui/breadcrumbs.astro'
import { SITE } from '@config/site'

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Privacy', path: '/privacy' }]
const updated = 'August 2026'
---

<Layout
	title="Privacy Policy"
	description="What data Astro-Menu collects from restaurant owners and menu viewers, why, how long it is kept, and how to have it removed."
	breadcrumbs={crumbs}
>
	<Container class="md:max-w-screen-md">
		<Breadcrumbs items={crumbs} />

		<article class="py-14">
			<h1 class="text-4xl font-extrabold text-ink md:text-5xl">Privacy Policy</h1>
			<p class="mt-3 text-muted">Last updated: {updated}</p>

			<div
				class="prose dark:prose-invert prose-lg mt-10 max-w-none prose-headings:font-extrabold prose-a:text-brandInk prose-strong:text-ink"
			>
				<h2>The short version</h2>
				<p>
					We collect what we need to give you an account and show you how your menu is performing.
					We do not build profiles of the people who view your menu, and we do not sell data to
					anyone.
				</p>

				<h2>If you are a customer</h2>
				<p>When you create an account we collect:</p>
				<ul>
					<li>Your name, email address and, if you give it, a phone number</li>
					<li>Your venue’s name, location and branding</li>
					<li>The menu content you upload</li>
					<li>Billing details, handled by our payment processor — we do not store card numbers</li>
				</ul>
				<p>
					We use this to run your account, serve your menu, take payment and contact you about the
					service. We will not add you to a marketing list you did not ask for.
				</p>

				<h2>If you are viewing a menu</h2>
				<p>
					Diners do not sign in and we do not ask them for anything. To produce the analytics we
					show restaurant owners, we record aggregate activity: how many times a menu was opened,
					which items were viewed, and roughly when. This is counted at the menu level.
				</p>
				<p>
					We do not ask viewers for a name, an email address or a phone number, and we do not use
					this data to build an advertising profile or to identify individual diners.
				</p>

				<h2>This website</h2>
				<p>
					These marketing pages are static and do not set advertising cookies. If you submit the
					contact form, your message is delivered to us by a third-party form provider so we can
					reply.
				</p>

				<h2>Sharing</h2>
				<p>
					We share data only with the providers needed to operate the service — hosting, payment
					processing and email delivery — and only to the extent required. We do not sell personal
					data.
				</p>

				<h2>Keeping data</h2>
				<p>
					We keep your account data while your subscription is active. After cancellation we retain
					it for a limited period so you can reactivate, then delete it. Records we are legally
					required to keep, such as invoices, are held for the required period.
				</p>

				<h2>Your rights</h2>
				<p>
					You can ask for a copy of your data, ask us to correct it, or ask us to delete it. Email <a
						href={`mailto:${SITE.email}`}>{SITE.email}</a
					> and we will act on it.
				</p>

				<h2>Changes</h2>
				<p>
					If we change this policy in a way that materially affects you, we will let you know by
					email before it takes effect.
				</p>
			</div>
		</article>
	</Container>
</Layout>
