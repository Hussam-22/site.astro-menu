---
import Layout from '../layouts/Layout.astro'
import Section from '../components/ui/Section.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import { SITE } from '../config/site'
import { crumbSchema } from '../utils/schema'

const updated = '18 August 2026'
const title = 'Privacy policy'
const description =
	'What Astro-Menu collects, why, and what we never do with it. No cookies, no analytics, no trackers on this site. Short, because we collect very little.'
---

<Layout
	title={title}
	description={description}
	path="/privacy"
	schema={crumbSchema([{ name: 'Privacy policy', path: '/privacy' }])}
>
	<Section width="narrow" tight>
		<Breadcrumbs trail={[{ name: 'Privacy policy' }]} />
		<h1 class="mt-8 text-5xl sm:text-6xl">Privacy policy</h1>
		<p class="text-ink-faint mt-4 text-base">Last updated {updated}</p>

		<div
			class="prose prose-lg prose-headings:font-display prose-headings:font-normal prose-headings:uppercase prose-h2:mt-10 prose-h2:text-2xl prose-p:text-ink-soft prose-li:text-ink-soft prose-strong:text-ink prose-a:text-brand-text prose-a:font-bold mt-10 max-w-none"
		>
			<h2>The short version</h2>
			<p>
				This website sets no cookies, runs no analytics and no advertising trackers, and embeds
				nothing from third parties. If you only read this site, we learn nothing about you beyond
				what any web server records in order to serve a page.
			</p>

			<h2>What we collect, and when</h2>
			<ul>
				<li>
					<strong>If you email or message us</strong> — your name, email address and whatever you
					write. We use it to reply, and for nothing else.
				</li>
				<li>
					<strong>If you open an account</strong> — the details needed to run your menu and bill
					you. Those are covered by the terms you accept inside the app.
				</li>
				<li>
					<strong>Server logs</strong> — our host records requests, including IP address and browser
					string, to serve pages and defend against abuse. They are kept briefly and are not used to
					build a profile of you.
				</li>
			</ul>

			<h2>Guests who scan a menu</h2>
			<p>
				Diners who scan a venue QR code do not sign in and are not asked for anything. Astro-Menu
				counts menu views and which items were opened, so the venue can see what its menu is doing.
				That counting is not tied to a named person.
			</p>

			<h2>What we never do</h2>
			<ul>
				<li>Sell, rent or share your data with advertisers.</li>
				<li>Send you marketing you did not ask for.</li>
				<li>Track you across other websites.</li>
			</ul>

			<h2>Your rights</h2>
			<p>
				Ask us for a copy of what we hold about you, ask us to correct it, or ask us to delete it.
				Write to <a href={'mailto:' + SITE.email}>{SITE.email}</a> and we will act on it.
			</p>

			<h2>Changes</h2>
			<p>
				If this policy changes materially we will update the date at the top and, where it affects
				account holders, tell them directly.
			</p>

			<h2>Contact</h2>
			<p>
				Questions about this policy: <a href={'mailto:' + SITE.email}>{SITE.email}</a>.
			</p>
		</div>
	</Section>
</Layout>
