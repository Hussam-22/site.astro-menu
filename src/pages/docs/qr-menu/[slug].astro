---
import { getCollection } from 'astro:content'
import FeaturesLayout from '@layouts/FeaturesLayout.astro'

// Generate a new path for every collection entry
export async function getStaticPaths() {
	const featuresEntries = await getCollection('docs')

	return featuresEntries
		.filter((entry) => entry.slug.includes('qr-menu/'))
		.map((entry) => ({
			params: { slug: entry.slug.substring(9) },
			props: { entry }
		}))
}

// Get the entry directly from the prop on render
const { entry } = Astro.props
const { Content } = await entry.render()
---

<FeaturesLayout title={entry.data.title} content={Content} entry={entry} />
