---
import Layout from '@layouts/Layout.astro'
import Container from '@components/container.astro'
import Section from '@components/ui/section.astro'
import Breadcrumbs from '@components/ui/breadcrumbs.astro'
import CtaBand from '@components/ui/cta-band.astro'
import { COMPARISONS } from '@data/comparisons'

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Compare', path: '/compare' }]
---

<Layout
	title="Compare QR Menus vs PDF, Print & Instagram"
	description="Honest comparisons between a QR menu and the alternatives restaurants already use — including what each of those alternatives still does better."
	breadcrumbs={crumbs}
>
	<Container>
		<Breadcrumbs items={crumbs} />

		<Section
			level={1}
			eyebrow="Compare"
			title="How a QR menu stacks up"
			lede="We compare against formats rather than named competitors, because format is the decision you are actually making. Each page includes what the alternative still does better — there is usually something."
		>
			<div class="mt-12 grid gap-6 md:grid-cols-2">
				{
					COMPARISONS.map((c) => (
						<a
							href={`/compare/${c.slug}`}
							class="rounded-xxl group flex flex-col bg-card p-8 transition hover:bg-line"
						>
							<h2 class="text-2xl font-bold text-ink group-hover:text-brandInk">
								QR menu vs {c.against}
							</h2>
							<p class="mt-3 flex-grow text-muted">{c.lede}</p>
							<span class="mt-4 text-sm font-bold text-brandInk">Read the comparison →</span>
						</a>
					))
				}
			</div>
		</Section>

		<CtaBand />
	</Container>
</Layout>
