---
import Layout from '@layouts/Layout.astro'
import Container from '@components/container.astro'
import Section from '@components/ui/section.astro'
import Breadcrumbs from '@components/ui/breadcrumbs.astro'
import FaqList from '@components/ui/faq-list.astro'
import CtaBand from '@components/ui/cta-band.astro'
import Button from '@components/ui/button.astro'
import { PLAN } from '@config/site'
import { COMPARISONS } from '@data/comparisons'

export function getStaticPaths() {
	return COMPARISONS.map((comparison) => ({
		params: { comparison: comparison.slug },
		props: { comparison }
	}))
}

const { comparison } = Astro.props
const others = COMPARISONS.filter((c) => c.slug !== comparison.slug)

const schema = {
	'@type': 'FAQPage',
	mainEntity: comparison.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a }
	}))
}

const crumbs = [
	{ name: 'Home', path: '/' },
	{ name: 'Compare', path: '/compare' },
	{ name: `vs ${comparison.against}`, path: `/compare/${comparison.slug}` }
]
---

<Layout
	title={comparison.title}
	description={comparison.description}
	schema={schema}
	breadcrumbs={crumbs}
>
	<Container>
		<Breadcrumbs items={crumbs} />

		<section class="py-14 md:py-20">
			<div class="max-w-3xl">
				<h1 class="text-4xl font-extrabold leading-tight text-ink md:text-6xl md:leading-tight">
					{comparison.h1}
				</h1>
				<p class="mt-6 text-xl text-muted">{comparison.lede}</p>
			</div>
		</section>

		<section class="pb-16">
			<div class="max-w-3xl space-y-5 text-lg leading-relaxed text-muted">
				{comparison.body.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</section>

		<section class="pb-8">
			<div class="rounded-xxl border-2 border-line bg-card p-8 md:p-12">
				<h2 class="text-xl font-bold text-ink">In fairness to {comparison.against}</h2>
				<p class="mt-3 text-lg text-muted">{comparison.fair}</p>
			</div>
		</section>

		<Section eyebrow="Side by side" title="The comparison in full">
			<div class="rounded-xxl mt-12 overflow-x-auto bg-card p-4 md:p-8">
				<table class="w-full min-w-[640px] border-collapse text-left">
					<thead>
						<tr class="border-b-2 border-line">
							<th scope="col" class="p-4 text-sm font-bold uppercase tracking-wide text-muted">
								&nbsp;
							</th>
							<th scope="col" class="p-4 text-sm font-bold uppercase tracking-wide text-muted">
								{comparison.against}
							</th>
							<th scope="col" class="p-4 text-sm font-bold uppercase tracking-wide text-brandInk">
								Astro-Menu
							</th>
						</tr>
					</thead>
					<tbody>
						{
							comparison.rows.map((row) => (
								<tr class="border-b border-line align-top">
									<th scope="row" class="p-4 font-bold">
										{row.criterion}
									</th>
									<td class="p-4 text-muted">{row.theirs}</td>
									<td class="p-4 font-medium text-ink">{row.ours}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</Section>

		<Section eyebrow="Verdict" title="So which should you use?">
			<div class="rounded-xxl mx-auto mt-10 max-w-3xl bg-brand p-8 text-brandOn md:p-12">
				<p class="text-xl leading-relaxed">{comparison.verdict}</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<Button href="/pricing" variant="onBrand">
						{PLAN.monthly.aed} AED a month — see pricing
					</Button>
					<Button href="/how-it-works" variant="onBrandOutline">How it works</Button>
				</div>
			</div>
		</Section>

		<Section eyebrow="Questions" title="Questions about switching">
			<FaqList faqs={comparison.faqs} />
		</Section>

		<Section eyebrow="More" title="Other comparisons">
			<div class="mt-10 grid gap-4 sm:grid-cols-3">
				{
					others.map((other) => (
						<a
							href={`/compare/${other.slug}`}
							class="rounded-3xl bg-card p-6 font-bold text-ink transition hover:bg-invert hover:text-invert-ink"
						>
							vs {other.against}
						</a>
					))
				}
			</div>
		</Section>

		<CtaBand />
	</Container>
</Layout>
