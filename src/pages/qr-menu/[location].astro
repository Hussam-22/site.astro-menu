---
import Layout from '@layouts/Layout.astro'
import Container from '@components/container.astro'
import Section from '@components/ui/section.astro'
import Breadcrumbs from '@components/ui/breadcrumbs.astro'
import FaqList from '@components/ui/faq-list.astro'
import CtaBand from '@components/ui/cta-band.astro'
import Button from '@components/ui/button.astro'
import PricingBlock from '@components/pricing-block.astro'
import { PLAN } from '@config/site'
import { LOCATIONS } from '@data/locations'
import { INDUSTRIES } from '@data/industries'

export function getStaticPaths() {
	return LOCATIONS.map((location) => ({
		params: { location: location.slug },
		props: { location }
	}))
}

const { location } = Astro.props
const others = LOCATIONS.filter((l) => l.slug !== location.slug)

const schema = {
	'@type': 'FAQPage',
	mainEntity: location.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a }
	}))
}

const crumbs = [
	{ name: 'Home', path: '/' },
	{ name: 'QR menus', path: '/qr-menu' },
	{ name: location.emirate, path: `/qr-menu/${location.slug}` }
]
---

<Layout
	title={location.title}
	description={location.description}
	schema={schema}
	breadcrumbs={crumbs}
>
	<Container>
		<Breadcrumbs items={crumbs} />

		<section class="py-14 md:py-20">
			<div class="max-w-3xl">
				<p class="mb-4 inline-block rounded-full bg-card px-4 py-1.5 text-sm font-bold text-brand">
					{PLAN.monthly.aed} AED a month · {location.emirate}
				</p>
				<h1 class="text-4xl font-extrabold leading-tight text-ink md:text-6xl md:leading-tight">
					{location.h1}
				</h1>
				<p class="mt-6 text-xl text-muted">{location.lede}</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<Button href="/pricing" variant="brand" size="lg">See pricing</Button>
					<Button href="/how-it-works" variant="outline" size="lg" class="text-ink">
						How it works
					</Button>
				</div>
			</div>
		</section>

		<section class="pb-16">
			<div class="max-w-3xl space-y-5 text-lg leading-relaxed text-muted">
				{location.body.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</section>

		<Section
			eyebrow={`Why ${location.emirate}`}
			title={`What matters for menus in ${location.emirate}`}
		>
			<div class="mt-12 grid gap-4 md:grid-cols-2">
				{
					location.context.map((item) => (
						<div class="rounded-xxl bg-card p-8">
							<h3 class="text-xl font-bold text-ink">{item.title}</h3>
							<p class="mt-3 text-muted">{item.body}</p>
						</div>
					))
				}
			</div>
		</Section>

		<Section eyebrow="Languages" title="The languages your menu should speak">
			<div class="rounded-xxl mx-auto mt-10 max-w-3xl bg-card p-8 md:p-12">
				<p class="text-lg text-muted">{location.languages}</p>
				<p class="mt-4 text-muted">
					You write the menu once. Every diner gets it in the language their phone is already set
					to, and you never print a second version.
				</p>
			</div>
		</Section>

		<Section eyebrow="Coverage" title={`Serving venues across ${location.emirate}`}>
			<div class="mt-10 flex flex-wrap justify-center gap-2">
				{
					location.areas.map((area) => (
						<span class="rounded-full bg-card px-4 py-2 text-sm font-medium text-muted">
							{area}
						</span>
					))
				}
			</div>
			<p class="mx-auto mt-6 max-w-2xl text-center text-muted">
				Astro-Menu is cloud software, so there is nothing to install and no engineer to schedule. If
				you are anywhere in {location.emirate}, you can be live today.
			</p>
		</Section>

		<Section
			eyebrow="Pricing"
			title={`${PLAN.monthly.aed} AED a month, wherever you are`}
			lede="The same price for every venue, in every emirate. No location loading, no commission."
		>
			<PricingBlock />
		</Section>

		<Section eyebrow="By venue type" title="Built for your kind of place">
			<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{
					INDUSTRIES.map((industry) => (
						<a
							href={`/digital-menu/${industry.slug}`}
							class="rounded-3xl bg-card p-6 font-bold text-ink transition hover:bg-invert hover:text-invert-ink"
						>
							{industry.name}
						</a>
					))
				}
			</div>
		</Section>

		<Section eyebrow="Questions" title={`QR menus in ${location.emirate}`}>
			<FaqList faqs={location.faqs} />
		</Section>

		<Section eyebrow="Elsewhere" title="Other emirates">
			<div class="mt-10 flex flex-wrap justify-center gap-2">
				{
					others.map((other) => (
						<a
							href={`/qr-menu/${other.slug}`}
							class="rounded-full bg-card px-4 py-2 text-sm font-medium text-muted transition hover:bg-invert hover:text-invert-ink"
						>
							QR menu {other.emirate}
						</a>
					))
				}
			</div>
		</Section>

		<CtaBand />
	</Container>
</Layout>
