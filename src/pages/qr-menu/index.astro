---
import Layout from '@layouts/Layout.astro'
import Container from '@components/container.astro'
import Section from '@components/ui/section.astro'
import Breadcrumbs from '@components/ui/breadcrumbs.astro'
import FaqList from '@components/ui/faq-list.astro'
import CtaBand from '@components/ui/cta-band.astro'
import Button from '@components/ui/button.astro'
import Check from '@components/ui/icons/check.astro'
import { PLAN } from '@config/site'
import { LOCATIONS } from '@data/locations'
import { COMPARISONS } from '@data/comparisons'

const faqs = [
	{
		q: 'What is a QR menu?',
		a: 'A QR menu is a restaurant menu hosted as a mobile web page, reached by scanning a QR code or opening a link. The diner points their phone camera at the code and the current menu opens in their browser — no app, no download and no account.'
	},
	{
		q: 'How does a QR menu work?',
		a: 'The QR code encodes a web address. Your phone camera reads it and opens that address. Because the address points at a live page rather than a file, whatever you change on the menu is what the next person sees.'
	},
	{
		q: 'What is the difference between a static and a dynamic QR menu?',
		a: 'A static QR code points straight at a fixed file, so changing the menu means generating and reprinting a new code. A dynamic QR code points at a page you control, so the code stays the same forever while the menu behind it changes. Astro-Menu codes are dynamic.'
	},
	{
		q: 'Do customers need an app to scan a QR menu?',
		a: 'No. Every modern iPhone and Android phone reads QR codes with the built-in camera app. There is nothing for the diner to install.'
	},
	{
		q: 'Are QR menus still worth it now?',
		a: 'The hygiene argument that popularised them has faded, but the practical ones have not: instant updates, no reprinting, photos on every dish, automatic translation and a menu link you can put on Google and social media. Those were always the better reasons.'
	},
	{
		q: 'How much does a QR menu cost?',
		a: `Astro-Menu is ${PLAN.monthly.aed} AED per month or ${PLAN.annual.aed} AED per year, per venue, with everything included and no commission. Free QR code generators exist, but they produce a code pointing at a file you still have to host, update and reprint for.`
	},
	{
		q: 'Can I make a QR menu for free?',
		a: 'You can generate a free QR code that points at a PDF, and plenty of venues start there. What you do not get is a mobile-readable menu, instant updates, translation, filters, analytics or a code that survives a menu change.'
	},
	{
		q: 'Is a QR menu good for SEO?',
		a: 'Indirectly, and that is the part worth understanding. Your menu is not what ranks — your Google Business Profile is. What a QR menu changes is what happens after someone finds that listing: the Menu button opens your current menu instead of blurry photos of a board, which is the difference between a visit and a scroll onwards.'
	}
]

const schema = {
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a }
	}))
}

const crumbs = [{ name: 'Home', path: '/' }, { name: 'QR menus', path: '/qr-menu' }]
---

<Layout
	title="What Is a QR Menu? How They Work"
	description="A plain explanation of QR menus: how they work, static versus dynamic codes, what they cost, and how to set one up for a restaurant or café in an afternoon."
	schema={schema}
	breadcrumbs={crumbs}
>
	<Container>
		<Breadcrumbs items={crumbs} />

		<Section level={1} eyebrow="QR menus" title="What a QR menu actually is">
			<div class="mx-auto mt-10 max-w-3xl space-y-5 text-lg leading-relaxed text-muted">
				<p>
					A QR menu is your restaurant menu published as a mobile web page, with a QR code and a
					link pointing at it. A diner opens their phone camera, points it at the code on the table,
					and the menu appears in their browser. There is no app to download and no account to
					create.
				</p>
				<p>
					The useful part is not the code — codes are trivial and free. It is what sits behind the
					code. If it is a PDF, you have a printed menu that happens to be a file, with all the same
					update problems plus a worse reading experience. If it is a real menu system, you get
					something a printed menu can never do: instant changes, a photo on every dish, automatic
					translation for every diner, and dietary filters.
				</p>
				<p>
					The other thing people miss is that a QR menu is not only for tables. The same menu has a
					link, which means it works in your Instagram bio, on your Google listing, in a WhatsApp
					reply and on a delivery bag — all pointing at one version that is always current.
				</p>
			</div>
		</Section>

		<Section
			eyebrow="Static vs dynamic"
			title="The distinction that decides whether you reprint"
			lede="This is the single most important thing to understand before you generate a code."
		>
			<div class="mt-12 grid gap-6 md:grid-cols-2">
				<div class="rounded-xxl bg-card p-8">
					<h3 class="text-xl font-bold text-ink">Static QR code</h3>
					<p class="mt-3 text-muted">
						The destination is baked into the code itself. Change where it should point — a new PDF,
						a new file name, a new menu — and the old code is dead. Every menu change means
						generating a new code and reprinting every table tent, sticker and flyer carrying the
						old one.
					</p>
				</div>
				<div class="rounded-xxl bg-card p-8">
					<h3 class="text-xl font-bold">Dynamic QR code</h3>
					<p class="mt-3 text-muted">
						The code points at a fixed address you control, and you change what lives at that
						address. Print it once — on tables, windows, packaging, flyers — and it keeps working
						through every price change, seasonal menu and rebrand. This is what Astro-Menu gives
						you.
					</p>
				</div>
			</div>
		</Section>

		<Section
			eyebrow="Getting one"
			title="What a QR menu needs to be worth having"
			lede="A code pointing at a PDF technically qualifies. Here is the checklist that separates that from something your customers will actually enjoy using."
		>
			<div class="mx-auto mt-12 max-w-3xl">
				<ul class="space-y-3">
					{
						[
							'It opens instantly in the browser rather than downloading a file',
							'It is readable on a phone without pinching or zooming',
							'You can change a price yourself, in seconds, at no cost',
							'The QR code survives the change and never needs reprinting',
							'Every item can carry a photo',
							'It translates itself for diners who do not read your default language',
							'Guests can filter by dietary need',
							'It is one link you can put on Google, Instagram and the table',
							'You can see which items people looked at'
						].map((item) => (
							<li class="flex items-start gap-3 text-ink">
								<Check class="mt-1 h-4 w-4 flex-none text-green-500" />
								<span>{item}</span>
							</li>
						))
					}
				</ul>
				<div class="mt-8 flex flex-wrap gap-3">
					<Button href="/how-it-works" variant="primary">See how setup works</Button>
					<Button href="/pricing" variant="outline" class="text-ink">What it costs</Button>
				</div>
			</div>
		</Section>

		<Section eyebrow="Compare" title="QR menus against the alternatives">
			<div class="mt-12 grid gap-4 sm:grid-cols-2">
				{
					COMPARISONS.map((c) => (
						<a
							href={`/compare/${c.slug}`}
							class="rounded-xxl group bg-card p-8 transition hover:bg-line"
						>
							<h3 class="text-xl font-bold text-ink group-hover:text-brand">
								QR menu vs {c.against}
							</h3>
							<p class="mt-2 text-sm text-muted">{c.lede}</p>
						</a>
					))
				}
			</div>
		</Section>

		<Section eyebrow="Local" title="QR menus across the UAE">
			<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					LOCATIONS.map((location) => (
						<a
							href={`/qr-menu/${location.slug}`}
							class="rounded-3xl bg-card p-6 transition hover:bg-invert hover:text-invert-ink"
						>
							<h3 class="font-bold">QR menu {location.emirate}</h3>
						</a>
					))
				}
			</div>
		</Section>

		<Section eyebrow="Questions" title="QR menu questions">
			<FaqList faqs={faqs} />
		</Section>

		<CtaBand />
	</Container>
</Layout>
