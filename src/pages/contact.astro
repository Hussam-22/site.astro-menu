---
import ContactForm from "@components/contact-form.astro";
import Container from "@components/container.astro";
import Layout from "@layouts/Layout.astro";
import SectionHead from "@ui/section-head.astro";
---

<Layout
  title="Contact Astro-Menu"
  description="Contact the Astro-Menu team to request a demo or ask about QR menus and cloud POS."
>
  <Container class="flex flex-col items-center text-center mt-16">
    <SectionHead
      title="Contact Us"
      tag="h1"
      description="Get in touch with the Astro-Menu team"
      bottomSpace="mb-6"
    />
    <div class="bg-base-200 w-full sm:max-w-2xl p-6 rounded-4xl">
      <ContactForm />
    </div>
  </Container>
</Layout>
