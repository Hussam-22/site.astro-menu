---
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import FoodImage from '../components/ui/FoodImage.astro'
import Section from '../components/ui/Section.astro'
import SectionHead from '../components/ui/SectionHead.astro'
import Sticker from '../components/ui/Sticker.astro'
import { CONTACT_FORM_KEY, PRICE, SITE } from '../config/site'
import Layout from '../layouts/Layout.astro'
import { crumbSchema } from '../utils/schema'

const title = 'Contact us'
const description = `Send us the menu you have now and we build the first version free. Email ${SITE.email} — a person answers, usually the same day.`

/**
 * The form only renders once a real Web3Forms access key is set in
 * src/config/site.ts. Shipping a form wired to a placeholder key would look
 * like it worked and quietly drop every enquiry, so until the key is real the
 * page leads with email, which always works.
 */
const formReady = CONTACT_FORM_KEY.length > 0 && !CONTACT_FORM_KEY.startsWith('REPLACE_')
---

<Layout
	title={title}
	description={description}
	path="/contact"
	schema={crumbSchema([{ name: 'Contact', path: '/contact' }])}
>
	<Section tight>
		<Breadcrumbs trail={[{ name: 'Contact' }]} />
		<div class="mt-8 grid items-start gap-14 lg:grid-cols-[1fr_1fr]">
			<div>
				<SectionHead
					as="h1"
					eyebrow="Contact"
					title="Send us your menu"
					lede="Whatever form it is in — a PDF, a photo of the printed card, a spreadsheet. We will build the first version for you and send it back ready to check. No charge, no obligation."
				/>

				<div class="mt-9">
					<a
						href={`mailto:${SITE.email}`}
						class="bg-card slab slab-hover flex items-center gap-4 rounded-[1.25rem] p-6"
					>
						<span
							class="brand-gradient border-ink grid h-12 w-12 shrink-0 place-items-center rounded-xl border-[2.5px] text-white"
						>
							<svg
								viewBox="0 0 24 24"
								class="h-6 w-6"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								aria-hidden="true"
							>
								<rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
								<path d="m3.5 7 8.5 6 8.5-6"></path>
							</svg>
						</span>
						<span>
							<span class="block text-xl font-bold">{SITE.email}</span>
							<span class="text-ink-soft block text-base">Usually answered the same day</span>
						</span>
					</a>
				</div>

				<div class="mt-8 flex flex-wrap gap-2.5">
					<Sticker tone="orange">First menu built free</Sticker>
					<Sticker tone="rose">{PRICE.trialDays} days free</Sticker>
					<Sticker>No sales call</Sticker>
				</div>
			</div>

			<div>
				{
					formReady ? (
						<form
							action="https://api.web3forms.com/submit"
							method="POST"
							class="bg-card slab-lg rounded-[1.5rem] p-8"
						>
							<input type="hidden" name="access_key" value={CONTACT_FORM_KEY} />
							<input type="hidden" name="subject" value="New Astro-Menu enquiry" />
							{/* Honeypot: bots fill it, people never see it. */}
							<input
								type="checkbox"
								name="botcheck"
								class="hidden"
								style="display:none"
								tabindex="-1"
								autocomplete="off"
							/>

							<h2 class="text-3xl">Or write to us here</h2>

							<div class="mt-6 space-y-5">
								<div>
									<label for="name" class="block text-lg font-bold">
										Your name
									</label>
									<input
										id="name"
										name="name"
										type="text"
										required
										autocomplete="name"
										class="border-ink bg-paper mt-2 w-full rounded-xl border-[2.5px] px-4 py-3 text-lg"
									/>
								</div>
								<div>
									<label for="venue" class="block text-lg font-bold">
										Venue name
									</label>
									<input
										id="venue"
										name="venue"
										type="text"
										class="border-ink bg-paper mt-2 w-full rounded-xl border-[2.5px] px-4 py-3 text-lg"
									/>
								</div>
								<div>
									<label for="email" class="block text-lg font-bold">
										Email
									</label>
									<input
										id="email"
										name="email"
										type="email"
										required
										autocomplete="email"
										class="border-ink bg-paper mt-2 w-full rounded-xl border-[2.5px] px-4 py-3 text-lg"
									/>
								</div>
								<div>
									<label for="message" class="block text-lg font-bold">
										What do you need?
									</label>
									<textarea
										id="message"
										name="message"
										rows="5"
										required
										class="border-ink bg-paper mt-2 w-full rounded-xl border-[2.5px] px-4 py-3 text-lg"
									/>
								</div>
							</div>

							<button
								type="submit"
								class="brand-gradient border-ink mt-7 w-full rounded-full border-[2.5px] py-4 text-xl font-bold text-white shadow-[4px_4px_0_var(--color-ink)] transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5"
							>
								Send it
							</button>
							<p class="text-ink-faint mt-4 text-base">
								We use what you send only to reply. Nothing else, ever.
							</p>
						</form>
					) : (
						<div class="border-ink overflow-hidden rounded-[1.5rem] border-[3px]">
							<FoodImage
								name="contact"
								alt="A cafe owner sitting with a laptop and a coffee, setting up their menu"
								brief="Owner at a table with laptop and coffee, relaxed, setting up the menu"
								tone="warm"
								ratio="4/5"
								sizes="(min-width:1024px) 45vw, 92vw"
							/>
						</div>
					)
				}
			</div>
		</div>
	</Section>
</Layout>
