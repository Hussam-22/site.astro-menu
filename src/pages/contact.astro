---
import ContactForm from '@components/contactform.astro'
import Container from '@components/container.astro'
import SectionHead from '@components/sectionhead.astro'
import Layout from '@layouts/Layout.astro'
---

<Layout title="Contact">
	<Container class="grow md:max-w-(--breakpoint-md)">
		<SectionHead>
			<Fragment slot="title"
				>Contact <span class="whitespace-nowrap">Astro-Menu</span> Team</Fragment
			>
			<Fragment slot="desc"
				><p class="mt-3 text-lg leading-relaxed text-white">
					Have something to say? We are here to help. Fill up the form or send email to:
					<strong class="whitespace-nowrap text-orange-400">hello@astro-menu.com</strong>
				</p></Fragment
			>
		</SectionHead>

		<div class="mx-auto mt-16 grid max-w-2xl gap-10 lg:mb-24">
			<ContactForm />
		</div>
	</Container>
</Layout>
