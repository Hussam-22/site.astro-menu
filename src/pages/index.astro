---
import Layout from '@layouts/Layout.astro'
import Container from '@components/container.astro'
import Section from '@components/ui/section.astro'
import Button from '@components/ui/button.astro'
import Check from '@components/ui/icons/check.astro'
import Cross from '@components/ui/icons/cross.astro'
import FaqList from '@components/ui/faq-list.astro'
import CtaBand from '@components/ui/cta-band.astro'
import PricingBlock from '@components/pricing-block.astro'
import ProductGallery from '@components/product-gallery.astro'
import Hero from '@components/landing/hero.astro'
import Marquee from '@components/landing/marquee.astro'
import { Image } from 'astro:assets'
import menuShot from 'assets/screens/menu-sections.png'
import printMenu from 'assets/print-menu.png'
import { PLAN, ANNUAL_SAVING } from '@config/site'
import { STEPS, NOT_INCLUDED } from '@data/plan'
import { CORE_FAQS } from '@data/faqs'
import { INDUSTRIES } from '@data/industries'
import { LOCATIONS } from '@data/locations'

const homeFaqs = CORE_FAQS.slice(0, 8)

const capabilities = [
	{
		title: 'Change a price in seconds',
		body: 'Edit the item and every diner sees the new price immediately. The QR code stays the same, so you never reprint.'
	},
	{
		title: 'A photo on every dish',
		body: 'People order what they can see. Photos sit next to each item instead of a line of text on a laminated page.'
	},
	{
		title: 'Arabic, English, anything else',
		body: 'Write the menu once. Each guest reads it in the language their phone is already set to.'
	},
	{
		title: 'Calories and macros',
		body: 'Show CAL, CARB, FAT and PRO on any item. Optional, and the reason healthy-eating and meal-prep kitchens pick us.'
	},
	{
		title: 'Hide what has sold out',
		body: 'Switch an item off and it disappears from the menu. Nobody orders something the kitchen cannot make.'
	},
	{
		title: 'One link, everywhere',
		body: 'The same menu works on the table, in your Instagram bio, on your Google listing and on a delivery bag.'
	}
]

const printVsDigital = [
	['Changing a price', 'Reprint every copy', 'Ten seconds, free'],
	['A dish sells out', 'The server apologises', 'Hidden instantly'],
	['Photos', 'Expensive to print', 'On every item'],
	['A second language', 'A second print run', 'Automatic'],
	['Reading it on a phone', 'Pinch, zoom, squint', 'Built for the screen'],
	['Cost per year', 'Every reprint, again', `${PLAN.annual.aed} AED, all in`]
]

const schema = {
	'@type': 'FAQPage',
	mainEntity: homeFaqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a }
	}))
}
---

<Layout
	title="QR Menu for Restaurants & Cafés"
	description={`A QR menu for your restaurant: photos on every dish, Arabic and English, prices you change in seconds. ${PLAN.monthly.aed} AED a month, no POS and no commission.`}
	schema={schema}
>
	<Container>
		<Hero />
	</Container>

	<Marquee />

	<Container>
		<!-- What it is -->
		<Section
			eyebrow="What it is"
			title="A menu. Nothing bolted on."
			lede="Most menu products come attached to a till system, take a cut of every order and charge like enterprise software. This one shows your menu and stays out of the way."
		>
			<div class="mt-14 grid gap-5 md:grid-cols-2">
				{
					NOT_INCLUDED.map((item) => (
						<div class="rounded-4xl border border-line bg-card p-8">
							<div class="flex items-center gap-3">
								<Cross class="h-5 w-5 flex-none text-brandInk" />
								<h3 class="text-2xl font-extrabold text-ink">{item.label}</h3>
							</div>
							<p class="mt-3 text-lg text-muted">{item.reason}</p>
						</div>
					))
				}
			</div>
			<p class="mt-10 max-w-2xl text-lg text-muted">
				That is why it costs {PLAN.monthly.aed} AED a month instead of several hundred.
			</p>
		</Section>

		<!-- How it works -->
		<Section
			eyebrow="How it works"
			title="Live by this afternoon"
			lede="Nothing to install, nothing to plug in, nobody has to visit your venue."
		>
			<div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
				{
					STEPS.map((step, i) => (
						<div class="rounded-4xl flex flex-col border border-line bg-card p-8">
							<span class="text-6xl font-extrabold leading-none text-brandInk">{i + 1}</span>
							<h3 class="mt-5 text-2xl font-extrabold leading-tight text-ink">{step.title}</h3>
							<p class="mt-3 flex-grow text-muted">{step.body}</p>
							<p class="mt-5 text-sm font-bold text-muted">{step.detail}</p>
						</div>
					))
				}
			</div>
			<div class="mt-10">
				<Button href="/how-it-works" variant="surface">See the full walkthrough</Button>
			</div>
		</Section>

		<!-- Real menus -->
		<ProductGallery
			align="center"
			eyebrow="Real menus"
			title="What your customers actually see"
			lede="Live Astro-Menu menus, exactly as they appear on a diner's phone."
		/>

		<!-- Side by side -->
		<Section
			eyebrow="Side by side"
			title="The same menu, printed and digital"
			lede="Left is a printed or PDF menu. Right is the same kind of food on Astro-Menu. This is the difference your customer sees."
		>
			<div class="mt-14 grid items-start gap-6 lg:grid-cols-2">
				<figure class="rounded-4xl border border-line bg-card p-6 md:p-8">
					<div class="overflow-hidden rounded-2xl border border-line bg-white">
						<Image
							src={printMenu}
							alt="A traditional printed restaurant menu: two columns of text with dotted price leaders and no photographs"
							widths={[420, 840]}
							sizes="(max-width: 1024px) 90vw, 420px"
							loading="lazy"
							class="mx-auto h-[460px] w-full object-contain"
						/>
					</div>
					<figcaption class="mt-6">
						<h3 class="text-2xl font-extrabold text-ink">Printed or PDF</h3>
						<ul class="mt-4 space-y-2">
							{
								[
									'No photos — diners guess what a dish looks like',
									'Prices are fixed until the next print run',
									'One language per printed copy',
									'Sold-out dishes stay on the page all evening',
									'On a phone it arrives as a wall of small text'
								].map((item) => (
									<li class="flex items-start gap-3 text-muted">
										<Cross class="mt-1.5 h-3.5 w-3.5 flex-none" />
										<span>{item}</span>
									</li>
								))
							}
						</ul>
					</figcaption>
				</figure>

				<figure class="rounded-4xl border-2 border-brand bg-card p-6 md:p-8">
					<div class="overflow-hidden rounded-2xl border border-line bg-white">
						<Image
							src={menuShot}
							alt="The same menu on Astro-Menu: a photo, price and macros on every dish"
							widths={[420, 840]}
							sizes="(max-width: 1024px) 90vw, 420px"
							loading="lazy"
							class="mx-auto h-[460px] w-full object-contain"
						/>
					</div>
					<figcaption class="mt-6">
						<div class="flex flex-wrap items-center gap-3">
							<h3 class="text-2xl font-extrabold text-ink">Astro-Menu</h3>
							<span class="rounded-full bg-brand px-3 py-1 text-sm font-bold text-brandOn">
								{PLAN.monthly.aed} AED / month
							</span>
						</div>
						<ul class="mt-4 space-y-2">
							{
								[
									'A photo on every dish',
									'Change a price in ten seconds, free',
									'Every diner reads it in their own language',
									'Sold-out dishes disappear instantly',
									'Built for the phone it is read on'
								].map((item) => (
									<li class="flex items-start gap-3 text-ink">
										<Check class="mt-1.5 h-3.5 w-3.5 flex-none text-brandInk" />
										<span>{item}</span>
									</li>
								))
							}
						</ul>
					</figcaption>
				</figure>
			</div>

			<div class="rounded-4xl mt-6 overflow-x-auto border border-line">
				<table class="w-full min-w-[560px] border-collapse text-left">
					<thead>
						<tr class="border-b border-line bg-card">
							<th scope="col" class="p-4 text-sm font-extrabold uppercase tracking-wide text-muted">
								&nbsp;
							</th>
							<th scope="col" class="p-4 text-sm font-extrabold uppercase tracking-wide text-muted">
								Printed menu
							</th>
							<th scope="col" class="p-4 text-sm font-extrabold uppercase tracking-wide text-brandInk">
								Astro-Menu
							</th>
						</tr>
					</thead>
					<tbody>
						{
							printVsDigital.map(([criterion, theirs, ours]) => (
								<tr class="border-b border-line last:border-0">
									<th scope="row" class="p-4 font-bold text-ink">
										{criterion}
									</th>
									<td class="p-4 text-muted">{theirs}</td>
									<td class="p-4 font-medium text-ink">{ours}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>

			<div class="mt-8 flex flex-wrap gap-3">
				<Button href="/compare/qr-menu-vs-printed-menu" variant="surface" size="sm">
					vs a printed menu
				</Button>
				<Button href="/compare/qr-menu-vs-pdf-menu" variant="surface" size="sm">vs a PDF menu</Button>
			</div>
		</Section>

		<!-- Capabilities -->
		<Section
			eyebrow="What you get"
			title="Everything is in the one plan"
			lede="No cheaper tier missing the thing you need, and no expensive tier to grow into."
		>
			<dl class="mt-14 divide-y divide-line border-y border-line">
				{
					capabilities.map((item) => (
						<div class="grid gap-2 py-8 md:grid-cols-[1fr_1.4fr] md:gap-12">
							<dt class="text-2xl font-extrabold leading-tight text-ink md:text-3xl">
								{item.title}
							</dt>
							<dd class="text-lg leading-relaxed text-muted">{item.body}</dd>
						</div>
					))
				}
			</dl>
			<div class="mt-10">
				<Button href="/features" variant="surface">See every feature</Button>
			</div>
		</Section>

		<!-- Cost -->
		<Section
			eyebrow="Cost"
			title={`${PLAN.annual.aed} AED a year. That is the whole bill.`}
			lede="No setup fee, no charge per scan, no commission on what you sell. Compare it against what you spent on menu printing last year — design, print, lamination, and every reprint when a price moved."
		>
			<div class="mt-14 grid gap-5 md:grid-cols-3">
				<div class="rounded-4xl bg-invert p-10 text-invert-ink">
					<p class="text-6xl font-extrabold leading-none">{PLAN.annual.aed} AED</p>
					<p class="mt-4 text-xl font-extrabold">Everything, for a year</p>
					<p class="mt-2 opacity-70">
						Unlimited items, unlimited changes, unlimited people looking at it.
					</p>
				</div>
				<div class="rounded-4xl border border-line bg-card p-10">
					<p class="text-6xl font-extrabold leading-none text-ink">0 AED</p>
					<p class="mt-4 text-xl font-extrabold text-ink">To change a price</p>
					<p class="mt-2 text-muted">
						However often you do it. A printed menu charges you for every single change.
					</p>
				</div>
				<div class="rounded-4xl border border-line bg-card p-10">
					<p class="text-6xl font-extrabold leading-none text-ink">0%</p>
					<p class="mt-4 text-xl font-extrabold text-ink">Commission</p>
					<p class="mt-2 text-muted">
						We never handle an order or a payment, so there is nothing to take a cut of.
					</p>
				</div>
			</div>
		</Section>

		<!-- Found on Google -->
		<Section
			eyebrow="Found on Google"
			title="Search your own restaurant right now"
			lede="Tap Menu on your Google listing. Whatever appears is what every new customer sees before deciding whether to come."
		>
			<div class="mt-14 grid gap-5 lg:grid-cols-3">
				<div class="rounded-4xl border-2 border-dashed border-line p-8">
					<p class="text-sm font-bold uppercase tracking-widest text-muted">Usually you get</p>
					<h3 class="mt-3 text-2xl font-extrabold text-ink">Photos of a menu board</h3>
					<p class="mt-3 text-muted">
						Snapshots taken at an angle by you or a customer, showing whatever the prices were that
						day. Nobody goes back and deletes the one from two years ago.
					</p>
				</div>
				<div class="rounded-4xl border-2 border-dashed border-line p-8">
					<p class="text-sm font-bold uppercase tracking-widest text-muted">Or worse</p>
					<h3 class="mt-3 text-2xl font-extrabold text-ink">A delivery app’s copy</h3>
					<p class="mt-3 text-muted">
						Marked “provided by” an aggregator: their layout, their prices with commission built in,
						and usually only the items you list for delivery.
					</p>
				</div>
				<div class="rounded-4xl bg-brand p-8 text-brandOn">
					<p class="text-sm font-bold uppercase tracking-widest text-brandOn/70">With Astro-Menu</p>
					<h3 class="mt-3 text-2xl font-extrabold">Your real menu</h3>
					<p class="mt-3 text-brandOn/80">
						Paste your link into your Google profile once. Everyone who looks you up gets today’s
						prices, a photo on every dish, and their own language.
					</p>
				</div>
			</div>
			<div class="mt-10">
				<Button href="/compare/qr-menu-vs-google-business-menu" variant="brand">
					Fix what Google shows
				</Button>
			</div>
		</Section>

		<!-- Pricing -->
		<Section
			id="pricing"
			align="center"
			eyebrow="Pricing"
			title="One plan. One price."
			lede={`${PLAN.monthly.aed} AED a month, or ${PLAN.annual.aed} AED for the year — ${ANNUAL_SAVING.percent}% cheaper. Switch currency below.`}
		>
			<PricingBlock />
		</Section>

		<!-- Internal links -->
		<Section eyebrow="By venue" title="Find your kind of place">
			<div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{
					INDUSTRIES.map((industry) => (
						<a
							href={`/digital-menu/${industry.slug}`}
							class="rounded-4xl border border-line bg-card p-8 transition hover:border-brand"
						>
							<h3 class="text-2xl font-extrabold text-ink">{industry.name}</h3>
							<p class="mt-2 text-muted">{industry.lede}</p>
							<span class="mt-4 inline-block font-bold text-brandInk">Read more →</span>
						</a>
					))
				}
			</div>

			<div class="rounded-4xl mt-6 border border-line bg-card p-8">
				<h3 class="text-xl font-extrabold text-ink">Serving the UAE</h3>
				<div class="mt-4 flex flex-wrap gap-2">
					{
						LOCATIONS.map((location) => (
							<a
								href={`/qr-menu/${location.slug}`}
								class="inline-flex min-h-11 items-center rounded-full border border-line bg-page px-5 text-sm font-bold text-ink transition hover:bg-brand hover:text-brandOn"
							>
								QR menu {location.emirate}
							</a>
						))
					}
				</div>
			</div>
		</Section>

		<!-- FAQ -->
		<Section
			align="center"
			eyebrow="Questions"
			title="The things people ask first"
			lede="If yours is not here, the full list has more — or just email us."
		>
			<FaqList faqs={homeFaqs} />
			<div class="mt-10 text-center">
				<Button href="/faq" variant="surface">Read all the questions</Button>
			</div>
		</Section>

		<CtaBand />
	</Container>
</Layout>
