---
import Layout from '../layouts/Layout.astro'
import Section from '../components/ui/Section.astro'
import SectionHead from '../components/ui/SectionHead.astro'
import Button from '../components/ui/Button.astro'
import Sticker from '../components/ui/Sticker.astro'
import Burst from '../components/ui/Burst.astro'
import Ribbon from '../components/ui/Ribbon.astro'
import FoodImage from '../components/ui/FoodImage.astro'
import Check from '../components/ui/Check.astro'
import Cross from '../components/ui/Cross.astro'
import FaqList from '../components/ui/FaqList.astro'
import CtaBand from '../components/ui/CtaBand.astro'
import PricingCard from '../components/PricingCard.astro'
import { Image } from 'astro:assets'
import { SITE, PRICE } from '../config/site'
import {
	PILLARS,
	VENUES,
	VERSUS,
	USE_CASES,
	SCREENS,
	RIBBON,
	venue,
	testimonialFor
} from '../data/content'
import VenueLogo from '../components/ui/VenueLogo.astro'
import { DASHBOARD_CONTROLS, NOT_INCLUDED } from '../data/plan'
import { HOME_FAQS, ALL_FAQS } from '../data/faqs'
import DashboardImage from '../components/ui/DashboardImage.astro'

/** Eagerly loaded so the six real menu screenshots can be looked up by filename. */
const screenFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', {
	eager: true
})
const screenshot = (file: string) =>
	screenFiles[`../assets/screens/${file}`]?.default as ImageMetadata

const title = 'QR Menu for Restaurants & Cafés'
const description = `Turn your menu into a fast, photo-led QR menu you update in seconds. Every language, one QR that never needs reprinting. ${PRICE.monthly} a month, no commission.`

const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'Astro-Menu',
		applicationCategory: 'BusinessApplication',
		applicationSubCategory: 'Digital QR Menu',
		operatingSystem: 'Web browser',
		url: SITE.domain,
		description: SITE.description,
		featureList: [
			'QR code menu',
			'Unlimited menus, sections and items',
			'Automatic translation including Arabic',
			'Dietary and allergen tags',
			'Meal-type filters',
			'Calories and macros per item',
			'Menu analytics'
		],
		offers: {
			'@type': 'Offer',
			price: String(PRICE.monthlyAmount),
			priceCurrency: 'USD',
			url: `${SITE.domain}/pricing`,
			availability: 'https://schema.org/InStock',
			priceSpecification: {
				'@type': 'UnitPriceSpecification',
				price: String(PRICE.monthlyAmount),
				priceCurrency: 'USD',
				unitCode: 'MON',
				billingIncrement: 1
			}
		}
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: HOME_FAQS.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a }
		}))
	}
]
---

<Layout title={title} description={description} path="/" schema={schema}>
	<!-- ================= HERO ================= -->
	<section class="relative overflow-hidden pt-14 pb-8 lg:pt-20">
		<div class="mx-auto max-w-7xl px-5 lg:px-8">
			<div class="flex flex-wrap items-center gap-2.5">
				<Sticker tone="orange">No commission</Sticker>
				<Sticker tone="rose">We build it for you</Sticker>
				<Sticker>No app to download</Sticker>
			</div>

			<h1 class="mt-7 text-[3.4rem] leading-[0.9] sm:text-8xl lg:text-[8.5rem]">
				Show the{' '}<span
					class="border-ink hidden h-[0.82em] w-[0.82em] shrink-0 -translate-y-[0.04em] place-items-center overflow-hidden rounded-full border-[3px] align-middle sm:inline-grid"
				>
					<FoodImage
						name="hero-cut"
						alt=""
						ratio="1"
						tone="brand"
						priority={true}
						widths={[200, 400]}
						sizes="120px"
					/>
				</span>{' '}food,<br />not a list<span class="text-brand-text">.</span>
			</h1>

			<div class="mt-12 grid items-start gap-12 lg:grid-cols-[1.15fr_0.85fr]">
				<div>
					<p class="text-ink-soft max-w-xl text-xl leading-relaxed text-pretty sm:text-2xl">
						Send us the menu you have now and we turn it into a photo-led QR menu for you. After
						that it is yours — every change you make goes live the moment you save it. One flat
						price. No POS, no commission, no hardware.
					</p>

					<div class="mt-8 flex flex-wrap gap-4">
						<Button href={SITE.signupUrl} size="lg">Start {PRICE.trialDays} days free</Button>
						<Button href="/demo" variant="outline" size="lg">See a real menu</Button>
					</div>
					<p class="text-ink-faint mt-4 text-base">
						No card required · {PRICE.monthly} a month after · Cancel any time
					</p>

					<div class="border-line mt-10 flex flex-wrap items-center gap-x-10 gap-y-6 border-t pt-8">
						<div>
							<p class="font-display text-5xl">120+</p>
							<p class="text-ink-soft text-base font-semibold">items on one live menu</p>
						</div>
						<div>
							<p class="font-display text-5xl">&lt;1s</p>
							<p class="text-ink-soft text-base font-semibold">to load on a phone</p>
						</div>
						<div class="flex items-center gap-3">
							<div class="flex">
								{
									['owner', 'staff', 'guests'].map((n, i) => (
										<span
											class:list={[
												'border-paper h-12 w-12 overflow-hidden rounded-full border-[3px]',
												i > 0 && '-ml-4'
											]}
										>
											<FoodImage
												name={n}
												alt=""
												ratio="1"
												tone={i === 1 ? 'brand' : i === 2 ? 'dark' : 'warm'}
												widths={[100, 200]}
												sizes="48px"
											/>
										</span>
									))
								}
							</div>
							<div>
								<p class="text-base font-bold">Real venues, real menus</p>
								<p class="text-ink-faint text-base">Cafés · trucks · hotels</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Phone, burst and float are one composition, so they are anchored to a
				     single relative wrapper rather than to the grid column. -->
				<div class="flex justify-center lg:justify-end">
					<div class="relative w-full max-w-[19rem]">
						<Burst class="absolute -top-5 -left-8 z-20" size={7.5} rotate={-13}>
							{PRICE.trialDays} days<br />free
						</Burst>

						<!-- No drop shadow here. The hero section is overflow-hidden, so a soft
						     shadow gets sliced off at its right and bottom edges and reads as a grey
						     rectangle around the phone rather than as depth. The 3px ink border
						     carries the lift instead, which is the house style anyway. -->
						<div class="border-ink relative rounded-[2.75rem] border-[3px] bg-black p-2.5">
							<div
								class="absolute top-4 left-1/2 z-10 h-6 w-24 -translate-x-1/2 rounded-full bg-black"
							>
							</div>
							<div class="overflow-hidden rounded-[2.1rem] bg-white">
								<Image
									src={screenshot('menu-sections.png')}
									alt={`The live ${SITE.demoVenueName} menu on a phone, showing section chips and dishes with photos and prices`}
									widths={[390, 600, 780]}
									sizes="304px"
									loading="eager"
									fetchpriority="high"
									class="block h-auto w-full"
								/>
							</div>
						</div>

						<div
							class="border-ink absolute -bottom-9 -left-10 z-20 w-40 -rotate-[8deg] overflow-hidden rounded-2xl border-[3px] sm:w-44"
						>
							<FoodImage
								name="hero-float"
								alt=""
								ratio="4/3"
								tone="warm"
								brief="Hands holding a burger, cut out on colour"
								widths={[300, 500]}
								sizes="176px"
							/>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<div class="mt-20">
		<Ribbon items={RIBBON} />
	</div>

	<!-- ================= WHY / PILLARS ================= -->
	<Section id="why">
		<SectionHead
			eyebrow="Why Astro-Menu"
			title="Everybody at the table wins"
			lede="The owner stops reprinting. The staff stop apologising. The guest stops squinting at a PDF."
		/>
		<div class="mt-14 grid gap-7 md:grid-cols-3">
			{
				PILLARS.map((p) => (
					<article class="bg-card slab slab-hover overflow-hidden rounded-[1.75rem]">
						<div class="border-ink border-b-[2.5px]">
							<FoodImage
								name={p.image}
								alt={p.brief}
								brief={p.brief}
								tone={p.tone}
								ratio="16/10"
								sizes="(min-width:768px) 33vw, 100vw"
							/>
						</div>
						<div class="p-7">
							<Sticker tone={p.tone === 'dark' ? 'ink' : 'orange'} size="sm">
								{p.who}
							</Sticker>
							<h3 class="mt-4 text-3xl">{p.title}</h3>
							<p class="text-ink-soft mt-3 text-lg text-pretty">{p.body}</p>
						</div>
					</article>
				))
			}
		</div>
	</Section>

	<!-- ================= WHAT GUESTS SEE ================= -->
	<Section tone="card" ruled id="menu">
		<SectionHead
			eyebrow="What your guests see"
			title="Six screens.<br />All of them real."
			lede={`Every screen below is a real customer menu running on Astro-Menu today — most of them ${SITE.demoVenueName}, 120 items live in Al Ain. Nothing here is a render.`}
		/>
		<div class="masonry mt-14 sm:columns-2 lg:columns-3">
			{
				SCREENS.map((s) => (
					<figure class="border-ink pin-hover bg-paper overflow-hidden rounded-[1.5rem] border-[2.5px]">
						<Image
							src={screenshot(s.file)}
							alt={`${s.title} — ${s.body}`}
							widths={[390, 600, 780]}
							sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 90vw"
							class="block h-auto w-full"
						/>
						<figcaption class="border-ink border-t-[2.5px] p-5">
							<h3 class="text-xl">{s.title}</h3>
							<p class="text-ink-soft mt-1.5 text-base text-pretty">{s.body}</p>
							{'credit' in s && (
								<p class="text-ink-faint mt-2 text-base">
									Shown on{' '}
									<a
										href={venue(s.credit).menuUrl}
										rel="noopener noreferrer"
										target="_blank"
										class="font-bold hover:underline"
									>
										{venue(s.credit).name}
									</a>
								</p>
							)}
						</figcaption>
					</figure>
				))
			}
		</div>
		<div class="mt-12 flex flex-wrap justify-center gap-4">
			<Button href={SITE.demoMenuUrl} external size="lg">Open the live menu</Button>
			<Button href="/features" variant="outline" size="lg">All the features</Button>
		</div>
	</Section>

	<!-- ================= DASHBOARD ================= -->
	<Section tone="ink" id="dashboard">
		<div class="grid items-center gap-14 lg:grid-cols-2">
			<div>
				<SectionHead
					eyebrow="What you control"
					title="The whole menu,<br />from your phone"
					lede="Everything a guest sees is a field you own. No designer, no developer, no support ticket, no waiting on anyone."
					invert
				/>
				<div class="mt-8 flex flex-wrap gap-2.5">
					{
						DASHBOARD_CONTROLS.map((c, i) => (
							<Sticker tone={i % 4 === 1 ? 'orange' : i % 4 === 3 ? 'rose' : 'outline-light'}>
								{c.title}
							</Sticker>
						))
					}
				</div>
				<div class="mt-9">
					<Button href="/how-it-works" variant="light" size="lg">How setup works</Button>
				</div>
			</div>

			<DashboardImage
				name="dash-meals"
				alt="The Astro-Menu meals list: every dish with its photo, portions and prices, and an Active or Disabled toggle on each row"
				brief="The Meals list: photos, portions, prices, and one dish switched off"
				frame="light"
				sizes="(min-width:1024px) 45vw, 92vw"
				widths={[600, 900, 1400]}
			/>
		</div>

		<dl class="mt-16 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
			{
				DASHBOARD_CONTROLS.map((c) => (
					<div class="border-t-[2.5px] border-white/25 pt-4">
						<dt class="label text-brand text-base">{c.title}</dt>
						<dd class="mt-1.5 text-lg text-white/65 text-pretty">{c.body}</dd>
					</div>
				))
			}
		</dl>
	</Section>

	<!-- ================= VERSUS ================= -->
	<Section id="compare">
		<SectionHead
			eyebrow="Astro-Menu vs a printed menu"
			title="One of these costs you money<br />every time it changes"
		/>

		<div class="border-ink bg-card slab mt-12 overflow-hidden rounded-[1.75rem]">
			<div class="overflow-x-auto">
				<table class="w-full min-w-[46rem] text-start">
					<caption class="sr-only">
						Astro-Menu compared with a printed or PDF menu, across eight everyday situations
					</caption>
					<thead>
						<tr class="border-ink border-b-[2.5px]">
							<th scope="col" class="label w-1/4 px-6 py-5 text-sm">Situation</th>
							<th scope="col" class="text-brand-text label w-[37.5%] px-6 py-5 text-sm">Astro-Menu</th>
							<th scope="col" class="label w-[37.5%] px-6 py-5 text-sm">Printed or PDF menu</th>
						</tr>
					</thead>
					<tbody>
						{
							VERSUS.map((row) => (
								<tr class="border-line border-b-2 last:border-b-0">
									<th scope="row" class="px-6 py-5 align-top text-lg font-bold">
										{row.point}
									</th>
									<td class="bg-brand/8 px-6 py-5 align-top text-lg font-semibold">
										<span class="flex gap-2.5">
											<Check class="text-go mt-1.5" />
											<span class="text-pretty">{row.astro}</span>
										</span>
									</td>
									<td class="text-ink-soft px-6 py-5 align-top text-lg">
										<span class="flex gap-2.5">
											<Cross class="mt-1.5 text-[#c33]" />
											<span class="text-pretty">{row.other}</span>
										</span>
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</Section>

	<!-- ================= USE CASES ================= -->
	<Section tone="card" ruled id="use-cases">
		<SectionHead eyebrow="Who it is for" title="If you serve food, it fits" />
		<div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				USE_CASES.map((u) => (
					<article class="border-ink pin-hover bg-paper overflow-hidden rounded-[1.5rem] border-[2.5px]">
						<FoodImage
							name={u.image}
							alt={u.brief}
							brief={u.brief}
							tone={u.tone}
							ratio="5/4"
							sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 90vw"
						/>
						<div class="border-ink border-t-[2.5px] p-6">
							<h3 class="text-2xl">{u.title}</h3>
							<p class="text-ink-soft mt-2 text-lg text-pretty">{u.body}</p>
						</div>
					</article>
				))
			}
		</div>
	</Section>

	<!-- ================= PRICING ================= -->
	<Section id="pricing">
		<SectionHead
			eyebrow="Pricing"
			title="One plan. Everything in it."
			lede={`${PRICE.monthly} a month, or ${PRICE.annualPerMonth} a month paid yearly. Every competitor in this market makes you ask for a quote — here is the number.`}
			align="center"
		/>
		<div class="mt-12">
			<PricingCard compact />
		</div>

		<div class="mx-auto mt-16 max-w-4xl">
			<h3 class="text-center text-3xl">And what is deliberately left out</h3>
			<p class="text-ink-soft mx-auto mt-3 max-w-2xl text-center text-lg">
				This is the part competitors bury. Saying it plainly is what makes the price believable.
			</p>
			<div class="mt-8 grid gap-4 sm:grid-cols-2">
				{
					NOT_INCLUDED.map((n) => (
						<div class="bg-card slab-sm rounded-2xl p-6">
							<p class="flex items-start gap-2.5 text-lg font-bold">
								<Cross class="mt-1 text-[#c33]" />
								<span>{n.label}</span>
							</p>
							<p class="text-ink-soft mt-2 ps-8 text-base text-pretty">{n.reason}</p>
						</div>
					))
				}
			</div>
		</div>
	</Section>

	<!-- ================= CUSTOMERS ================= -->
	<!-- Driven off VENUES, not off the quotes, so a customer appears here the
	     moment they are added — with their own words if they have given us any,
	     and with ours if they have not. The two are styled differently on
	     purpose: a quote is a blockquote in ink, our description is soft grey
	     body copy with no quotation marks, so nothing we wrote can be mistaken
	     for something a customer said. -->
	<Section tone="sunk" ruled id="customers">
		<SectionHead eyebrow="Real venues" title="They already run on it" />
		<div class="mt-14 grid gap-7 lg:grid-cols-3">
			{
				VENUES.map((v) => {
					const t = testimonialFor(v.id)
					return (
						<figure class="bg-card slab flex flex-col rounded-[1.5rem] p-7">
							<div class="flex items-center gap-4">
								<span class="border-ink bg-paper h-20 w-20 shrink-0 overflow-hidden rounded-2xl border-[2.5px]">
									<VenueLogo name={v.logo} venue={v.name} size={80} />
								</span>
								<figcaption>
									<p class="text-lg font-bold">{t ? t.person : v.name}</p>
									<p class="text-ink-faint text-base">
										{t ? `${v.name} · ${t.role}` : v.kind}
									</p>
								</figcaption>
							</div>
							{t ? (
								<blockquote class="mt-5 grow text-lg leading-relaxed text-pretty">
									“{t.quote}”
								</blockquote>
							) : (
								<p class="text-ink-soft mt-5 grow text-lg leading-relaxed text-pretty">{v.blurb}</p>
							)}
							<p class="mt-5">
								<a
									href={v.menuUrl}
									rel="noopener noreferrer"
									target="_blank"
									class="text-brand-text text-lg font-bold hover:underline"
								>
									View their live menu →
								</a>
							</p>
						</figure>
					)
				})
			}
		</div>
	</Section>

	<!-- ================= FAQ ================= -->
	<Section id="faq">
		<div class="grid gap-14 lg:grid-cols-[0.85fr_1.15fr]">
			<div>
				<SectionHead eyebrow="Questions" title="The ones that<br />actually block a sale" />
				<div class="border-ink slab mt-10 overflow-hidden rounded-[1.5rem]">
					<FoodImage
						name="faq-flatlay"
						alt="Overhead view of a coffee, a pastry and a phone showing a QR menu"
						brief="Overhead flat-lay: coffee, pastry, phone showing the menu"
						tone="warm"
						ratio="4/3"
						sizes="(min-width:1024px) 38vw, 92vw"
					/>
				</div>
				<p class="mt-6 text-lg">
					<a href="/faq" class="text-brand-text font-bold hover:underline">
						Read all {ALL_FAQS.length} questions →
					</a>
				</p>
			</div>
			<div>
				<FaqList items={HOME_FAQS} openFirst />
			</div>
		</div>
	</Section>

	<CtaBand />
</Layout>
