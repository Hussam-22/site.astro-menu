---
import Layout from '../layouts/Layout.astro'
import Section from '../components/ui/Section.astro'
import SectionHead from '../components/ui/SectionHead.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import Button from '../components/ui/Button.astro'
import Sticker from '../components/ui/Sticker.astro'
import FoodImage from '../components/ui/FoodImage.astro'
import Check from '../components/ui/Check.astro'
import CtaBand from '../components/ui/CtaBand.astro'
import { Image } from 'astro:assets'
import { SITE, PRICE } from '../config/site'
import { STEPS, DASHBOARD_CONTROLS } from '../data/plan'
import { crumbSchema } from '../utils/schema'
import menuManagerShot from '../assets/menu-manager.png'

const screenFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', {
	eager: true
})
const screenshot = (file: string) =>
	screenFiles[`../assets/screens/${file}`]?.default as ImageMetadata

const title = 'How it works — from your menu to a QR code'
const description = `Send your menu in any form and we convert it for you by hand. Brand it, print the code, and change it whenever you like — every edit goes live instantly.`

const howTo = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: 'How to set up a QR menu with Astro-Menu',
	description,
	totalTime: 'PT1H',
	estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
	step: STEPS.map((s, i) => ({
		'@type': 'HowToStep',
		position: i + 1,
		name: s.title,
		text: s.body,
		url: `${SITE.domain}/how-it-works#step-${i + 1}`
	}))
}

const NEED = [
	'Your current menu — a PDF, a photo of the printed card, or a spreadsheet',
	'Your logo',
	'A cover photo of the venue',
	'The languages you serve in',
	'Dish photos, eventually — they can be added one at a time later'
]
---

<Layout
	title={title}
	description={description}
	path="/how-it-works"
	schema={[crumbSchema([{ name: 'How it works', path: '/how-it-works' }]), howTo]}
>
	<Section tight>
		<Breadcrumbs trail={[{ name: 'How it works' }]} />
		<div class="mt-8 grid items-start gap-12 lg:grid-cols-[1.15fr_0.85fr]">
			<div>
				<SectionHead
					as="h1"
					eyebrow="How it works"
					title="From your menu<br />to a QR code"
					lede="Four steps. The first one is the only one that takes real work, and it is the one we do for you."
				/>
				<div class="mt-8 flex flex-wrap gap-4">
					<Button href={SITE.signupUrl} size="lg">Start {PRICE.trialDays} days free</Button>
					<Button href="/demo" variant="outline" size="lg">See a finished menu</Button>
				</div>
			</div>
			<div class="border-ink shadow-lift mx-auto w-full max-w-[17rem] overflow-hidden rounded-[1.5rem] border-[3px]">
				<Image
					src={screenshot('landing.png')}
					alt="A finished Astro-Menu venue page with cover photo, logo and one-tap contact buttons"
					widths={[390, 600, 780]}
					sizes="(min-width:1024px) 272px, 80vw"
					class="block h-auto w-full"
				/>
			</div>
		</div>
	</Section>

	<Section tone="card" ruled>
		<SectionHead eyebrow="The four steps" title="What actually happens" />
		<ol class="mt-14 grid gap-7 lg:grid-cols-2">
			{
				STEPS.map((step, i) => (
					<li id={`step-${i + 1}`} class="bg-paper slab slab-hover rounded-[1.5rem] p-8">
						<span class="font-display text-brand text-5xl">{step.n}</span>
						<h2 class="mt-3 text-3xl">{step.title}</h2>
						<p class="text-ink-soft mt-3 text-lg text-pretty">{step.body}</p>
						<p class="border-line text-ink-faint mt-5 border-t pt-4 text-base">{step.detail}</p>
					</li>
				))
			}
		</ol>
	</Section>

	<Section>
		<div class="grid items-start gap-14 lg:grid-cols-2">
			<div>
				<SectionHead
					eyebrow="What we need from you"
					title="Send it in whatever<br />form you have it"
					lede="You do not need to prepare anything. A photo of the printed menu taken on your phone is enough to start."
				/>
				<ul class="mt-8 space-y-4">
					{
						NEED.map((n) => (
							<li class="flex items-start gap-3 text-lg">
								<Check class="text-go mt-1.5" />
								<span class="text-pretty">{n}</span>
							</li>
						))
					}
				</ul>
				<div class="bg-brand/12 slab-sm mt-9 rounded-2xl p-6">
					<p class="text-lg font-bold">We will load the first menu for you.</p>
					<p class="text-ink-soft mt-2 text-lg text-pretty">
						Email it to
						<a href={`mailto:${SITE.email}`} class="text-brand-text font-bold hover:underline"
							>{SITE.email}</a
						> and we will send back a menu ready for you to check, correct and publish.
					</p>
				</div>
			</div>

			<div class="border-ink shadow-lift overflow-hidden rounded-[1.5rem] border-[3px]">
				<FoodImage
					name="onboarding"
					alt="A restaurant owner photographing their printed menu with a phone"
					brief="Owner photographing their printed menu on a phone, counter behind"
					tone="warm"
					ratio="4/3"
					sizes="(min-width:1024px) 45vw, 92vw"
				/>
			</div>
		</div>
	</Section>

	<Section tone="ink">
		<div class="grid items-center gap-14 lg:grid-cols-2">
			<div>
				<SectionHead
					eyebrow="Then it is yours"
					title="Everything is a field<br />in the dashboard"
					lede="Once the menu is loaded, nothing needs us again. Every change is something you make yourself, in seconds, from a phone."
					invert
				/>
				<div class="mt-8 flex flex-wrap gap-2.5">
					{
						DASHBOARD_CONTROLS.map((c, i) => (
							<Sticker tone={i % 4 === 1 ? 'orange' : i % 4 === 3 ? 'rose' : 'outline-light'}>
								{c.title}
							</Sticker>
						))
					}
				</div>
			</div>
			<div class="overflow-hidden rounded-[1.5rem] border-[3px] border-white">
				<Image
					src={menuManagerShot}
					alt="The Astro-Menu dashboard, showing menu sections, item sizes and prices, and an availability toggle on each dish"
					widths={[500, 800, 902]}
					sizes="(min-width:1024px) 45vw, 92vw"
					class="block h-auto w-full"
				/>
			</div>
		</div>
	</Section>

	<CtaBand
		title="Send us the menu you have now"
		body={`We will convert it by hand and send it back ready to check. ${PRICE.trialDays} days free, no card.`}
		secondaryHref="/contact"
		secondaryLabel="Send us your menu"
	/>
</Layout>
