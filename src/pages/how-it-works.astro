---
import Layout from '@layouts/Layout.astro'
import Container from '@components/container.astro'
import Section from '@components/ui/section.astro'
import Breadcrumbs from '@components/ui/breadcrumbs.astro'
import CtaBand from '@components/ui/cta-band.astro'
import FaqList from '@components/ui/faq-list.astro'
import Button from '@components/ui/button.astro'
import { SITE, PLAN } from '@config/site'
import { STEPS } from '@data/plan'

const placements = [
	{ t: 'On the table', b: 'A table tent or a vinyl sticker. The most common placement, and the one people expect.' },
	{ t: 'On the window', b: 'Lets someone read the whole menu before deciding to come in. Strong for passing trade.' },
	{ t: 'At the counter', b: 'People in the queue arrive at the till already knowing what they want.' },
	{ t: 'In your Instagram bio', b: 'The single most valuable link you have. Send it to the menu, not a homepage.' },
	{ t: 'On your Google listing', b: 'Add the menu link so searchers see the real thing instead of a photo someone took.' },
	{ t: 'On packaging and bags', b: 'Turns a delivery customer into someone who can order from you directly next time.' }
]

const faqs = [
	{
		q: 'Do I have to type my whole menu in myself?',
		a: 'Only if you want to. Send us your current menu — a PDF, a photo, a spreadsheet, whatever you have — and we will load the first version for you. After that you edit it yourself.'
	},
	{
		q: 'How long does the first setup take?',
		a: 'Most venues are live the same day. A menu of forty or fifty items typically takes under an hour to enter, less if you send it to us.'
	},
	{
		q: 'Do I need someone technical?',
		a: 'No. If you can fill in an online form and upload a photo, you can run your menu. There is nothing to install and no website to maintain.'
	},
	{
		q: 'What size should I print the QR code?',
		a: 'For a table tent, around 3–4 cm square is comfortable. For a window sticker, larger — people scan it from further away. Download the SVG or PDF so it stays sharp at any size.'
	},
	{
		q: 'Does a diner need an app or an account?',
		a: 'No. The camera app on any modern phone opens the menu in the browser. There is no download, no sign-up and nothing for them to agree to.'
	},
	{
		q: 'What if the QR code sticker gets damaged?',
		a: 'Print another one. The code never changes, so a replacement is identical to the original and costs almost nothing.'
	}
]

// HowTo schema is intentionally absent: Google deprecated HowTo rich results in
// September 2023, and the markup no longer earns a SERP feature.
const schema = [
	{
		'@type': 'ItemList',
		name: 'How to set up a QR menu for your restaurant',
		itemListElement: STEPS.map((step, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: step.title,
			description: step.body,
			url: `${SITE.domain}/how-it-works#step-${i + 1}`
		}))
	},
	{
		'@type': 'FAQPage',
		mainEntity: faqs.map((faq) => ({
			'@type': 'Question',
			name: faq.q,
			acceptedAnswer: { '@type': 'Answer', text: faq.a }
		}))
	}
]

const crumbs = [{ name: 'Home', path: '/' }, { name: 'How it works', path: '/how-it-works' }]
---

<Layout
	title="How It Works — Set Up a QR Menu Today"
	description="How to set up a QR menu: add your items, download the code, put it where people look, and change the menu whenever you like. No app, no hardware, no reprinting."
	schema={schema}
	breadcrumbs={crumbs}
>
	<Container>
		<Breadcrumbs items={crumbs} />

		<Section
			level={1}
			eyebrow="How it works"
			title="From printed menu to live QR menu in an afternoon"
			lede="There is no installation, no hardware and nobody who needs to visit your venue. Here is the whole process."
		>
			<div class="mt-12 space-y-6">
				{
					STEPS.map((step, i) => (
						<div
							id={`step-${i + 1}`}
							class="rounded-xxl flex flex-col gap-6 bg-card p-8 md:flex-row md:items-start md:p-12"
						>
							<span class="text-6xl font-extrabold leading-none text-brandInk md:w-24">
								{i + 1}
							</span>
							<div>
								<h2 class="text-2xl font-extrabold md:text-3xl">{step.title}</h2>
								<p class="mt-3 text-lg text-muted">{step.body}</p>
								<p class="mt-3 text-sm font-medium text-muted">{step.detail}</p>
							</div>
						</div>
					))
				}
			</div>
		</Section>

		<Section
			eyebrow="Placement"
			title="Where to put the code"
			lede="The QR code and the link point at the same menu, so you can use as many of these as you like at once."
		>
			<div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
				{
					placements.map((item) => (
						<div class="rounded-xxl bg-card p-8">
							<h3 class="text-lg font-bold text-ink">{item.t}</h3>
							<p class="mt-2 text-sm text-muted">{item.b}</p>
						</div>
					))
				}
			</div>
		</Section>

		<Section
			eyebrow="See it working"
			title="Scan a real menu before you commit"
			lede="This is a live Astro-Menu menu, exactly as a customer of yours would see it."
		>
			<div class="mt-10 text-center">
				<Button href={SITE.demoMenuUrl} variant="brand" size="lg" target="_blank" rel="noopener">
					Open the demo menu
				</Button>
			</div>
		</Section>

		<Section eyebrow="Questions" title="Setup questions">
			<FaqList faqs={faqs} />
		</Section>

		<CtaBand />
	</Container>
</Layout>
