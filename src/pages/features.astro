---
import Layout from '../layouts/Layout.astro'
import Section from '../components/ui/Section.astro'
import SectionHead from '../components/ui/SectionHead.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import Sticker from '../components/ui/Sticker.astro'
import Check from '../components/ui/Check.astro'
import CtaBand from '../components/ui/CtaBand.astro'
import Ribbon from '../components/ui/Ribbon.astro'
import { Image } from 'astro:assets'
import { SITE, PRICE } from '../config/site'
import { FEATURE_GROUPS } from '../data/features'
import { RIBBON } from '../data/content'
import { crumbSchema } from '../utils/schema'

const screenFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.png', {
	eager: true
})
const screenshot = (file: string) =>
	screenFiles[`../assets/screens/${file}`]?.default as ImageMetadata

const title = 'Features — everything in the QR menu'
const description = `Photos on every dish, portions and prices, automatic translation, allergen tags, filters, calories and analytics — all in one ${PRICE.monthly} plan.`
---

<Layout
	title={title}
	description={description}
	path="/features"
	schema={crumbSchema([{ name: 'Features', path: '/features' }])}
>
	<Section tight>
		<Breadcrumbs trail={[{ name: 'Features' }]} />
		<div class="mt-8 grid items-start gap-10 lg:grid-cols-[1.2fr_0.8fr]">
			<SectionHead
				as="h1"
				eyebrow="Features"
				title="Everything the menu does"
				lede="No tiers, no add-ons, no upsell page. Every feature below is in the one plan, and the price does not move when you use them."
			/>
			<div class="flex flex-wrap gap-2.5 lg:justify-end lg:pt-10">
				<Sticker tone="orange">Unlimited items</Sticker>
				<Sticker tone="rose">Every language</Sticker>
				<Sticker>One QR forever</Sticker>
				<Sticker tone="go">No commission</Sticker>
			</div>
		</div>

		<nav aria-label="Feature sections" class="mt-10 flex flex-wrap gap-2.5">
			{
				FEATURE_GROUPS.map((g) => (
					<a
						href={`#${g.id}`}
						class="border-ink bg-card hover:bg-brand rounded-full border-[2.5px] px-4 py-2 text-base font-bold transition-colors"
					>
						{g.eyebrow}
					</a>
				))
			}
		</nav>
	</Section>

	<Ribbon items={RIBBON} />

	{
		FEATURE_GROUPS.map((group, i) => (
			<Section id={group.id} tone={i % 2 === 1 ? 'card' : 'paper'} ruled={i % 2 === 1}>
				<div
					class:list={[
						'grid gap-12',
						group.screen ? 'lg:grid-cols-[1fr_20rem] lg:gap-16' : ''
					]}
				>
					<div>
						<SectionHead eyebrow={group.eyebrow} title={group.title} lede={group.lede} />
						<dl class="mt-10 grid gap-x-10 gap-y-7 sm:grid-cols-2">
							{group.items.map((item) => (
								<div class="border-ink border-t-[2.5px] pt-4">
									<dt class="flex items-start gap-2.5 text-xl font-bold">
										<Check class="text-go mt-1.5" />
										<span>{item.title}</span>
									</dt>
									<dd class="text-ink-soft mt-2 pl-8 text-lg text-pretty">{item.body}</dd>
								</div>
							))}
						</dl>
					</div>

					{group.screen && (
						<div class="border-ink shadow-lift mx-auto w-full max-w-[19rem] overflow-hidden rounded-[1.5rem] border-[3px] lg:sticky lg:top-28">
							<Image
								src={screenshot(group.screen)}
								alt={`${group.title} — shown on a real customer menu`}
								widths={[390, 600, 780]}
								sizes="(min-width:1024px) 320px, 90vw"
								class="block h-auto w-full"
							/>
						</div>
					)}
				</div>
			</Section>
		))
	}

	<Section tone="ink">
		<div class="grid items-center gap-10 lg:grid-cols-[1.3fr_0.7fr]">
			<SectionHead
				eyebrow="See it working"
				title="Reading about it is not the same<br />as scanning it"
				lede={`Open the live menu of ${SITE.demoVenueName} — 120 items, fourteen sections, filters and language switching, all running on the plan described above.`}
				invert
			/>
			<div class="flex flex-wrap gap-4 lg:justify-end">
				<a
					href="/demo"
					class="brand-gradient border-ink inline-flex items-center rounded-full border-[2.5px] px-9 py-4 text-xl font-bold text-white shadow-[4px_4px_0_#fff] transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5"
				>
					Try the live demo
				</a>
			</div>
		</div>
	</Section>

	<CtaBand
		title="All of it, for one flat price"
		body={`${PRICE.monthly} a month, or ${PRICE.annualPerMonth} a month paid yearly. ${PRICE.trialDays} days free first, no card.`}
		secondaryHref="/pricing"
		secondaryLabel="See pricing"
	/>
</Layout>
