---
import Layout from '@layouts/Layout.astro'
import Container from '@components/container.astro'
import Section from '@components/ui/section.astro'
import Breadcrumbs from '@components/ui/breadcrumbs.astro'
import Check from '@components/ui/icons/check.astro'
import Cross from '@components/ui/icons/cross.astro'
import CtaBand from '@components/ui/cta-band.astro'
import Button from '@components/ui/button.astro'
import ProductGallery from '@components/product-gallery.astro'
import { PLAN, PRICE } from '@config/site'
import { NOT_INCLUDED } from '@data/plan'

const groups = [
	{
		heading: 'The menu itself',
		items: [
			{
				t: 'Unlimited items and sections',
				b: 'Build the menu you actually have, not the one that fits on two printed sides. Starters, mains, drinks, sides, set menus — as many sections as you need.'
			},
			{
				t: 'A photo on every item',
				b: 'Upload a picture for each dish or drink. Images are compressed and resized automatically so the menu still loads fast on mobile data.'
			},
			{
				t: 'Full descriptions',
				b: 'Room to describe a dish properly — ingredients, spice level, portion size, origin of the beans. None of it costs you page space.'
			},
			{
				t: 'Dietary and allergen tags',
				b: 'Mark items vegetarian, vegan, gluten-free, nut-free or halal, and let guests filter the menu down to what they can actually eat.'
			},
			{
				t: 'Filter by meal type',
				b: 'Guests narrow the menu themselves — hot drinks, cold drinks, decaf, light portions, healthy, sweet — instead of scrolling past everything they did not come for.'
			},
			{
				t: 'Sizes and portions with prices',
				b: 'List small, regular and large — or 8oz and 12oz, or by weight — each with its own price, without cluttering the layout.'
			},
			{
				t: 'Add-ons, free or paid',
				b: 'Offer a choice of beans at no charge, or a side for three dirhams. Each add-on carries its own price, or none at all.'
			},
			{
				t: 'Calories and macros',
				b: 'Show calories, protein, carbs and fat on each item. Optional, and worth turning on for healthy eating, fitness and meal-prep menus.'
			},
			{
				t: 'Hide and unhide instantly',
				b: 'When the kitchen runs out, switch the item off. It disappears from the live menu immediately and comes back when you say so.'
			}
		]
	},
	{
		heading: 'Languages',
		items: [
			{
				t: 'Automatic translation',
				b: 'Write your menu once. Guests read it in the language their phone is set to, without you printing or maintaining a second version.'
			},
			{
				t: 'Arabic and English as standard',
				b: 'Both are set up from the start, which covers most of the room in the UAE before you add anything else.'
			},
			{
				t: 'Add any other language',
				b: 'Hindi, Urdu, Malayalam, Tagalog, Russian, Chinese, German — whatever your customers actually read.'
			},
			{
				t: 'Edit any translation',
				b: 'Machine translation is a starting point. Where a dish name matters, override it with your own wording.'
			}
		]
	},
	{
		heading: 'QR codes and sharing',
		items: [
			{
				t: 'A dynamic QR code',
				b: 'The code points at your menu, not a version of it. Print it once and it keeps working through every future change.'
			},
			{
				t: 'Print-ready downloads',
				b: 'PNG, SVG and PDF at any size — sized properly for table tents, window stickers, packaging and flyers.'
			},
			{
				t: 'A shareable link',
				b: 'A normal URL that works in your Instagram bio, a WhatsApp reply, your Google listing, an email or your own website.'
			},
			{
				t: 'A link that never breaks',
				b: 'The address stays the same for the life of your account, so a code printed on packaging keeps working long after the menu has changed.'
			}
		]
	},
	{
		heading: 'Your menu page',
		items: [
			{
				t: 'Your branding',
				b: 'Your name, your logo, your photos and your colours. The page reads as yours, not as a template with your name typed into it.'
			},
			{
				t: 'Wi-Fi password on the menu',
				b: 'Put it where guests will look, and save your staff from being asked twenty times an evening.'
			},
			{
				t: 'Social and contact links',
				b: 'Instagram, WhatsApp, phone, directions and opening hours, all on the same page as the menu.'
			},
			{
				t: 'Built for phones first',
				b: 'Readable the moment it opens. No pinching, no zooming, no downloading a file to a Downloads folder.'
			}
		]
	},
	{
		heading: 'Knowing what works',
		items: [
			{
				t: 'Menu view counts',
				b: 'How many people opened your menu, and when. Useful for seeing whether a QR placement is actually being scanned.'
			},
			{
				t: 'Most-viewed items',
				b: 'Which dishes people are looking at most — the closest thing to watching someone read your menu over their shoulder.'
			},
			{
				t: 'Peak viewing times',
				b: 'When your menu gets read, which is often earlier than when your tables fill up.'
			},
			{
				t: 'No diner tracking',
				b: 'We count menu activity, not people. There is no diner login, no personal data collected and nothing to consent to.'
			}
		]
	},
	{
		heading: 'Reach',
		items: [
			{
				t: 'One link you control',
				b: 'A single menu everyone points at — your Google listing, your Instagram bio, your website, a WhatsApp reply — instead of four half-current versions.'
			},
			{
				t: 'The menu behind your Google listing',
				b: 'Paste your link into your Business Profile and the Menu button opens your real menu, rather than photos of a board or a delivery app’s copy.'
			},
			{
				t: 'Fast on mobile',
				b: 'Compressed images and a menu built for phones, because a menu that takes six seconds to open is a menu people close.'
			},
			{
				t: 'No app, no account',
				b: 'The diner scans and reads. Nothing to install, nothing to sign up for, nothing to consent to.'
			}
		]
	}
]
---

<Layout
	title="Features — Everything in the One Plan"
	description={`Photos on every item, calories and macros, automatic translation, dietary filters, dynamic QR codes and menu analytics. All included at ${PRICE.monthly} a month.`}
	breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Features', path: '/features' }]}
>
	<Container>
		<Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Features', path: '/features' }]} />

		<Section
			level={1}
			eyebrow="Features"
			title="Everything Astro-Menu does"
			lede={`All of it is in the one plan at ${PRICE.monthly} a month. There is no feature matrix to compare and no tier to upgrade into.`}
		/>

		<ProductGallery title="Seen on a real menu" />

		{
			groups.map((group) => (
				<section class="pb-16">
					<h2 class="text-2xl font-extrabold text-ink md:text-3xl">{group.heading}</h2>
					<div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
						{group.items.map((item) => (
							<div class="rounded-xxl bg-card p-8">
								<Check class="h-5 w-5 text-green-500" />
								<h3 class="mt-3 text-lg font-bold text-ink">{item.t}</h3>
								<p class="mt-2 text-sm leading-relaxed text-muted">{item.b}</p>
							</div>
						))}
					</div>
				</section>
			))
		}

		<Section
			eyebrow="Honesty"
			title="And here is what it does not do"
			lede="Worth reading before you sign up, because for some venues these are dealbreakers — and we would rather you found out now."
		>
			<div class="mt-12 grid gap-4 md:grid-cols-2">
				{
					NOT_INCLUDED.map((item) => (
						<div class="rounded-xxl bg-card p-8">
							<div class="flex items-center gap-3">
								<Cross class="h-5 w-5 flex-none text-brandInk" />
								<h3 class="text-lg font-bold">{item.label}</h3>
							</div>
							<p class="mt-3 text-muted">{item.reason}</p>
						</div>
					))
				}
			</div>
			<p class="mx-auto mt-8 max-w-2xl text-center text-muted">
				If you need order taking and payments in the same product, Astro-Menu is not the right tool
				and we will tell you so.
			</p>
			<div class="mt-8 text-center">
				<Button href="/pricing" variant="outline" class="text-ink">See the price</Button>
			</div>
		</Section>

		<CtaBand />
	</Container>
</Layout>
