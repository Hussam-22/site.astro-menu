---
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/ui/Section.astro'
import SectionHead from '../../components/ui/SectionHead.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import FaqList from '../../components/ui/FaqList.astro'
import CtaBand from '../../components/ui/CtaBand.astro'
import { SITE, PRICE } from '../../config/site'
import { FAQ_GROUPS, ALL_FAQS } from '../../data/faqs'
import { crumbSchema, faqSchema } from '../../utils/schema'

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')

const groups = FAQ_GROUPS.map((g) => ({
	...g,
	items: g.items.map((f) => ({ ...f, q: f.qAr, a: f.aAr, aSy: f.aArSy }))
}))
const allFaqsAr = ALL_FAQS.map((f) => ({ ...f, q: f.qAr, a: f.aAr, aSy: f.aArSy }))

const title = 'الأسئلة الشائعة — إجابات عن قائمة طعام QR'
const description = `${ALL_FAQS.length} إجابة مباشرة: التكلفة (${PRICE.monthly} شهريًا)، هل يحتاج رمز QR إعادة طباعة، القوائم بالعربية، عدد اللغات المشمولة والعمولة.`
---

<Layout
	title={title}
	description={description}
	path="/ar/faq"
	schema={[crumbSchema([{ name: 'الأسئلة الشائعة', path: '/ar/faq' }]), faqSchema(allFaqsAr)]}
>
	<Section tight>
		<Breadcrumbs trail={[{ name: 'الأسئلة الشائعة' }]} />
		<div class="mt-8">
			<SectionHead
				as="h1"
				eyebrow="الأسئلة الشائعة"
				title="إجابات مباشرة"
				lede="كل الأسئلة التي تُطرح قبل الاشتراك، بإجابات واضحة — بما فيها الأسئلة التي نفضّل أن تُطرح مبكرًا، مثل ما لا تفعله استرو منيو عن قصد."
			/>
		</div>
		<nav aria-label="أقسام الأسئلة الشائعة" class="mt-10 flex flex-wrap gap-2.5">
			{
				groups.map((g) => (
					<a
						href={`#${slug(g.heading)}`}
						class="border-ink bg-card hover:bg-brand rounded-full border-[2.5px] px-4 py-2 text-base font-bold transition-colors"
					>
						{g.headingAr}
					</a>
				))
			}
		</nav>
	</Section>

	{
		groups.map((group, i) => (
			<Section id={slug(group.heading)} tone={i % 2 === 1 ? 'card' : 'paper'} ruled={i % 2 === 1} tight>
				<div class="grid gap-10 lg:grid-cols-[0.55fr_1.45fr]">
					<h2 class="text-4xl lg:sticky lg:top-28 lg:self-start">{group.headingAr}</h2>
					<FaqList items={group.items} />
				</div>
			</Section>
		))
	}

	<Section tight>
		<div class="bg-brand/12 slab mx-auto max-w-3xl rounded-[1.5rem] p-9 text-center">
			<h2 class="text-3xl">ما لقيت جواب سؤالك؟</h2>
			<p class="text-ink-soft mt-3 text-lg text-pretty">راسلنا ورح يردّ عليك شخص فعلي — عادة بنفس اليوم.</p>
			<p class="mt-5">
				<a href={`mailto:${SITE.email}`} class="text-brand-text text-xl font-bold hover:underline">
					{SITE.email}
				</a>
			</p>
		</div>
	</Section>

	<CtaBand />
</Layout>
