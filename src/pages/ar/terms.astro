---
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/ui/Section.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import { SITE } from '../../config/site'
import { crumbSchema } from '../../utils/schema'

const updated = '18 أغسطس 2026'
const title = 'الشروط والأحكام'
const description =
	'شروط استخدام أسترو مينيو: ما الذي يتضمنه الاشتراك، كيف تعمل الفوترة والإلغاء، ومسؤولية كل طرف.'
---

<Layout
	title={title}
	description={description}
	path="/ar/terms"
	schema={crumbSchema([{ name: 'الشروط والأحكام', path: '/ar/terms' }])}
>
	<Section width="narrow" tight>
		<Breadcrumbs trail={[{ name: 'الشروط والأحكام' }]} />
		<h1 class="mt-8 text-5xl sm:text-6xl">الشروط والأحكام</h1>
		<p class="text-ink-faint mt-4 text-base">آخر تحديث {updated}</p>

		<div
			class="prose prose-lg prose-headings:font-display prose-headings:font-normal prose-h2:mt-10 prose-h2:text-2xl prose-p:text-ink-soft prose-li:text-ink-soft prose-strong:text-ink prose-a:text-brand-text prose-a:font-bold mt-10 max-w-none"
		>
			<h2>ما هي الخدمة</h2>
			<p>
				تستضيف أسترو مينيو قائمة رقمية لمنشأتك وتمنحك لوحة تحكم لتعديلها، بالإضافة إلى كود QR ورابط
				يشيران إليها. إنها قائمة فقط. لا تستقبل طلبات، ولا تعالج مدفوعات، ولا تحل محل نظام الكاشير،
				ولا نأخذ عمولة أبدًا على أي شيء تبيعه.
			</p>

			<h2>حسابك</h2>
			<p>
				أنت مسؤول عن الحفاظ على سرية بيانات دخولك، وعن كل ما يُنشر على قائمتك — الأسعار والأوصاف
				ومعلومات الحساسية والصور. تؤكد أن لديك الحق في استخدام أي محتوى ترفعه.
			</p>

			<h2>الفوترة</h2>
			<ul>
				<li>تُفوتَر الاشتراكات شهريًا أو سنويًا مقدمًا، بالسعر المعروض عند الاشتراك.</li>
				<li>
					الفترة التجريبية المجانية لا تتطلب بطاقة، وتتحول إلى اشتراك مدفوع فقط إذا اخترت
					الاستمرار.
				</li>
				<li>قد تتغيّر الأسعار؛ يُخبَر المشتركون الحاليون قبل أن يؤثر أي تغيير عليهم.</li>
			</ul>

			<h2>الإلغاء</h2>
			<p>
				ألغِ من لوحة التحكم في أي وقت. لا توجد فترة إشعار ولا رسوم خروج. تتوقف قائمتك عن الخدمة في
				نهاية الفترة المدفوعة ويتوقف كود QR عن العمل. نحتفظ ببيانات قائمتك لفترة معقولة بعد ذلك، حتى
				تتمكن من العودة.
			</p>

			<h2>التوفر</h2>
			<p>
				نعمل على إبقاء القوائم متاحة طوال الوقت، لكننا لا نضمن خدمة بلا انقطاع. تُجدوَل الصيانة
				المخطط لها خارج ساعات الذروة قدر الإمكان.
			</p>

			<h2>الاستخدام المقبول</h2>
			<p>
				لا تستخدم أسترو مينيو لنشر محتوى غير قانوني، أو لانتحال شخصية منشأة أخرى، أو لمحاولة تعطيل
				الخدمة عن آخرين. قد نعلّق حسابًا يفعل ذلك.
			</p>

			<h2>المسؤولية</h2>
			<p>
				تُقدَّم أسترو مينيو كما هي. ضمن الحدود التي يسمح بها القانون، تقتصر مسؤوليتنا على المبلغ
				الذي دفعته لنا خلال الاثني عشر شهرًا السابقة للمطالبة. لا شيء هنا يحد من مسؤولية لا يمكن
				تحديدها قانونيًا.
			</p>

			<h2>التواصل</h2>
			<p>
				أسئلة حول هذه الشروط: <a href={'mailto:' + SITE.email}>{SITE.email}</a>.
			</p>
		</div>
	</Section>
</Layout>
