---
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/ui/Section.astro'
import SectionHead from '../../components/ui/SectionHead.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import Button from '../../components/ui/Button.astro'
import Sticker from '../../components/ui/Sticker.astro'
import FoodImage from '../../components/ui/FoodImage.astro'
import Check from '../../components/ui/Check.astro'
import CtaBand from '../../components/ui/CtaBand.astro'
import { Image } from 'astro:assets'
import { SITE, PRICE } from '../../config/site'
import { STEPS, DASHBOARD_CONTROLS } from '../../data/plan'
import { crumbSchema } from '../../utils/schema'
import DashboardImage from '../../components/ui/DashboardImage.astro'

const screenFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/screens/*.png', {
	eager: true
})
const screenshot = (file: string) =>
	screenFiles[`../../assets/screens/${file}`]?.default as ImageMetadata

const title = 'كيف تعمل — من قائمة طعامك إلى رمز QR'
const description = `ابعتلنا منيو مطعمك بأي شكل عندك، ونحن منجهّزها لك يدويًا. زيد هوية مطعمك، اطبع الرمز، وغيّر أي شي وقتما بدك — كل تعديل بيظهر فورًا.`

const howTo = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: 'كيف تجهّز قائمة QR مع أسترو مينيو',
	description,
	totalTime: 'PT1H',
	estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
	step: STEPS.map((s, i) => ({
		'@type': 'HowToStep',
		position: i + 1,
		name: s.titleAr,
		text: s.bodyAr,
		url: `${SITE.domain}/ar/how-it-works#step-${i + 1}`
	}))
}

const NEED = [
	'منيو مطعمك الحالية — ملف PDF، صورة للقائمة المطبوعة، أو حتى جدول بيانات',
	'شعار مطعمك',
	'صورة غلاف للمكان',
	'اللغات التي تتعامل بها مع زبائنك',
	'صور الأطباق، لاحقًا — تقدر تضيفها صنفًا صنفًا بعدين'
]
---

<Layout
	title={title}
	description={description}
	path="/ar/how-it-works"
	schema={[crumbSchema([{ name: 'كيف تعمل', path: '/ar/how-it-works' }]), howTo]}
>
	<Section tight>
		<Breadcrumbs trail={[{ name: 'كيف تعمل' }]} />
		<div class="mt-8 grid items-start gap-12 lg:grid-cols-[1.15fr_0.85fr]">
			<div>
				<SectionHead
					as="h1"
					eyebrow="كيف تعمل"
					title="من منيوك<br />إلى رمز QR"
					lede="أربع خطوات بس. الأولى هي الوحيدة يلي فيها شغل حقيقي، وهاي إحنا يلي منعملها بدالك."
				/>
				<div class="mt-8 flex flex-wrap gap-4">
					<Button href={SITE.signupUrl} size="lg">ابدأ {PRICE.trialDays} يومًا مجانًا</Button>
					<Button href="/ar/demo" variant="outline" size="lg">شاهد منيو جاهزة</Button>
				</div>
			</div>
			<div class="border-ink shadow-lift mx-auto w-full max-w-[17rem] overflow-hidden rounded-[1.5rem] border-[3px]">
				<Image
					src={screenshot('landing.png')}
					alt="صفحة منشأة جاهزة على أسترو مينيو بصورة غلاف وشعار وأزرار تواصل بلمسة واحدة"
					widths={[390, 600, 780]}
					sizes="(min-width:1024px) 272px, 80vw"
					class="block h-auto w-full"
				/>
			</div>
		</div>
	</Section>

	<Section tone="card" ruled>
		<SectionHead eyebrow="الخطوات الأربع" title="شو يلي بيصير بالضبط" />
		<ol class="mt-14 grid gap-7 lg:grid-cols-2">
			{
				STEPS.map((step, i) => (
					<li id={`step-${i + 1}`} class="bg-paper slab slab-hover rounded-[1.5rem] p-8">
						<span class="font-display text-brand text-5xl">{step.n}</span>
						<h2 class="mt-3 text-3xl">{step.titleAr}</h2>
						<p class="text-ink-soft mt-3 text-lg text-pretty">{step.bodyAr}</p>
						<p class="border-line text-ink-faint mt-5 border-t pt-4 text-base">{step.detailAr}</p>
					</li>
				))
			}
		</ol>
	</Section>

	<Section>
		<div class="grid items-start gap-14 lg:grid-cols-2">
			<div>
				<SectionHead
					eyebrow="شو بدنا منك"
					title="ابعتها بأي شكل<br />هي عندك فيه"
					lede="ما في داعي تحضّر شي. صورة للقائمة المطبوعة بموبايلك كافية نبدأ فيها."
				/>
				<ul class="mt-8 space-y-4">
					{
						NEED.map((n) => (
							<li class="flex items-start gap-3 text-lg">
								<Check class="text-go mt-1.5" />
								<span class="text-pretty">{n}</span>
							</li>
						))
					}
				</ul>
				<div class="bg-brand/12 slab-sm mt-9 rounded-2xl p-6">
					<p class="text-lg font-bold">نحن منرتب لك المنيو الأولى بأنفسنا.</p>
					<p class="text-ink-soft mt-2 text-lg text-pretty">
						ابعتها على{' '}
						<a href={`mailto:${SITE.email}`} class="text-brand-text font-bold hover:underline"
							>{SITE.email}</a
						> ومنرجعلك منيو جاهزة تراجعها، تصحّح فيها، وتنشرها.
					</p>
				</div>
			</div>

			<div class="border-ink shadow-lift overflow-hidden rounded-[1.5rem] border-[3px]">
				<FoodImage
					name="onboarding"
					alt="صاحب مطعم يصوّر قائمته المطبوعة بهاتفه"
					brief="Owner photographing their printed menu on a phone, counter behind"
					tone="warm"
					ratio="4/3"
					sizes="(min-width:1024px) 45vw, 92vw"
				/>
			</div>
		</div>
	</Section>

	<Section tone="ink">
		<div class="grid items-center gap-14 lg:grid-cols-2">
			<div>
				<SectionHead
					eyebrow="وبعدها بتصير إلك بالكامل"
					title="كل شي حقل<br />بلوحة التحكم"
					lede="أول ما ترفع المنيو، ما رح تحتاجنا كمان. كل تعديل بتعمله بنفسك، بثوانٍ، من موبايلك."
					invert
				/>
				<div class="mt-8 flex flex-wrap gap-2.5">
					{
						DASHBOARD_CONTROLS.map((c, i) => (
							<Sticker tone={i % 4 === 1 ? 'orange' : i % 4 === 3 ? 'rose' : 'outline-light'}>
								{c.titleAr}
							</Sticker>
						))
					}
				</div>
			</div>
			<DashboardImage
				name="dash-sections"
				alt="لوحة تحكم أسترو مينيو أثناء بناء قائمة: أقسام مضافة ومملوءة بالأصناف والأسعار"
				brief="Building a menu: sections added, reordered and filled with items"
				frame="light"
				sizes="(min-width:1024px) 45vw, 92vw"
				widths={[600, 900, 1400]}
			/>
		</div>
	</Section>

	<CtaBand
		title="ابعتلنا المنيو اللي عندك هلق"
		body={`منرتبها لك يدويًا ومنرجعلك إياها جاهزة للمراجعة. ${PRICE.trialDays} يومًا مجانًا، بلا بطاقة.`}
		secondaryHref="/ar/contact"
		secondaryLabel="ابعتلنا منيوك"
	/>
</Layout>
