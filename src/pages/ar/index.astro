---
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/ui/Section.astro'
import SectionHead from '../../components/ui/SectionHead.astro'
import Button from '../../components/ui/Button.astro'
import Sticker from '../../components/ui/Sticker.astro'
import Burst from '../../components/ui/Burst.astro'
import Ribbon from '../../components/ui/Ribbon.astro'
import FoodImage from '../../components/ui/FoodImage.astro'
import Check from '../../components/ui/Check.astro'
import Cross from '../../components/ui/Cross.astro'
import FaqList from '../../components/ui/FaqList.astro'
import CtaBand from '../../components/ui/CtaBand.astro'
import PricingCard from '../../components/PricingCard.astro'
import { Image } from 'astro:assets'
import { SITE, PRICE } from '../../config/site'
import {
	PILLARS,
	VENUES,
	VERSUS,
	USE_CASES,
	SCREENS,
	RIBBON_AR,
	venue,
	testimonialFor
} from '../../data/content'
import VenueLogo from '../../components/ui/VenueLogo.astro'
import { DASHBOARD_CONTROLS, NOT_INCLUDED } from '../../data/plan'
import { HOME_FAQS, ALL_FAQS } from '../../data/faqs'
import DashboardImage from '../../components/ui/DashboardImage.astro'

const screenFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/screens/*.png', {
	eager: true
})
const screenshot = (file: string) =>
	screenFiles[`../../assets/screens/${file}`]?.default as ImageMetadata

const homeFaqsAr = HOME_FAQS.map((f) => ({ ...f, q: f.qAr, a: f.aAr }))

const title = 'قائمة QR للمطاعم والمقاهي'
const description = `حوّل قائمتك إلى قائمة QR سريعة، مصممة بالصور، تحدّثها خلال ثوانٍ. كل لغة، رمز QR واحد لا يحتاج إعادة طباعة أبدًا. ${PRICE.monthly} شهريًا، بلا عمولة.`

const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'Astro-Menu',
		applicationCategory: 'BusinessApplication',
		applicationSubCategory: 'قائمة QR رقمية',
		operatingSystem: 'Web browser',
		url: `${SITE.domain}/ar`,
		description:
			'منيو QR للمطاعم والمقاهي، سهلة التحديث وتعمل بسرعة على الموبايل — بالصور والأسعار وبأي لغة يحتاجها زبائنك.',
		featureList: [
			'قائمة QR',
			'منيو غير محدودة بأقسامها وأصنافها',
			'ترجمة تلقائية تشمل العربية',
			'وسوم الحساسية والنظام الغذائي',
			'فلاتر أنواع الوجبات',
			'السعرات والقيم الغذائية لكل صنف',
			'تحليلات المنيو'
		],
		offers: {
			'@type': 'Offer',
			price: String(PRICE.monthlyAmount),
			priceCurrency: 'USD',
			url: `${SITE.domain}/ar/pricing`,
			availability: 'https://schema.org/InStock',
			priceSpecification: {
				'@type': 'UnitPriceSpecification',
				price: String(PRICE.monthlyAmount),
				priceCurrency: 'USD',
				unitCode: 'MON',
				billingIncrement: 1
			}
		}
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: homeFaqsAr.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a }
		}))
	}
]
---

<Layout title={title} description={description} path="/ar" schema={schema}>
	<!-- ================= HERO ================= -->
	<section class="relative overflow-hidden pt-14 pb-8 lg:pt-20">
		<div class="mx-auto max-w-7xl px-5 lg:px-8">
			<div class="flex flex-wrap items-center gap-2.5">
				<Sticker tone="orange">بلا عمولة</Sticker>
				<Sticker tone="rose">نبنيها لك</Sticker>
				<Sticker>بلا تطبيق يُحمَّل</Sticker>
			</div>

			<h1 class="mt-7 text-[3.4rem] leading-[0.9] sm:text-8xl lg:text-[8.5rem]">
				أظهر{' '}<span
					class="border-ink hidden h-[0.82em] w-[0.82em] shrink-0 -translate-y-[0.04em] place-items-center overflow-hidden rounded-full border-[3px] align-middle sm:inline-grid"
				>
					<FoodImage
						name="hero-cut"
						alt=""
						ratio="1"
						tone="brand"
						priority={true}
						widths={[200, 400]}
						sizes="120px"
					/>
				</span>{' '}الطعام،<br />لا القائمة النصية<span class="text-brand-text">.</span>
			</h1>

			<div class="mt-12 grid items-start gap-12 lg:grid-cols-[1.15fr_0.85fr]">
				<div>
					<p class="text-ink-soft max-w-xl text-xl leading-relaxed text-pretty sm:text-2xl">
						أرسل لنا القائمة التي لديك الآن ونحوّلها إلى قائمة QR مصممة بالصور نيابة عنك. بعدها
						تصبح ملكك — كل تعديل تقوم به يُنشر لحظة حفظه. سعر ثابت واحد. بلا نظام نقاط بيع، بلا
						عمولة، بلا أجهزة.
					</p>

					<div class="mt-8 flex flex-wrap gap-4">
						<Button href={SITE.signupUrl} size="lg">ابدأ {PRICE.trialDays} يومًا مجانًا</Button>
						<Button href="/ar/demo" variant="outline" size="lg">شاهد قائمة حقيقية</Button>
					</div>
					<p class="text-ink-faint mt-4 text-base">
						بلا بطاقة مطلوبة · {PRICE.monthly} شهريًا بعدها · ألغِ في أي وقت
					</p>

					<div class="border-line mt-10 flex flex-wrap items-center gap-x-10 gap-y-6 border-t pt-8">
						<div>
							<p class="font-display text-5xl">+120</p>
							<p class="text-ink-soft text-base font-semibold">صنفًا على قائمة حيّة واحدة</p>
						</div>
						<div>
							<p class="font-display text-5xl">&lt;1ث</p>
							<p class="text-ink-soft text-base font-semibold">للتحميل على الهاتف</p>
						</div>
						<div class="flex items-center gap-3">
							<div class="flex">
								{
									['owner', 'staff', 'guests'].map((n, i) => (
										<span
											class:list={[
												'border-paper h-12 w-12 overflow-hidden rounded-full border-[3px]',
												i > 0 && '-ms-4'
											]}
										>
											<FoodImage
												name={n}
												alt=""
												ratio="1"
												tone={i === 1 ? 'brand' : i === 2 ? 'dark' : 'warm'}
												widths={[100, 200]}
												sizes="48px"
											/>
										</span>
									))
								}
							</div>
							<div>
								<p class="text-base font-bold">منشآت حقيقية، قوائم حقيقية</p>
								<p class="text-ink-faint text-base">مقاهٍ · عربات · فنادق</p>
							</div>
						</div>
					</div>
				</div>

				<div class="flex justify-center lg:justify-end">
					<div class="relative w-full max-w-[19rem]">
						<Burst class="absolute -top-5 -start-8 z-20" size={7.5} rotate={-13}>
							{PRICE.trialDays} يومًا<br />مجانًا
						</Burst>

						<!-- No drop shadow here. The hero section is overflow-hidden, so a soft
						     shadow gets sliced off at its right and bottom edges and reads as a grey
						     rectangle around the phone rather than as depth. The 3px ink border
						     carries the lift instead, which is the house style anyway. -->
						<div class="border-ink relative rounded-[2.75rem] border-[3px] bg-black p-2.5">
							<div
								class="absolute top-4 left-1/2 z-10 h-6 w-24 -translate-x-1/2 rounded-full bg-black"
							>
							</div>
							<div class="overflow-hidden rounded-[2.1rem] bg-white">
								<Image
									src={screenshot('menu-sections.png')}
									alt={`قائمة ${SITE.demoVenueName} الحية على الهاتف، تُظهر شرائح الأقسام وأطباقًا بصور وأسعار`}
									widths={[390, 600, 780]}
									sizes="304px"
									loading="eager"
									fetchpriority="high"
									class="block h-auto w-full"
								/>
							</div>
						</div>

						<div
							class="border-ink absolute -bottom-9 -start-10 z-20 w-40 -rotate-[8deg] overflow-hidden rounded-2xl border-[3px] sm:w-44"
						>
							<FoodImage
								name="hero-float"
								alt=""
								ratio="4/3"
								tone="warm"
								brief="Hands holding a burger, cut out on colour"
								widths={[300, 500]}
								sizes="176px"
							/>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<div class="mt-20">
		<Ribbon items={RIBBON_AR} />
	</div>

	<!-- ================= WHY / PILLARS ================= -->
	<Section id="why">
		<SectionHead
			eyebrow="لماذا أسترو مينيو"
			title="الجميع على الطاولة يربح"
			lede="المالك يتوقف عن إعادة الطباعة. الطاقم يتوقف عن الاعتذار. الضيف يتوقف عن التحديق في ملف PDF."
		/>
		<div class="mt-14 grid gap-7 md:grid-cols-3">
			{
				PILLARS.map((p) => (
					<article class="bg-card slab slab-hover overflow-hidden rounded-[1.75rem]">
						<div class="border-ink border-b-[2.5px]">
							<FoodImage
								name={p.image}
								alt={p.brief}
								brief={p.brief}
								tone={p.tone}
								ratio="16/10"
								sizes="(min-width:768px) 33vw, 100vw"
							/>
						</div>
						<div class="p-7">
							<Sticker tone={p.tone === 'dark' ? 'ink' : 'orange'} size="sm">
								{p.whoAr}
							</Sticker>
							<h3 class="mt-4 text-3xl">{p.titleAr}</h3>
							<p class="text-ink-soft mt-3 text-lg text-pretty">{p.bodyAr}</p>
						</div>
					</article>
				))
			}
		</div>
	</Section>

	<!-- ================= WHAT GUESTS SEE ================= -->
	<Section tone="card" ruled id="menu">
		<SectionHead
			eyebrow="ما يراه ضيوفك"
			title="ستة شاشات.<br />كلها حقيقية."
			lede={`كل شاشة أدناه هي قائمة زبون حقيقية تعمل على أسترو مينيو اليوم، معظمها ${SITE.demoVenueName}، 120 صنفًا حيًّا في العين. لا شيء هنا محاكاة.`}
		/>
		<div class="masonry mt-14 sm:columns-2 lg:columns-3">
			{
				SCREENS.map((s) => (
					<figure class="border-ink pin-hover bg-paper overflow-hidden rounded-[1.5rem] border-[2.5px]">
						<Image
							src={screenshot(s.file)}
							alt={`${s.titleAr} — ${s.bodyAr}`}
							widths={[390, 600, 780]}
							sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 90vw"
							class="block h-auto w-full"
						/>
						<figcaption class="border-ink border-t-[2.5px] p-5">
							<h3 class="text-xl">{s.titleAr}</h3>
							<p class="text-ink-soft mt-1.5 text-base text-pretty">{s.bodyAr}</p>
							{'credit' in s && (
								<p class="text-ink-faint mt-2 text-base">
									معروضة على{' '}
									<a
										href={venue(s.credit).menuUrl}
										rel="noopener noreferrer"
										target="_blank"
										class="font-bold hover:underline"
									>
										{venue(s.credit).nameAr}
									</a>
								</p>
							)}
						</figcaption>
					</figure>
				))
			}
		</div>
		<div class="mt-12 flex flex-wrap justify-center gap-4">
			<Button href={SITE.demoMenuUrl} external size="lg">افتح القائمة الحية</Button>
			<Button href="/ar/features" variant="outline" size="lg">كل المزايا</Button>
		</div>
	</Section>

	<!-- ================= DASHBOARD ================= -->
	<Section tone="ink" id="dashboard">
		<div class="grid items-center gap-14 lg:grid-cols-2">
			<div>
				<SectionHead
					eyebrow="ما تتحكم به"
					title="القائمة كاملة،<br />من هاتفك"
					lede="كل ما يراه الضيف هو حقل تملكه أنت. بلا مصمم، بلا مطور، بلا تذكرة دعم، بلا انتظار أحد."
					invert
				/>
				<div class="mt-8 flex flex-wrap gap-2.5">
					{
						DASHBOARD_CONTROLS.map((c, i) => (
							<Sticker tone={i % 4 === 1 ? 'orange' : i % 4 === 3 ? 'rose' : 'outline-light'}>
								{c.titleAr}
							</Sticker>
						))
					}
				</div>
				<div class="mt-9">
					<Button href="/ar/how-it-works" variant="light" size="lg">كيف يعمل الإعداد</Button>
				</div>
			</div>

			<DashboardImage
				name="dash-meals"
				alt="قائمة أصناف أسترو مينيو: كل طبق بصورته وحصصه وأسعاره، مع مفتاح تفعيل أو تعطيل لكل صف"
				brief="The Meals list: photos, portions, prices, and one dish switched off"
				frame="light"
				sizes="(min-width:1024px) 45vw, 92vw"
				widths={[600, 900, 1400]}
			/>
		</div>

		<dl class="mt-16 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
			{
				DASHBOARD_CONTROLS.map((c) => (
					<div class="border-t-[2.5px] border-white/25 pt-4">
						<dt class="label text-brand text-base">{c.titleAr}</dt>
						<dd class="mt-1.5 text-lg text-white/65 text-pretty">{c.bodyAr}</dd>
					</div>
				))
			}
		</dl>
	</Section>

	<!-- ================= VERSUS ================= -->
	<Section id="compare">
		<SectionHead
			eyebrow="أسترو مينيو مقابل القائمة المطبوعة"
			title="واحدة من هاتين تكلّفك مالًا<br />في كل مرة تتغيّر فيها"
		/>

		<div class="border-ink bg-card slab mt-12 overflow-hidden rounded-[1.75rem]">
			<div class="overflow-x-auto">
				<table class="w-full min-w-[46rem] text-start">
					<caption class="sr-only">
						مقارنة أسترو مينيو بقائمة مطبوعة أو PDF، عبر ثماني مواقف يومية
					</caption>
					<thead>
						<tr class="border-ink border-b-[2.5px]">
							<th scope="col" class="label w-1/4 px-6 py-5 text-sm">الموقف</th>
							<th scope="col" class="text-brand-text label w-[37.5%] px-6 py-5 text-sm">أسترو مينيو</th>
							<th scope="col" class="label w-[37.5%] px-6 py-5 text-sm">قائمة مطبوعة أو PDF</th>
						</tr>
					</thead>
					<tbody>
						{
							VERSUS.map((row) => (
								<tr class="border-line border-b-2 last:border-b-0">
									<th scope="row" class="px-6 py-5 align-top text-lg font-bold">
										{row.pointAr}
									</th>
									<td class="bg-brand/8 px-6 py-5 align-top text-lg font-semibold">
										<span class="flex gap-2.5">
											<Check class="text-go mt-1.5" />
											<span class="text-pretty">{row.astroAr}</span>
										</span>
									</td>
									<td class="text-ink-soft px-6 py-5 align-top text-lg">
										<span class="flex gap-2.5">
											<Cross class="mt-1.5 text-[#c33]" />
											<span class="text-pretty">{row.otherAr}</span>
										</span>
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</Section>

	<!-- ================= USE CASES ================= -->
	<Section tone="card" ruled id="use-cases">
		<SectionHead eyebrow="لمن هذا" title="إن كنت تقدّم طعامًا، فهي مناسبة لك" />
		<div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				USE_CASES.map((u) => (
					<article class="border-ink pin-hover bg-paper overflow-hidden rounded-[1.5rem] border-[2.5px]">
						<FoodImage
							name={u.image}
							alt={u.brief}
							brief={u.brief}
							tone={u.tone}
							ratio="5/4"
							sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 90vw"
						/>
						<div class="border-ink border-t-[2.5px] p-6">
							<h3 class="text-2xl">{u.titleAr}</h3>
							<p class="text-ink-soft mt-2 text-lg text-pretty">{u.bodyAr}</p>
						</div>
					</article>
				))
			}
		</div>
	</Section>

	<!-- ================= PRICING ================= -->
	<Section id="pricing">
		<SectionHead
			eyebrow="الأسعار"
			title="باقة واحدة. كل شيء فيها."
			lede={`${PRICE.monthly} شهريًا، أو ${PRICE.annualPerMonth} شهريًا عند الدفع سنويًا. كل منافس في هذا السوق يطلب منك طلب عرض سعر — إليك الرقم مباشرة.`}
			align="center"
		/>
		<div class="mt-12">
			<PricingCard compact />
		</div>

		<div class="mx-auto mt-16 max-w-4xl">
			<h3 class="text-center text-3xl">وما تم استبعاده عمدًا</h3>
			<p class="text-ink-soft mx-auto mt-3 max-w-2xl text-center text-lg">
				هذا الجزء الذي يخفيه المنافسون. قوله بوضوح هو ما يجعل السعر قابلًا للتصديق.
			</p>
			<div class="mt-8 grid gap-4 sm:grid-cols-2">
				{
					NOT_INCLUDED.map((n) => (
						<div class="bg-card slab-sm rounded-2xl p-6">
							<p class="flex items-start gap-2.5 text-lg font-bold">
								<Cross class="mt-1 text-[#c33]" />
								<span>{n.labelAr}</span>
							</p>
							<p class="text-ink-soft mt-2 ps-8 text-base text-pretty">{n.reasonAr}</p>
						</div>
					))
				}
			</div>
		</div>
	</Section>

	<!-- ================= CUSTOMERS ================= -->
	<!-- See the English page for why this is driven off VENUES rather than off
	     the quotes, and why a venue without a quote gets soft grey body copy
	     instead of a blockquote. -->
	<Section tone="sunk" ruled id="customers">
		<SectionHead eyebrow="منشآت حقيقية" title="يعملون عليها بالفعل" />
		<div class="mt-14 grid gap-7 lg:grid-cols-3">
			{
				VENUES.map((v) => {
					const t = testimonialFor(v.id)
					return (
						<figure class="bg-card slab flex flex-col rounded-[1.5rem] p-7">
							<div class="flex items-center gap-4">
								<span class="border-ink bg-paper h-20 w-20 shrink-0 overflow-hidden rounded-2xl border-[2.5px]">
									<VenueLogo name={v.logo} venue={v.nameAr} size={80} />
								</span>
								<figcaption>
									<p class="text-lg font-bold">{t ? t.person : v.nameAr}</p>
									<p class="text-ink-faint text-base">
										{t ? `${v.nameAr} · ${t.roleAr}` : v.kindAr}
									</p>
								</figcaption>
							</div>
							{t ? (
								<blockquote class="mt-5 grow text-lg leading-relaxed text-pretty">
									“{t.quoteAr}”
								</blockquote>
							) : (
								<p class="text-ink-soft mt-5 grow text-lg leading-relaxed text-pretty">{v.blurbAr}</p>
							)}
							<p class="mt-5">
								<a
									href={v.menuUrl}
									rel="noopener noreferrer"
									target="_blank"
									class="text-brand-text text-lg font-bold hover:underline"
								>
									شاهد قائمتهم الحية ←
								</a>
							</p>
						</figure>
					)
				})
			}
		</div>
	</Section>

	<!-- ================= FAQ ================= -->
	<Section id="faq">
		<div class="grid gap-14 lg:grid-cols-[0.85fr_1.15fr]">
			<div>
				<SectionHead eyebrow="أسئلة" title="تلك التي<br />تمنع الشراء فعليًا" />
				<div class="border-ink slab mt-10 overflow-hidden rounded-[1.5rem]">
					<FoodImage
						name="faq-flatlay"
						alt="منظر علوي لقهوة ومعجنات وهاتف يعرض قائمة QR"
						brief="Overhead flat-lay: coffee, pastry, phone showing the menu"
						tone="warm"
						ratio="4/3"
						sizes="(min-width:1024px) 38vw, 92vw"
					/>
				</div>
				<p class="mt-6 text-lg">
					<a href="/ar/faq" class="text-brand-text font-bold hover:underline">
						اقرأ كل الأسئلة الـ{ALL_FAQS.length} ←
					</a>
				</p>
			</div>
			<div>
				<FaqList items={homeFaqsAr} openFirst />
			</div>
		</div>
	</Section>

	<CtaBand />
</Layout>
