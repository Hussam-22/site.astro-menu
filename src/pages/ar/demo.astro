---
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/ui/Section.astro'
import SectionHead from '../../components/ui/SectionHead.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import Button from '../../components/ui/Button.astro'
import Sticker from '../../components/ui/Sticker.astro'
import CtaBand from '../../components/ui/CtaBand.astro'
import { Image } from 'astro:assets'
import { SITE, PRICE } from '../../config/site'
import { crumbSchema } from '../../utils/schema'
import { VENUES } from '../../data/content'
import VenueLogo from '../../components/ui/VenueLogo.astro'

const screenFiles = import.meta.glob<{ default: ImageMetadata }>('../../assets/screens/*.png', {
	eager: true
})
const screenshot = (file: string) =>
	screenFiles[`../../assets/screens/${file}`]?.default as ImageMetadata

const title = 'عرض حي لقائمة QR'
const description = `افتح منيو استرو منيو حقيقية — ${SITE.demoVenueName}، 120 صنفًا حيًّا أمام عينك. فلترة حسب نوع الوجبة، بدّل للعربية، افتح طبقًا. بلا تسجيل.`

const TRY = [
	{
		n: '01',
		do: 'مرّر إلى Brewed Coffee باستخدام الشرائح فوق',
		why: 'أربعتاشر قسمًا على بُعد لمسة واحدة، مهما طالت القائمة.'
	},
	{
		n: '02',
		do: 'افتح الفلتر واختر Decaf، وبعدين Cold Beverages',
		why: 'منيو من 120 صنفًا بتضيق لقائمة مختصرة بلمستين بس.'
	},
	{
		n: '03',
		do: 'دوس على أيقونة الكرة الأرضية وبدّل المنيو للعربية',
		why: 'المنيو كلها بتتترجم وبتنعاد صياغتها من اليمين لليسار.'
	},
	{
		n: '04',
		do: 'افتح V60 Geisha وشوف الأحجام',
		why: 'كل حصة إلها سعرها الخاص، على نفس الصنف.'
	},
	{
		n: '05',
		do: 'دوس على سهم الرجوع لتوصل لصفحة المطعم',
		why: 'اتصال، واتساب، خرائط، انستقرام وتقييم جوجل، بلمسة وحدة لكل واحد.'
	},
	{
		n: '06',
		do: 'احسب قديش أخذت وقت تحمّل',
		why: 'هاي كل الفكرة. ما حدا بينتظر منيو.'
	}
]
---

<Layout
	title={title}
	description={description}
	path="/ar/demo"
	schema={crumbSchema([{ name: 'عرض حي', path: '/ar/demo' }])}
>
	<Section tight>
		<Breadcrumbs trail={[{ name: 'عرض حي' }]} />
		<div class="mt-8 grid items-start gap-12 lg:grid-cols-[1.1fr_0.9fr]">
			<div>
				<SectionHead
					as="h1"
					eyebrow="عرض حي"
					title="هاي مو نسخة تجريبية"
					lede={`هذه المنيو الشغّالة فعليًا لـ${SITE.demoVenueName} بالعين — 120 صنفًا، أربعتاشر قسمًا، شغّالة على استرو منيو هلق. افتحها على موبايلك إذا قدرت؛ فمن هناك رح يشوفها زبائنك.`}
				/>
				<div class="mt-8 flex flex-wrap gap-4">
					<Button href={SITE.demoMenuUrl} external size="lg">افتح القائمة الحية</Button>
					<Button href={SITE.demoVenueUrl} external variant="outline" size="lg">
						افتح صفحة المنشأة
					</Button>
				</div>
				<div class="mt-7 flex flex-wrap gap-2.5">
					<Sticker tone="orange">بلا تسجيل</Sticker>
					<Sticker tone="rose">بلا تطبيق</Sticker>
					<Sticker>منيو زبون حقيقية</Sticker>
				</div>
				<p class="text-ink-faint mt-7 text-base text-pretty">
					رجاءً تعامل معها بلطف — هذا مطعم حقيقي، مو صندوق تجارب. التصفح هو كل يلي بتعمله؛ ما في
					شي تطلبه ولا شي ترسله.
				</p>
			</div>

			<div class="border-ink shadow-lift mx-auto w-full max-w-[19rem] overflow-hidden rounded-[2rem] border-[3px]">
				<Image
					src={screenshot('menu-sections.png')}
					alt={`قائمة ${SITE.demoVenueName} الحية، تُظهر شرائح الأقسام وأطباق الإفطار بصورها وأسعارها`}
					widths={[390, 600, 780]}
					sizes="(min-width:1024px) 304px, 90vw"
					loading="eager"
					fetchpriority="high"
					class="block h-auto w-full"
				/>
			</div>
		</div>
	</Section>

	<Section tone="card" ruled>
		<SectionHead
			eyebrow="ست أشياء جرّبها"
			title="شو فعليًا بتقدر تعمله<br />أول ما تفتحها"
			lede="كل وحدة من هدول بتختبر شي مكتوب بمكان تاني بالموقع. دقيقتين بيخبروك أكتر من صفحة المزايا كلها."
		/>
		<ol class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{
				TRY.map((t) => (
					<li class="bg-paper slab slab-hover rounded-[1.5rem] p-7">
						<span class="font-display text-brand text-4xl">{t.n}</span>
						<h2 class="mt-2 text-2xl">{t.do}</h2>
						<p class="text-ink-soft mt-3 text-lg text-pretty">{t.why}</p>
					</li>
				))
			}
		</ol>
		<div class="mt-12 flex justify-center">
			<Button href={SITE.demoMenuUrl} external size="lg">افتح القائمة الحية</Button>
		</div>
	</Section>

	<Section ruled>
		<SectionHead
			eyebrow="ثلاث قوائم حقيقية"
			title="منشآت مختلفة،<br />ونفس محرك القوائم"
			lede="مقهى قهوة مختصة، وشاحنة قهوة، ومطعم صحي. نفس المنتج تحتها جميعًا، ولا تشبه إحداها الأخرى — افتح الثلاث وسترى أن الفرق منهم هم، لا منا."
		/>
		<ul class="mt-14 grid gap-7 md:grid-cols-3">
			{
				VENUES.map((v) => (
					<li class="bg-card slab slab-hover flex flex-col rounded-[1.5rem] p-7">
						<span class="border-ink bg-paper mb-5 h-20 w-20 shrink-0 overflow-hidden rounded-2xl border-[2.5px]">
							<VenueLogo name={v.logo} venue={v.nameAr} size={80} />
						</span>
						<h2 class="text-2xl">{v.nameAr}</h2>
						<p class="text-ink-soft mt-3 grow text-lg text-pretty">{v.blurbAr}</p>
						<p class="mt-6">
							<Button href={v.menuUrl} external variant="outline">
								افتح قائمتهم
							</Button>
						</p>
					</li>
				))
			}
		</ul>
		<p class="text-ink-faint mx-auto mt-10 max-w-2xl text-center text-base text-pretty">
			الثلاث جميعًا منشآت عاملة. تصفحها كما يفعل العميل — لا شيء لطلبه ولا شيء لإرساله.
		</p>
	</Section>

	<Section>
		<div class="grid items-center gap-12 lg:grid-cols-[1fr_1fr]">
			<div>
				<SectionHead
					eyebrow="وهلق تخيّل منيوك إنت"
					title="نفس محرك المنيو،<br />بس بأكلك إنت"
					lede="صورة الغلاف، شعارك، أقسامك، أسعارك، لغاتك. المطعم يلي فوق ما صمّم ولا شي من هذا — بس عبّى حقول."
				/>
				<div class="mt-8 flex flex-wrap gap-4">
					<Button href={SITE.signupUrl} size="lg">ابدأ {PRICE.trialDays} يومًا مجانًا</Button>
					<Button href="/ar/how-it-works" variant="outline" size="lg">كيف بيصير الإعداد</Button>
				</div>
			</div>
			<div class="grid grid-cols-2 gap-5">
				{
					['filter-meal-type.png', 'language-switch.png'].map((f, i) => (
						<div class="border-ink pin-hover overflow-hidden rounded-[1.25rem] border-[2.5px]">
							<Image
								src={screenshot(f)}
								alt={
									i === 0
										? 'ورقة فلتر نوع الوجبة مفتوحة، تُظهر خيارات مثل بدون كافيين وصحي وحصة خفيفة'
										: 'منتقي اللغة مفتوح على القائمة الحية'
								}
								widths={[300, 500, 780]}
								sizes="(min-width:1024px) 22vw, 45vw"
								class="block h-auto w-full"
							/>
						</div>
					))
				}
			</div>
		</div>
	</Section>

	<CtaBand
		title="ابنِ منيوك بنفس الطريقة"
		body={`ابعتلنا المنيو اللي عندك هلق ونحن منرفع النسخة الأولى بدالك. ${PRICE.trialDays} يومًا مجانًا، بلا بطاقة.`}
		secondaryHref="/ar/pricing"
		secondaryLabel="شاهد الأسعار"
	/>
</Layout>
