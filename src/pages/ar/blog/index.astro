---
import Layout from '../../../layouts/Layout.astro'
import Section from '../../../components/ui/Section.astro'
import SectionHead from '../../../components/ui/SectionHead.astro'
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro'
import Sticker from '../../../components/ui/Sticker.astro'
import CtaBand from '../../../components/ui/CtaBand.astro'
import { getCollection } from 'astro:content'
import { crumbSchema } from '../../../utils/schema'

const posts = (
	await getCollection('blog', ({ data, id }) => !data.draft && id.startsWith('ar/'))
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())

const fmt = (d: Date) => d.toLocaleDateString('ar-AE', { day: 'numeric', month: 'long', year: 'numeric' })

const title = 'المدونة — قوائم، رموز QR والظهور في البحث'
const description =
	'كتابة عملية لمن يديرون أعمال الطعام: قوائم QR لا تعيد طباعتها أبدًا، قوائم تبيع، تكلفة القوائم الرقمية، والظهور على جوجل.'
---

<Layout
	title={title}
	description={description}
	path="/ar/blog"
	schema={crumbSchema([{ name: 'المدونة', path: '/ar/blog' }])}
>
	<Section tight>
		<Breadcrumbs trail={[{ name: 'المدونة' }]} />
		<div class="mt-8">
			<SectionHead
				as="h1"
				eyebrow="المدونة"
				title="قوائم، رموز<br />وظهور في البحث"
				lede="مكتوبة لمن يديرون أعمال طعام، لا لمن يديرون برمجيات. بلا مقالات عامة، بلا حشو."
			/>
		</div>
	</Section>

	<Section tight>
		<div class="masonry sm:columns-2 lg:columns-3">
			{
				posts.map((post) => (
					<article class="bg-card slab slab-hover rounded-[1.5rem] p-7">
						<Sticker tone="orange" size="sm">
							{post.data.category}
						</Sticker>
						<h2 class="mt-4 text-2xl">
							<a
								href={`/ar/blog/${post.id.replace(/^ar\//, '')}`}
								class="hover:text-brand-text transition-colors"
							>
								{post.data.title}
							</a>
						</h2>
						<p class="text-ink-soft mt-3 text-lg text-pretty">{post.data.description}</p>
						<p class="text-ink-faint border-line mt-5 border-t pt-4 text-base">
							<time datetime={post.data.publishDate.toISOString()}>
								{fmt(post.data.publishDate)}
							</time>
						</p>
					</article>
				))
			}
		</div>
		{
			posts.length === 0 && (
				<p class="text-ink-soft text-center text-xl">لا شيء منشور بعد. تفقد الصفحة لاحقًا.</p>
			)
		}
	</Section>

	<CtaBand />
</Layout>
