---
import Layout from '../../../layouts/Layout.astro'
import Section from '../../../components/ui/Section.astro'
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro'
import Sticker from '../../../components/ui/Sticker.astro'
import CtaBand from '../../../components/ui/CtaBand.astro'
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { SITE } from '../../../config/site'
import { crumbSchema } from '../../../utils/schema'

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data, id }) => !data.draft && id.startsWith('ar/'))
	return posts.map((post) => ({
		params: { slug: post.id.replace(/^ar\//, '') },
		props: { post }
	}))
}

interface Props {
	post: CollectionEntry<'blog'>
}
const { post } = Astro.props
const { Content } = await render(post)
const slug = post.id.replace(/^ar\//, '')

const all = (
	await getCollection('blog', ({ data, id }) => !data.draft && id.startsWith('ar/'))
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
const more = all.filter((p) => p.id !== post.id).slice(0, 3)

const fmt = (d: Date) => d.toLocaleDateString('ar-AE', { day: 'numeric', month: 'long', year: 'numeric' })

const article = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.publishDate.toISOString(),
	dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
	author: { '@type': 'Organization', name: post.data.author, url: SITE.domain },
	publisher: { '@id': `${SITE.domain}/#organization` },
	mainEntityOfPage: new URL(`/ar/blog/${slug}`, SITE.domain).href,
	keywords: post.data.tags.join(', ')
}
---

<Layout
	title={post.data.title}
	description={post.data.description}
	path={`/ar/blog/${slug}`}
	type="article"
	schema={[
		crumbSchema([
			{ name: 'المدونة', path: '/ar/blog' },
			{ name: post.data.title, path: `/ar/blog/${slug}` }
		]),
		article
	]}
>
	<Section tight width="narrow">
		<Breadcrumbs trail={[{ name: 'المدونة', path: '/ar/blog' }, { name: post.data.title }]} />

		<header class="mt-8">
			<Sticker tone="orange" size="sm">{post.data.category}</Sticker>
			<h1 class="mt-4 text-4xl sm:text-6xl">{post.data.title}</h1>
			<p class="text-ink-soft mt-5 text-xl text-pretty sm:text-2xl">{post.data.description}</p>
			<p class="text-ink-faint border-line mt-6 border-t pt-5 text-base">
				<time datetime={post.data.publishDate.toISOString()}>{fmt(post.data.publishDate)}</time>
				{post.data.updatedDate && <span> · آخر تحديث {fmt(post.data.updatedDate)}</span>}
				<span> · {post.data.author}</span>
			</p>
		</header>

		<div
			class="prose prose-lg mt-12 max-w-none prose-headings:font-display prose-headings:font-normal prose-h2:mt-12 prose-h2:text-3xl prose-h3:text-2xl prose-p:text-ink-soft prose-p:text-lg prose-li:text-ink-soft prose-li:text-lg prose-strong:text-ink prose-a:text-brand-text prose-a:font-bold"
		>
			<Content />
		</div>

		<div class="border-ink mt-14 flex flex-wrap gap-2.5 border-t-[2.5px] pt-8">
			{post.data.tags.map((tag) => <Sticker size="sm">#{tag}</Sticker>)}
		</div>
	</Section>

	{
		more.length > 0 && (
			<Section tone="card" ruled tight>
				<h2 class="text-3xl">كمّل القراءة</h2>
				<div class="mt-8 grid gap-6 md:grid-cols-3">
					{more.map((p) => (
						<article class="bg-paper slab slab-hover rounded-[1.25rem] p-6">
							<Sticker tone="orange" size="sm">
								{p.data.category}
							</Sticker>
							<h3 class="mt-3 text-xl">
								<a
									href={`/ar/blog/${p.id.replace(/^ar\//, '')}`}
									class="hover:text-brand-text transition-colors"
								>
									{p.data.title}
								</a>
							</h3>
						</article>
					))}
				</div>
			</Section>
		)
	}

	<CtaBand />
</Layout>
