---
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import Layout from '@layouts/Layout.astro'
import Container from '@components/container.astro'
import { Debug } from 'astro:components'
import Link from '@components/ui/link.astro'

// Generate a new path for every collection entry
export async function getStaticPaths() {
	const blogEntries = await getCollection('blog')

	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry }
	}))
}

// Get the entry directly from the prop on render
const { entry } = Astro.props
const { Content } = await entry.render()
---

<!-- <Debug answer={{ entry }} /> -->
<Layout title={entry.data.title}>
	<div class="mx-6 max-w-(--breakpoint-md) text-white sm:mx-auto">
		<div class="mx-auto mt-6 max-w-3xl">
			<span class="text-sm font-medium uppercase tracking-wider text-cyan-400">
				{entry.data.category}
			</span>
			<h1 class="mt-1 text-3xl font-bold lg:text-4xl lg:leading-tight lg:tracking-tight">
				{entry.data.title}
			</h1>
			<div class="mt-2 flex w-full flex-wrap gap-1 md:w-auto">
				{entry.data.tags.map((tag) => <span class="text-sm text-zinc-500">#{tag}</span>)}
			</div>
			<div class="mt-3 flex flex-wrap items-center gap-2 md:flex-nowrap">
				<span class="text-zinc-400">
					{entry.data.author}
				</span>
				<span class="text-zinc-400">•</span>
				<time class="text-zinc-400" datetime={entry.data.publishDate.toISOString()}>
					{entry.data.publishDate.toDateString()}
				</time>
			</div>
		</div>
		<hr class="my-2 border-dashed border-zinc-400" />
		<div class="prose prose-lg mx-auto mt-6 max-w-3xl text-rose-400">
			<Content />
		</div>
		<div class="mb-16 mt-8 text-center">
			<Link href="/blog" class="rounded-md bg-gray-100 px-5 py-3 transition hover:bg-gray-200"
				>← Back to Blog</Link
			>
		</div>
	</div>
</Layout>
