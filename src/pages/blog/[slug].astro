---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

// Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");

  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the entry directly from the prop on render
const { entry } = Astro.props;
const { Content } = await entry.render();
const site = Astro.site?.toString() || "https://astro-menu.com";
const ogImage = entry.data.image?.src
  ? new URL(entry.data.image.src, site).toString()
  : new URL("/opengraph.png", site).toString();
---

<!-- <Debug answer={{ entry }} /> -->
<Layout
  title={entry.data.title}
  description={entry.data.snippet}
  image={ogImage}
  ogType="article"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        headline: entry.data.title,
        description: entry.data.snippet,
        image: ogImage,
        author: { "@type": "Person", name: entry.data.author },
        datePublished: entry.data.publishDate,
        mainEntityOfPage: new URL(Astro.url.pathname, site).toString(),
      })}
    />
  </Fragment>
  <div class="mx-6 w-full sm:mx-auto">
    <div class="mx-auto mt-6 max-w-3xl">
      <span class="text-sm font-medium uppercase tracking-wider">
        {entry.data.category}
      </span>
      <h1
        class="mt-1 text-3xl font-bold lg:text-4xl lg:leading-tight lg:tracking-tight"
      >
        {entry.data.title}
      </h1>
      <div class="mt-2 flex w-full flex-wrap gap-1 md:w-auto">
        {
          entry.data.tags.map((tag) => (
            <span class="text-sm text-neutral-500">#{tag}</span>
          ))
        }
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-2 md:flex-nowrap">
        <span class="text-neutral-400">
          {entry.data.author}
        </span>
        <span class="text-neutral-400">•</span>
        <time
          class="text-neutral-400"
          datetime={entry.data.publishDate.toISOString()}
        >
          {entry.data.publishDate.toDateString()}
        </time>
      </div>
    </div>
    <hr class="my-2 border-dashed border-neutral-400" />
    <div class="prose prose-lg mx-auto mt-6 max-w-3xl">
      <Content />
    </div>
    <div class="mb-16 mt-8 text-center">
      <a
        href="/blog"
        class="rounded-4xl bg-black text-white text-xl font-bold py-2 px-4"
        >Back to Blog</a
      >
    </div>
  </div>
</Layout>
