---
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/ui/Section.astro'
import SectionHead from '../../components/ui/SectionHead.astro'
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro'
import Sticker from '../../components/ui/Sticker.astro'
import CtaBand from '../../components/ui/CtaBand.astro'
import { getCollection } from 'astro:content'
import { crumbSchema } from '../../utils/schema'

const posts = (
	await getCollection('blog', ({ data, id }) => !data.draft && !id.startsWith('ar/'))
).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)

const fmt = (d: Date) =>
	d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })

const title = 'Blog — menus, QR codes and getting found'
const description =
	'Practical writing for people who run food businesses: QR menus you never reprint, menus that sell, what digital menus cost, and getting found on Google.'
---

<Layout
	title={title}
	description={description}
	path="/blog"
	schema={crumbSchema([{ name: 'Blog', path: '/blog' }])}
>
	<Section tight>
		<Breadcrumbs trail={[{ name: 'Blog' }]} />
		<div class="mt-8">
			<SectionHead
				as="h1"
				eyebrow="Blog"
				title="Menus, codes<br />and getting found"
				lede="Written for people who run food businesses, not for people who run software. No listicles, no filler."
			/>
		</div>
	</Section>

	<Section tight>
		<div class="masonry sm:columns-2 lg:columns-3">
			{
				posts.map((post) => (
					<article class="bg-card slab slab-hover rounded-[1.5rem] p-7">
						<Sticker tone="orange" size="sm">
							{post.data.category}
						</Sticker>
						<h2 class="mt-4 text-2xl">
							<a href={`/blog/${post.id}`} class="hover:text-brand-text transition-colors">
								{post.data.title}
							</a>
						</h2>
						<p class="text-ink-soft mt-3 text-lg text-pretty">{post.data.description}</p>
						<p class="text-ink-faint border-line mt-5 border-t pt-4 text-base">
							<time datetime={post.data.publishDate.toISOString()}>
								{fmt(post.data.publishDate)}
							</time>
						</p>
					</article>
				))
			}
		</div>
		{
			posts.length === 0 && (
				<p class="text-ink-soft text-center text-xl">Nothing published yet. Check back soon.</p>
			)
		}
	</Section>

	<CtaBand />
</Layout>
