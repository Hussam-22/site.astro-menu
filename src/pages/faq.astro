---
import Layout from '../layouts/Layout.astro'
import Section from '../components/ui/Section.astro'
import SectionHead from '../components/ui/SectionHead.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import FaqList from '../components/ui/FaqList.astro'
import CtaBand from '../components/ui/CtaBand.astro'
import { SITE, PRICE } from '../config/site'
import { FAQ_GROUPS, ALL_FAQS } from '../data/faqs'
import { crumbSchema, faqSchema } from '../utils/schema'

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')

const title = 'FAQ — QR menu questions answered'
const description = `${ALL_FAQS.length} straight answers: what it costs (${PRICE.monthly} a month), whether the QR code needs reprinting, how many languages are included and commission.`
---

<Layout
	title={title}
	description={description}
	path="/faq"
	schema={[crumbSchema([{ name: 'FAQ', path: '/faq' }]), faqSchema(ALL_FAQS)]}
>
	<Section tight>
		<Breadcrumbs trail={[{ name: 'FAQ' }]} />
		<div class="mt-8">
			<SectionHead
				as="h1"
				eyebrow="FAQ"
				title="Straight answers"
				lede={`Everything people ask before they sign up, including the questions we would rather you asked early — like what Astro-Menu deliberately does not do.`}
			/>
		</div>
		<nav aria-label="FAQ sections" class="mt-10 flex flex-wrap gap-2.5">
			{
				FAQ_GROUPS.map((g) => (
					<a
						href={`#${slug(g.heading)}`}
						class="border-ink bg-card hover:bg-brand rounded-full border-[2.5px] px-4 py-2 text-base font-bold transition-colors"
					>
						{g.heading}
					</a>
				))
			}
		</nav>
	</Section>

	{
		FAQ_GROUPS.map((group, i) => (
			<Section id={slug(group.heading)} tone={i % 2 === 1 ? 'card' : 'paper'} ruled={i % 2 === 1} tight>
				<div class="grid gap-10 lg:grid-cols-[0.55fr_1.45fr]">
					<h2 class="text-4xl lg:sticky lg:top-28 lg:self-start">{group.heading}</h2>
					<FaqList items={group.items} />
				</div>
			</Section>
		))
	}

	<Section tight>
		<div class="bg-brand/12 slab mx-auto max-w-3xl rounded-[1.5rem] p-9 text-center">
			<h2 class="text-3xl">Something we have not answered?</h2>
			<p class="text-ink-soft mt-3 text-lg text-pretty">
				Email us and a person replies — usually the same day.
			</p>
			<p class="mt-5">
				<a
					href={`mailto:${SITE.email}`}
					class="text-brand-text text-xl font-bold hover:underline"
				>
					{SITE.email}
				</a>
			</p>
		</div>
	</Section>

	<CtaBand />
</Layout>
