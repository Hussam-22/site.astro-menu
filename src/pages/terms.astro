---
import Layout from '../layouts/Layout.astro'
import Section from '../components/ui/Section.astro'
import Breadcrumbs from '../components/ui/Breadcrumbs.astro'
import { SITE } from '../config/site'
import { crumbSchema } from '../utils/schema'

const updated = '18 August 2026'
const title = 'Terms & conditions'
const description =
	'The terms for using Astro-Menu: what the subscription includes, how billing and cancellation work, and what each side is responsible for.'
---

<Layout
	title={title}
	description={description}
	path="/terms"
	schema={crumbSchema([{ name: 'Terms & conditions', path: '/terms' }])}
>
	<Section width="narrow" tight>
		<Breadcrumbs trail={[{ name: 'Terms & conditions' }]} />
		<h1 class="mt-8 text-5xl sm:text-6xl">Terms &amp; conditions</h1>
		<p class="text-ink-faint mt-4 text-base">Last updated {updated}</p>

		<div
			class="prose prose-lg prose-headings:font-display prose-headings:font-normal prose-headings:uppercase prose-h2:mt-10 prose-h2:text-2xl prose-p:text-ink-soft prose-li:text-ink-soft prose-strong:text-ink prose-a:text-brand-text prose-a:font-bold mt-10 max-w-none"
		>
			<h2>What the service is</h2>
			<p>
				Astro-Menu hosts a digital menu for your venue and gives you a dashboard to edit it, plus a
				QR code and a link that point to it. It is a menu. It does not take orders, process payments
				or replace a till, and we never take a commission on anything you sell.
			</p>

			<h2>Your account</h2>
			<p>
				You are responsible for keeping your login details private, and for what is published on
				your menu — prices, descriptions, allergen information and photographs included. You confirm
				you have the right to use any content you upload.
			</p>

			<h2>Billing</h2>
			<ul>
				<li>
					Subscriptions are billed monthly or yearly in advance, at the price shown when you
					subscribe.
				</li>
				<li>
					The free trial requires no card, and becomes a paid subscription only if you choose to
					continue.
				</li>
				<li>Prices may change; existing subscribers are told before a change affects them.</li>
			</ul>

			<h2>Cancelling</h2>
			<p>
				Cancel from the dashboard at any time. There is no notice period and no exit fee. Your menu
				stops being served at the end of the paid period and the QR code stops resolving. We keep
				your menu data for a reasonable period afterwards, so you can come back.
			</p>

			<h2>Availability</h2>
			<p>
				We work to keep menus available at all times, but we do not guarantee uninterrupted service.
				Planned maintenance is scheduled outside peak dining hours wherever possible.
			</p>

			<h2>Acceptable use</h2>
			<p>
				Do not use Astro-Menu to publish unlawful content, to impersonate another business, or to
				attempt to disrupt the service for others. We may suspend an account that does.
			</p>

			<h2>Liability</h2>
			<p>
				Astro-Menu is provided as-is. To the extent permitted by law, our liability is limited to
				the amount you paid us in the twelve months before a claim. Nothing here limits liability
				that cannot lawfully be limited.
			</p>

			<h2>Contact</h2>
			<p>
				Questions about these terms: <a href={'mailto:' + SITE.email}>{SITE.email}</a>.
			</p>
		</div>
	</Section>
</Layout>
