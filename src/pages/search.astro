---
import Layout from "@layouts/Layout.astro";

const q = Astro.url.searchParams.get("q") || "";
---

<Layout
  title="Search Astro-Menu"
  description="Search Astro-Menu content: docs, blog posts, features, and more."
>
  <section class="sm:mx-auto px-3 sm:px-4 w-full sm:w-11/12 mt-16">
    <h1 class="text-3xl font-bold">Search</h1>
    <p class="mt-2 text-neutral-600">
      Search our documentation, blog, features, and more.
    </p>
    {
      q && (
        <p class="mt-4 text-sm text-neutral-500">
          Showing results for: <strong>{q}</strong>
        </p>
      )
    }
    <div id="search" class="mt-6"></div>
    <noscript>
      <p class="mt-4 text-neutral-600">
        Search requires JavaScript. Please enable JavaScript to search the
        site.
      </p>
    </noscript>
  </section>
</Layout>

<style is:global>
  @import "@pagefind/default-ui/css/ui.css";
</style>

<script>
  import { PagefindUI } from "@pagefind/default-ui";

  const q = new URLSearchParams(window.location.search).get("q") || "";
  const pagefindUI = new PagefindUI({
    element: "#search",
    showSubResults: true,
    showImages: false,
  });
  if (q) {
    pagefindUI.triggerSearch(q);
  }
</script>
