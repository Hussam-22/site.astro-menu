---
import Layout from "@layouts/Layout.astro";

const q = Astro.url.searchParams.get("q") || "";
---

<Layout title="Search Astro-Menu" description="Search Astro-Menu content">
  <section class="sm:mx-auto px-3 sm:px-4 w-full sm:w-11/12 mt-16">
    <h1 class="text-3xl font-bold">Search</h1>
    <form method="get" action="/search" class="mt-4 flex gap-2">
      <input
        type="text"
        name="q"
        value={q}
        placeholder="Search..."
        class="input input-bordered w-full max-w-xl"
      />
      <button class="btn btn-primary" type="submit">Search</button>
    </form>
    {
      q && (
        <p class="mt-4 text-sm text-neutral-500">
          Showing results for: <strong>{q}</strong>
        </p>
      )
    }
    <p class="mt-2 text-neutral-600">Site search results coming soon.</p>
  </section>
</Layout>
